---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import MobileNav from '../components/MobileNav.astro';
import { CREATOR } from '../data/creator';
import { BRAND } from '../config/brand';

interface Props {
  title: string;
  description?: string;
  category?: string;
  ogType?: string;
  lang?: 'hi' | 'en';
}

const {
  title,
  description = `${BRAND.name} (${BRAND.descriptor.en}) — Modern, fast, and verified knowledge portal for students, developers, and tech learners.`,
  category = "Technology",
  ogType = "website",
  lang = "hi"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}/brand/og-image.png`, Astro.site);

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": BRAND.name,
  "alternateName": [BRAND.nameHi, BRAND.descriptor.en, BRAND.descriptor.hi],
  "url": BRAND.siteUrl,
  "author": {
    "@type": "Person",
    "name": CREATOR.name,
    "url": `${BRAND.siteUrl}/about/`,
    "sameAs": [
      CREATOR.links.github,
      CREATOR.links.linkedin
    ].filter(Boolean)
  }
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="author" href={`${base}/humans.txt`} />
    <link rel="me" href={CREATOR.links.github} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={BRAND.themeColor} />

    <!-- SEO Meta Tags -->
    <title>{title} | {BRAND.name}</title>
    <meta name="description" content={description} />
    <meta name="author" content={CREATOR.name} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${BRAND.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={BRAND.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${BRAND.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />

    <!-- Google Fonts: Plus Jakarta Sans, Inter, Noto Sans Devanagari & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Avoids Flash of Unstyled Theme) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('peach_theme') || localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="bg-surface-light dark:bg-surface-dark text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-peach-500/20 selection:text-peach-900 dark:selection:text-peach-200">
    <!-- Skip to Main Content Link (WAI-ARIA Accessibility Requirement) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-peach-600 focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-peach-400 text-xs font-bold"
    >
      Skip to main content
    </a>

    <!-- Global Application Header -->
    <Header />

    <!-- Main Page Content Container -->
    <main id="main-content" class="flex-grow focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <!-- Global Application Footer -->
    <Footer />

    <!-- Global Keyboard Shortcut Search Modal (Triggered by Ctrl+K / Cmd+K or Click) -->
    <SearchModal />

    <!-- Mobile Navigation Drawer -->
    <MobileNav />

    <!-- Client-side Interactive UI Helpers & Event Bus -->
    <script is:inline>
      // Global toast notification dispatcher
      window.showToast = function(message) {
        let toast = document.getElementById('global-toast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'global-toast';
          toast.className = 'fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-xl bg-slate-900/90 dark:bg-white/90 backdrop-blur-md text-white dark:text-slate-900 text-xs font-semibold shadow-apple-lg border border-white/10 dark:border-slate-200 transition-all duration-200 flex items-center gap-2';
          document.body.appendChild(toast);
        }
        toast.innerHTML = `<svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg><span>\${message}</span>`;
        toast.classList.remove('opacity-0', 'translate-y-2');
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 200);
        }, 2500);
      };

      // Theme toggle
      const themeBtn = document.getElementById('theme-toggle-btn');
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('peach_theme', isDark ? 'dark' : 'light');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Synchronize Language Selection & HTML lang attribute
      window.addEventListener('peach:lang-change', (event) => {
        const lang = event.detail.lang || 'hi';
        document.documentElement.lang = lang;
        document.body.classList.toggle('lang-en', lang === 'en');
        document.body.classList.toggle('lang-hi', lang === 'hi');
      });
      // Backward-compatible alias
      window.addEventListener('app:lang-change', (event) => {
        const lang = event.detail.lang || 'hi';
        document.documentElement.lang = lang;
      });

      // Initialize language state
      (function initLanguageState() {
        const currentLang = localStorage.getItem('peach_preferred_lang') || 'hi';
        document.documentElement.lang = currentLang;
        document.body.classList.toggle('lang-en', currentLang === 'en');
        document.body.classList.toggle('lang-hi', currentLang === 'hi');
      })();
    </script>
  </body>
</html>
