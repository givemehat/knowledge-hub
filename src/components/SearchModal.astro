---
import { TOPICS } from '../data/topics';
import { ROADMAPS } from '../data/roadmaps';
import { SCENARIOS } from '../data/scenarios';
import { BRAND } from '../config/brand';
import { CREATOR } from '../data/creator';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

// Prepare search dataset with locale-aware URLs and titles
const searchData = [
  ...TOPICS.map(t => ({
    type: isHindi ? 'विषय' : 'Topic',
    title: isHindi ? (t.shortTitle || t.title) : (t.shortTitleEn || t.title),
    category: isHindi ? t.categoryLabel : (t.category === 'ai-ml' ? 'AI & Machine Learning' : t.category === 'quantum' ? 'Quantum Computing' : t.category === 'career' ? 'Career & Placement' : t.category === 'projects' ? 'Projects Hub' : t.category === 'tech-fundamentals' ? 'Tech Fundamentals' : 'Politics & Governance'),
    level: t.level,
    url: `${base}/${locale}/topics/${t.slug}/`,
    summary: isHindi ? t.summary : (t.summaryEn || ''),
    tags: t.tags.join(', ')
  })),
  ...ROADMAPS.map(r => ({
    type: isHindi ? 'रोडमैप' : 'Roadmap',
    title: isHindi ? (r.titleHindi || r.title) : r.title,
    category: isHindi ? 'रोडमैप' : 'Roadmap Guide',
    level: r.difficulty,
    url: `${base}/${locale}/roadmaps/${r.slug}/`,
    summary: isHindi ? r.subtitle : (r.description || 'Step-by-step career and skills learning roadmap.'),
    tags: r.nodes.map(n => n.title).join(', ')
  })),
  ...SCENARIOS.map(s => ({
    type: isHindi ? 'सिनेरियो' : 'Scenario',
    title: isHindi ? s.titleHindi : s.title,
    category: isHindi ? s.domainLabel : 'Futures Studies',
    level: 'Hypothetical',
    url: `${base}/${locale}/scenarios/${s.slug}/`,
    summary: isHindi ? s.abstract : (s.subtitle || 'Red-teaming strategic simulation and branch outcomes.'),
    tags: 'scenario, red-teaming, simulation, futures'
  })),
  {
    type: isHindi ? 'शोध' : 'Research',
    title: isHindi ? 'भारतीय समाचार मीडिया सेंटीमेंट अध्ययन (2001-2023)' : 'Headlines of Fear & Hope: Longitudinal Sentiment and Framing Dynamics in Indian Media (2001–2023)',
    category: isHindi ? 'मीडिया शोध' : 'Media Research',
    level: 'Data Analysis',
    url: `${base}/${locale}/research/media-sentiment-study/`,
    summary: isHindi ? '38.4 लाख शीर्षकों का कम्प्यूटेशनल अध्ययन।' : 'Longitudinal empirical research examining 3.84 million headlines from 2001 to 2023 using VADER, MuRIL, and Kaggle datasets.',
    tags: 'sentiment analysis, media, kaggle, research, headlines, emotions'
  },
  {
    type: isHindi ? 'परिचय' : 'Creator',
    title: isHindi ? `${CREATOR.name} और ${BRAND.name} परिचय` : `About ${CREATOR.name} & ${BRAND.name} Manifesto`,
    category: isHindi ? 'परिचय' : 'Creator & Story',
    level: 'Profile',
    url: `${base}/${locale}/about/`,
    summary: isHindi ? 'ज्ञान इंजन बनाने की प्रेरणा और पृष्ठभूमि।' : `Personal journey, skills, engineering background, and motivation behind building ${BRAND.name}.`,
    tags: 'creator, rajnish singh, author, about, portfolio, bio, skills'
  },
  {
    type: isHindi ? 'संपर्क' : 'Contact',
    title: isHindi ? `${CREATOR.name} से संपर्क करें` : `Connect & Contact ${CREATOR.name}`,
    category: isHindi ? 'सहयोग' : 'Collaboration',
    level: 'Connect',
    url: `${base}/${locale}/contact/`,
    summary: isHindi ? 'सहयोग और सुझाव के लिए संपर्क करें।' : 'Get in touch for internships, software engineering roles, open-source feedback, and vCard download.',
    tags: 'contact, hire, collaborate, message, email, github, vcard, qr code'
  }
];

const noResultsText = isHindi ? "कोई परिणाम नहीं मिला। अन्य शब्द खोजें।" : "No verified results found. Try broader keywords.";
const defaultPlaceholderText = isHindi ? "सत्यापित विषय, चीट-शीट और रोडमैप खोजें..." : "Search through verified topics, cheat sheets, and interview roadmaps...";
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-start justify-center pt-16 sm:pt-24 px-4 transition-opacity">
  <div class="bg-white dark:bg-darkcard w-full max-w-2xl rounded-3xl shadow-elevation border border-slate-200 dark:border-white/10 overflow-hidden flex flex-col max-h-[80vh] animate-in fade-in zoom-in-95 duration-150">
    <!-- Input Bar -->
    <div class="flex items-center px-5 py-4 border-b border-slate-100 dark:border-white/10 gap-3">
      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder={isHindi ? "खोजने के लिए टाइप करें (जैसे RAG, DSA, OS)..." : "Type to search topics, roadmaps, or tech concepts (e.g. RAG, DSA, Docker)..."}
        class="w-full bg-transparent text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none"
        autocomplete="off"
      />
      <kbd id="close-search-btn" class="text-[11px] font-mono px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-white/10 cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">ESC</kbd>
    </div>

    <!-- Results List -->
    <div id="search-results" class="overflow-y-auto p-3 space-y-2 text-sm">
      <div class="p-8 text-center text-slate-400 text-xs">
        {isHindi ? "सत्यापित विषय, चीट-शीट और रोडमैप खोजें..." : "Search through verified topics, cheat sheets, and interview roadmaps..."}
      </div>
    </div>

    <!-- Quick Footer Tip -->
    <div class="px-5 py-3 bg-slate-50/80 dark:bg-slate-900/60 border-t border-slate-100 dark:border-white/10 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-3">
        <span><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↑</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↓</kbd> {isHindi ? "चुनने के लिए" : "to navigate"}</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↵</kbd> {isHindi ? "खोलने के लिए" : "to select"}</span>
      </div>
      <span class="font-medium text-brand-600 dark:text-brand-400">
        {isHindi ? "त्वरित खोज" : "Instant Static Search"}
      </span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchData, noResultsText }}>
  const modal = document.getElementById('search-modal');
  const openBtn = document.getElementById('open-search-btn');
  const closeBtn = document.getElementById('close-search-btn');
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  let selectedIndex = -1;
  let currentResults = [];

  function openSearch() {
    modal.classList.remove('hidden');
    searchInput.value = '';
    renderResults(searchData.slice(0, 6));
    setTimeout(() => searchInput.focus(), 50);
  }

  function closeSearch() {
    modal.classList.add('hidden');
    selectedIndex = -1;
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      modal.classList.contains('hidden') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeSearch();
    }
    if (!modal.classList.contains('hidden')) {
      const items = resultsContainer.querySelectorAll('.search-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && items[selectedIndex]) {
          items[selectedIndex].click();
        }
      }
    }
  });

  function updateSelection(items) {
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-brand-50', 'dark:bg-brand-950/70', 'border-brand-500/30');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-brand-50', 'dark:bg-brand-950/70', 'border-brand-500/30');
      }
    });
  }

  function renderResults(results) {
    currentResults = results;
    selectedIndex = -1;
    if (results.length === 0) {
      resultsContainer.innerHTML = `<div class="p-8 text-center text-slate-400 text-xs">${noResultsText}</div>`;
      return;
    }

    resultsContainer.innerHTML = results.map((item, idx) => `
      <a href="${item.url}" class="search-item flex items-start gap-3 p-3 rounded-2xl border border-transparent hover:border-slate-200/80 dark:hover:border-white/10 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all cursor-pointer group">
        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-1 rounded-md bg-brand-50 dark:bg-brand-950/70 text-brand-700 dark:text-brand-300 border border-brand-500/20 shrink-0 mt-0.5">
          ${item.type}
        </span>
        <div class="flex-grow min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h4 class="font-bold text-sm text-slate-900 dark:text-white truncate group-hover:text-brand-600 transition-colors">
              ${item.title}
            </h4>
            <span class="text-[10px] text-slate-400 font-mono shrink-0">${item.level}</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">${item.summary || ''}</p>
        </div>
      </a>
    `).join('');
  }

  searchInput?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (!q) {
      renderResults(searchData.slice(0, 6));
      return;
    }
    const filtered = searchData.filter(item => 
      item.title.toLowerCase().includes(q) ||
      (item.summary && item.summary.toLowerCase().includes(q)) ||
      (item.tags && item.tags.toLowerCase().includes(q)) ||
      item.category.toLowerCase().includes(q)
    );
    renderResults(filtered.slice(0, 10));
  });
</script>
