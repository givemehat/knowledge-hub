---
import { TOPICS } from '../data/topics';
import { ROADMAPS } from '../data/roadmaps';
import { SCENARIOS } from '../data/scenarios';
import { BRAND } from '../config/brand';
import { CREATOR } from '../data/creator';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare search dataset
const searchData = [
  ...TOPICS.map(t => ({
    type: 'Topic',
    title: t.title,
    titleHindi: t.titleHindi || '',
    category: t.categoryLabel,
    level: t.level,
    url: `${base}/topics/${t.slug}/`,
    summary: t.summary,
    tags: t.tags.join(', ')
  })),
  ...ROADMAPS.map(r => ({
    type: 'Roadmap',
    title: r.title,
    titleHindi: r.titleHindi || '',
    category: 'Roadmap Guide',
    level: r.difficulty,
    url: `${base}/roadmaps/${r.slug}/`,
    summary: r.subtitle,
    tags: r.nodes.map(n => n.title).join(', ')
  })),
  ...SCENARIOS.map(s => ({
    type: 'Scenario',
    title: s.title,
    titleHindi: s.titleHindi,
    category: s.domainLabel,
    level: 'Hypothetical',
    url: `${base}/scenarios/${s.slug}/`,
    summary: s.abstract,
    tags: 'scenario, red-teaming, simulation, futures'
  })),
  {
    type: 'Research',
    title: 'Headlines of Fear & Hope: Longitudinal Sentiment and Framing Dynamics in Indian Media (2001–2023)',
    titleHindi: 'भारतीय समाचार मीडिया सेंटीमेंट और भावना अध्ययन (2001-2023)',
    category: 'Media Research',
    level: 'Data Analysis',
    url: `${base}/research/media-sentiment-study/`,
    summary: 'Longitudinal empirical research examining 3.84 million headlines from 2001 to 2023 using VADER, MuRIL, and Kaggle datasets.',
    tags: 'sentiment analysis, media, kaggle, research, headlines, emotions'
  },
  {
    type: 'Creator',
    title: `About ${CREATOR.name} & ${BRAND.name} Manifesto`,
    titleHindi: `${CREATOR.hindiName} और ${BRAND.nameHi} के बारे में`,
    category: 'Creator & Story',
    level: 'Profile',
    url: `${base}/about/`,
    summary: `Personal journey, skills, engineering background, and motivation behind building ${BRAND.name}.`,
    tags: 'creator, rajnish singh, author, about, portfolio, bio, skills'
  },
  {
    type: 'Contact',
    title: `Connect & Contact ${CREATOR.name}`,
    titleHindi: 'संपर्क करें और सहयोग करें',
    category: 'Collaboration',
    level: 'Connect',
    url: `${base}/contact/`,
    summary: 'Get in touch for internships, software engineering roles, open-source feedback, and vCard download.',
    tags: 'contact, hire, collaborate, message, email, github, vcard, qr code'
  }
];
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-start justify-center pt-16 sm:pt-24 px-4 transition-opacity">
  <div class="bg-white dark:bg-darkcard w-full max-w-2xl rounded-3xl shadow-elevation border border-slate-200 dark:border-white/10 overflow-hidden flex flex-col max-h-[80vh] animate-in fade-in zoom-in-95 duration-150">
    <!-- Input Bar -->
    <div class="flex items-center px-5 py-4 border-b border-slate-100 dark:border-white/10 gap-3">
      <svg class="w-5 h-5 text-brand-600 dark:text-brand-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Type to search topics, roadmaps, or tech concepts (e.g. RAG, DSA, Docker)..."
        class="w-full bg-transparent text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none"
        autocomplete="off"
      />
      <kbd id="close-search-btn" class="text-[11px] font-mono px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-white/10 cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">ESC</kbd>
    </div>

    <!-- Results List -->
    <div id="search-results" class="overflow-y-auto p-3 space-y-2 text-sm">
      <div class="p-8 text-center text-slate-400 text-xs">
        Search through verified topics, cheat sheets, and interview roadmaps...
      </div>
    </div>

    <!-- Quick Footer Tip -->
    <div class="px-5 py-3 bg-slate-50/80 dark:bg-slate-900/60 border-t border-slate-100 dark:border-white/10 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-3">
        <span><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↑</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↓</kbd> to navigate</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">↵</kbd> to select</span>
      </div>
      <span class="font-medium text-brand-600 dark:text-brand-400">Instant Static Search</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchData }}>
  const modal = document.getElementById('search-modal');
  const openBtn = document.getElementById('open-search-btn');
  const closeBtn = document.getElementById('close-search-btn');
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');

  let selectedIndex = -1;
  let currentResults = [];

  function openSearch() {
    modal.classList.remove('hidden');
    searchInput.value = '';
    renderResults(searchData.slice(0, 6));
    setTimeout(() => searchInput.focus(), 50);
  }

  function closeSearch() {
    modal.classList.add('hidden');
    selectedIndex = -1;
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      modal.classList.contains('hidden') ? openSearch() : closeSearch();
    }
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeSearch();
    }
    if (!modal.classList.contains('hidden')) {
      const items = resultsContainer.querySelectorAll('.search-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
        e.preventDefault();
        items[selectedIndex].click();
      }
    }
  });

  function updateActiveItem(items) {
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-slate-100', 'dark:bg-slate-800', 'border-brand-500/50');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'border-brand-500/50');
      }
    });
  }

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults(searchData.slice(0, 6));
      return;
    }

    currentResults = searchData.filter(item => 
      item.title.toLowerCase().includes(query) ||
      item.titleHindi.toLowerCase().includes(query) ||
      item.summary.toLowerCase().includes(query) ||
      item.tags.toLowerCase().includes(query) ||
      item.category.toLowerCase().includes(query)
    );

    renderResults(currentResults);
  });

  function renderResults(results) {
    selectedIndex = -1;
    if (results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="p-8 text-center text-slate-400 text-sm">
          No matching topics found for your search.
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = results.map((item, idx) => `
      <a href="${item.url}" class="search-item block p-3.5 rounded-2xl bg-white dark:bg-darkcard hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all border border-slate-200/70 dark:border-white/10">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/10">
              ${item.type}
            </span>
            <h4 class="font-semibold text-slate-900 dark:text-white text-sm">${item.title}</h4>
          </div>
          <span class="text-[11px] text-slate-400 font-medium shrink-0">${item.category}</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">${item.summary}</p>
      </a>
    `).join('');
  }
</script>
