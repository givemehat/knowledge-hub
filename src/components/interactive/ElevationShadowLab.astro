---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
---

<div id="elevation-shadow-lab" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80 dark:border-white/10">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-peach-500/10 text-peach-700 dark:text-peach-300 border border-peach-500/20 text-[11px] font-bold uppercase tracking-wider mb-1">
        <span>Spatial Depth Engine</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Elevation Hierarchy & Shadow Studio
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
        Master multi-layered elevation, directional lighting, and calibrated soft shadows across light and dark surfaces with interactive controls.
      </p>
    </div>

    <!-- Light/Dark Canvas Switcher -->
    <div class="inline-flex p-1 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10" id="shadow-canvas-theme-control">
      <button
        type="button"
        data-surface="light"
        class="shadow-surf-btn active px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white dark:bg-peach-600 text-peach-600 dark:text-white shadow-xs cursor-pointer"
      >
        Light Surface
      </button>
      <button
        type="button"
        data-surface="dark"
        class="shadow-surf-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
      >
        Dark Surface
      </button>
    </div>
  </div>

  <!-- 5 Elevation Level Quick Buttons -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="elevation-level-selector">
    <button
      type="button"
      data-level="0"
      class="elevation-btn p-3 rounded-xl border text-left transition-all border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300 cursor-pointer"
    >
      <span class="block text-xs font-bold uppercase tracking-wider">Level 0: Surface</span>
      <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Ground plane (0px)</span>
    </button>
    <button
      type="button"
      data-level="1"
      class="elevation-btn active p-3 rounded-xl border text-left transition-all bg-peach-500/10 border-peach-500 text-peach-900 dark:text-peach-200 cursor-pointer"
    >
      <span class="block text-xs font-bold uppercase tracking-wider">Level 1: Cards</span>
      <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Panels & Inset (2-4px)</span>
    </button>
    <button
      type="button"
      data-level="2"
      class="elevation-btn p-3 rounded-xl border text-left transition-all border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300 cursor-pointer"
    >
      <span class="block text-xs font-bold uppercase tracking-wider">Level 2: Buttons</span>
      <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Controls (6-8px)</span>
    </button>
    <button
      type="button"
      data-level="3"
      class="elevation-btn p-3 rounded-xl border text-left transition-all border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300 cursor-pointer"
    >
      <span class="block text-xs font-bold uppercase tracking-wider">Level 3: Menus</span>
      <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Dropdowns (12-16px)</span>
    </button>
    <button
      type="button"
      data-level="4"
      class="elevation-btn p-3 rounded-xl border text-left transition-all border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300 col-span-2 sm:col-span-1 cursor-pointer"
    >
      <span class="block text-xs font-bold uppercase tracking-wider">Level 4: Modals</span>
      <span class="block text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Overlays (24-32px)</span>
    </button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Sliders (5 cols) -->
    <div class="lg:col-span-5 space-y-4 p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm">
      
      <!-- X Offset Slider -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">X-Axis Offset</label>
          <span id="x-offset-val" class="font-mono text-slate-500">0px</span>
        </div>
        <input type="range" id="x-offset-slider" min="-20" max="20" value="0" class="w-full accent-peach-500 cursor-pointer" />
      </div>

      <!-- Y Offset Slider -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">Y-Axis Elevation Offset</label>
          <span id="y-offset-val" class="font-mono text-slate-500">4px</span>
        </div>
        <input type="range" id="y-offset-slider" min="0" max="40" value="4" class="w-full accent-peach-500 cursor-pointer" />
      </div>

      <!-- Blur Radius Slider -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">Blur Radius (Softness)</label>
          <span id="blur-val" class="font-mono text-slate-500">12px</span>
        </div>
        <input type="range" id="blur-slider" min="0" max="60" value="12" class="w-full accent-peach-500 cursor-pointer" />
      </div>

      <!-- Spread Radius Slider -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">Spread Radius</label>
          <span id="spread-val" class="font-mono text-slate-500">-2px</span>
        </div>
        <input type="range" id="spread-slider" min="-10" max="20" value="-2" class="w-full accent-peach-500 cursor-pointer" />
      </div>

      <!-- Opacity Slider -->
      <div class="space-y-1">
        <div class="flex items-center justify-between text-xs">
          <label class="font-bold text-slate-600 dark:text-slate-300">Shadow Opacity</label>
          <span id="opacity-val" class="font-mono text-slate-500">8%</span>
        </div>
        <input type="range" id="opacity-slider" min="1" max="40" value="8" class="w-full accent-peach-500 cursor-pointer" />
      </div>

      <!-- Shadow Tint Color Selector -->
      <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-white/5">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Shadow Hue Tint
        </label>
        <div class="flex items-center gap-2" id="shadow-tint-selector">
          <button type="button" data-tint="neutral" class="shadow-tint-btn active px-2.5 py-1 rounded-lg text-xs font-semibold border bg-peach-500/10 border-peach-500 text-peach-900 dark:text-peach-200">Neutral Dark</button>
          <button type="button" data-tint="peach" class="shadow-tint-btn px-2.5 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300">Peach Glow</button>
          <button type="button" data-tint="brand" class="shadow-tint-btn px-2.5 py-1 rounded-lg text-xs font-semibold border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:border-slate-300">Indigo Glow</button>
        </div>
      </div>
    </div>

    <!-- Live Preview Stage (7 cols) -->
    <div class="lg:col-span-7 space-y-4">
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm space-y-5">
        
        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-white/5 pb-2">
          <span class="font-bold text-slate-800 dark:text-slate-200">Interactive Elevation Canvas</span>
          <span id="elevation-active-label" class="font-mono text-[11px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Level 1: Cards</span>
        </div>

        <!-- Dynamic Surface Box -->
        <div id="elevation-stage-surface" class="h-64 rounded-2xl p-6 flex items-center justify-center transition-colors duration-300 bg-surface-light border border-slate-200">
          
          <!-- Elevated Test Object -->
          <div
            id="elevated-card-object"
            class="w-64 p-5 rounded-2xl transition-all duration-200 flex flex-col justify-between bg-white text-slate-900 border border-slate-200/60"
          >
            <div class="flex items-center justify-between">
              <div class="w-8 h-8 rounded-lg bg-peach-500/10 text-peach-600 flex items-center justify-center font-black text-xs">
                3D
              </div>
              <span id="card-elevation-pill" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
                Level 1
              </span>
            </div>
            <div class="py-2">
              <h5 class="text-sm font-black text-slate-900 dark:text-white">Spatial Elevation Tile</h5>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Directional lighting with natural spread.</p>
            </div>
            <div class="pt-2 border-t border-slate-100 dark:border-white/10 flex items-center justify-between text-[10px] font-mono text-slate-400">
              <span>Apple HIG Token</span>
              <span class="text-peach-600 font-bold">Interactive</span>
            </div>
          </div>
        </div>

        <!-- Generated CSS box-shadow Block -->
        <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-white/5">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Computed CSS box-shadow
            </label>
            <button
              id="copy-shadow-code-btn"
              type="button"
              class="text-xs font-bold text-peach-600 dark:text-peach-400 hover:text-peach-700 flex items-center gap-1 cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
              <span id="copy-shadow-code-label">Copy CSS Token</span>
            </button>
          </div>
          <pre id="shadow-code-output" class="p-3.5 rounded-xl bg-slate-900 text-slate-200 font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed border border-slate-800"></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function initElevationShadowLab() {
    let surfaceTheme = 'light';
    let currentLevel = '1';
    let xOffset = 0;
    let yOffset = 4;
    let blurRadius = 12;
    let spreadRadius = -2;
    let opacity = 8;
    let tint = 'neutral';

    const levelPresets = {
      '0': { y: 0, blur: 0, spread: 0, opacity: 0, label: 'Level 0: Surface (Ground)' },
      '1': { y: 4, blur: 12, spread: -2, opacity: 8, label: 'Level 1: Cards & Inset Panels' },
      '2': { y: 8, blur: 20, spread: -4, opacity: 12, label: 'Level 2: Buttons & Form Inputs' },
      '3': { y: 16, blur: 32, spread: -6, opacity: 15, label: 'Level 3: Dropdowns & Tooltips' },
      '4': { y: 28, blur: 48, spread: -8, opacity: 20, label: 'Level 4: Modals & Dialog Overlays' }
    };

    function getComputedShadow() {
      const alpha = (opacity / 100).toFixed(2);
      let color = `rgba(20, 18, 26, ${alpha})`;
      if (tint === 'peach') color = `rgba(255, 122, 89, ${alpha})`;
      else if (tint === 'brand') color = `rgba(91, 61, 245, ${alpha})`;
      
      if (opacity === 0 || (yOffset === 0 && blurRadius === 0 && spreadRadius === 0)) {
        return 'none';
      }
      return `${xOffset}px ${yOffset}px ${blurRadius}px ${spreadRadius}px ${color}`;
    }

    function updateShadow() {
      const stage = document.getElementById('elevation-stage-surface');
      const card = document.getElementById('elevated-card-object');
      const pill = document.getElementById('card-elevation-pill');
      const codeOutput = document.getElementById('shadow-code-output');
      const levelLabel = document.getElementById('elevation-active-label');

      // Update Slider Values Labels
      const xVal = document.getElementById('x-offset-val');
      const yVal = document.getElementById('y-offset-val');
      const bVal = document.getElementById('blur-val');
      const sVal = document.getElementById('spread-val');
      const oVal = document.getElementById('opacity-val');

      if (xVal) xVal.textContent = `${xOffset}px`;
      if (yVal) yVal.textContent = `${yOffset}px`;
      if (bVal) bVal.textContent = `${blurRadius}px`;
      if (sVal) sVal.textContent = `${spreadRadius}px`;
      if (oVal) oVal.textContent = `${opacity}%`;

      const shadow = getComputedShadow();

      // Update Surface Theme
      if (stage && card) {
        if (surfaceTheme === 'dark') {
          stage.style.backgroundColor = '#121016';
          stage.style.borderColor = 'rgba(255, 255, 255, 0.1)';
          card.style.backgroundColor = '#1A1722';
          card.style.borderColor = 'rgba(255, 255, 255, 0.1)';
        } else {
          stage.style.backgroundColor = '#FAF8F5';
          stage.style.borderColor = '#E2E8F0';
          card.style.backgroundColor = '#FFFFFF';
          card.style.borderColor = '#E2E8F0';
        }
        card.style.boxShadow = shadow;
      }

      if (pill) pill.textContent = `Level ${currentLevel}`;
      if (levelLabel && levelPresets[currentLevel]) {
        levelLabel.textContent = levelPresets[currentLevel].label;
      }

      if (codeOutput) {
        codeOutput.textContent = `/* CSS box-shadow */\nbox-shadow: ${shadow};\n\n/* Tailwind CSS Token */\n'elevation-level-${currentLevel}': '${shadow}'`;
      }
    }

    // Sliders
    const xSlider = document.getElementById('x-offset-slider');
    const ySlider = document.getElementById('y-offset-slider');
    const bSlider = document.getElementById('blur-slider');
    const sSlider = document.getElementById('spread-slider');
    const oSlider = document.getElementById('opacity-slider');

    if (xSlider) xSlider.addEventListener('input', (e) => { xOffset = parseInt(e.target.value); updateShadow(); });
    if (ySlider) ySlider.addEventListener('input', (e) => { yOffset = parseInt(e.target.value); updateShadow(); });
    if (bSlider) bSlider.addEventListener('input', (e) => { blurRadius = parseInt(e.target.value); updateShadow(); });
    if (sSlider) sSlider.addEventListener('input', (e) => { spreadRadius = parseInt(e.target.value); updateShadow(); });
    if (oSlider) oSlider.addEventListener('input', (e) => { opacity = parseInt(e.target.value); updateShadow(); });

    // Level Quick Switchers
    document.querySelectorAll('.elevation-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.elevation-btn').forEach(b => {
          b.classList.remove('active', 'bg-peach-500/10', 'border-peach-500', 'text-peach-900', 'dark:text-peach-200');
          b.classList.add('border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-peach-500/10', 'border-peach-500', 'text-peach-900', 'dark:text-peach-200');
        btn.classList.remove('border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300');

        currentLevel = btn.dataset.level || '1';
        const preset = levelPresets[currentLevel];
        if (preset) {
          yOffset = preset.y;
          blurRadius = preset.blur;
          spreadRadius = preset.spread;
          opacity = preset.opacity;
          if (ySlider) ySlider.value = yOffset;
          if (bSlider) bSlider.value = blurRadius;
          if (sSlider) sSlider.value = spreadRadius;
          if (oSlider) oSlider.value = opacity;
        }
        updateShadow();
      });
    });

    // Surface Theme Switcher
    document.querySelectorAll('.shadow-surf-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.shadow-surf-btn').forEach(b => {
          b.classList.remove('active', 'bg-white', 'dark:bg-peach-600', 'text-peach-600', 'dark:text-white', 'shadow-xs');
          b.classList.add('text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-white', 'dark:bg-peach-600', 'text-peach-600', 'dark:text-white', 'shadow-xs');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');

        surfaceTheme = btn.dataset.surface || 'light';
        updateShadow();
      });
    });

    // Tint Buttons
    document.querySelectorAll('.shadow-tint-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.shadow-tint-btn').forEach(b => {
          b.classList.remove('active', 'bg-peach-500/10', 'border-peach-500', 'text-peach-900', 'dark:text-peach-200');
          b.classList.add('border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-peach-500/10', 'border-peach-500', 'text-peach-900', 'dark:text-peach-200');
        btn.classList.remove('border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300');

        tint = btn.dataset.tint || 'neutral';
        updateShadow();
      });
    });

    // Copy Button
    const copyBtn = document.getElementById('copy-shadow-code-btn');
    const copyLabel = document.getElementById('copy-shadow-code-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', () => {
        const shadow = getComputedShadow();
        const text = `box-shadow: ${shadow};`;
        navigator.clipboard.writeText(text).then(() => {
          const original = copyLabel.textContent;
          copyLabel.textContent = 'Copied to Clipboard!';
          if (window.showToast) window.showToast('Elevation shadow token copied!');
          setTimeout(() => { copyLabel.textContent = original; }, 2000);
        });
      });
    }

    // Initial render
    updateShadow();
  })();
</script>
