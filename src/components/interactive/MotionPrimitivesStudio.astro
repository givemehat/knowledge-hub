---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
---

<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80 dark:border-white/10">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20 text-[11px] font-bold uppercase tracking-wider mb-1">
        <span>Motion Primitives • Spring Physics & Gestures</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Motion Primitives Studio: Dock, Morphing & Progressive Blur
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
        Interactive physics labs crafted after itsjwill/motion-primitives: cursor distance interpolation, layoutId morphing, and multi-step backdrop blur shaders.
      </p>
    </div>

    <!-- Official Registry Badge -->
    <div class="flex items-center gap-2">
      <span class="text-[11px] font-mono text-slate-400">motion-primitives.com</span>
      <a
        href="https://motion-primitives.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline inline-flex items-center gap-1"
      >
        <span>Docs & Registry</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <!-- THREE SIGNATURE MOTION PRIMITIVES LABS -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- LAB 1: macOS Floating Dock (7 cols) -->
    <div class="lg:col-span-7 p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm space-y-5" id="mp-floating-dock-card">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-bold uppercase">Primitive 01</span>
          <h4 class="text-base font-black text-slate-900 dark:text-white mt-0.5">macOS Floating Dock</h4>
        </div>
        <div class="flex items-center gap-2 text-[10px] font-mono">
          <span class="text-slate-400">Spring: stiffness 400, damping 30</span>
        </div>
      </div>

      <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
        Icons continuously interpolate scale and elevation based on cursor euclidean distance using spring physics.
      </p>

      <!-- Interactive Dock Stage -->
      <div class="py-12 px-4 rounded-xl bg-gradient-to-b from-slate-100 to-slate-200/70 dark:from-slate-900 dark:to-slate-950/80 border border-slate-200 dark:border-white/10 flex flex-col items-center justify-center relative overflow-hidden min-h-[160px]">
        
        <!-- Distance / Scale Feedback Pill -->
        <div class="absolute top-3 left-4 text-[11px] font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2">
          <span>Active Scale:</span>
          <span id="mp-dock-scale-feedback" class="font-bold text-purple-600 dark:text-purple-400">1.00x</span>
        </div>

        <!-- The Floating Dock -->
        <div
          id="mp-floating-dock"
          class="floating-dock-container backdrop-blur-xl bg-white/75 dark:bg-slate-900/80 border border-slate-300/70 dark:border-white/15 rounded-2xl p-2.5 flex items-end gap-3 shadow-2xl transition-all duration-150"
        >
          <!-- Item 1: Terminal -->
          <div class="dock-item group/item relative cursor-pointer" data-title="Terminal">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Terminal
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-slate-900 text-emerald-400 flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
          </div>

          <!-- Item 2: Code Editor -->
          <div class="dock-item group/item relative cursor-pointer" data-title="VS Code">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Editor
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
          </div>

          <!-- Item 3: Neural Search -->
          <div class="dock-item group/item relative cursor-pointer" data-title="AI Search">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Peach AI
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-gradient-to-tr from-peach-500 to-purple-600 text-white flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>

          <!-- Item 4: Browser -->
          <div class="dock-item group/item relative cursor-pointer" data-title="Browser">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Browser
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-amber-500 text-white flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            </div>
          </div>

          <!-- Item 5: Studio Design -->
          <div class="dock-item group/item relative cursor-pointer" data-title="Canvas">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Design
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-purple-600 text-white flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            </div>
          </div>

          <!-- Item 6: Settings -->
          <div class="dock-item group/item relative cursor-pointer" data-title="Settings">
            <div class="dock-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[10px] font-mono font-bold opacity-0 pointer-events-none transition-opacity duration-150">
              Settings
            </div>
            <div class="dock-icon w-11 h-11 rounded-xl bg-slate-700 text-white flex items-center justify-center shadow-md">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Copy Action Footer -->
      <div class="pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">npx motion-primitives add dock</span>
        <button
          type="button"
          class="copy-motion-snippet-btn text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline cursor-pointer"
          data-prompt="Create a macOS Floating Dock component using Framer Motion with useMotionValue, useSpring, and useTransform that smoothly interpolates icon magnification based on mouse cursor distance (max 1.55x scale with 140px threshold radius)."
        >
          Copy Dock Prompt
        </button>
      </div>
    </div>

    <!-- LAB 2: Morphing Popover & Dialog (5 cols) -->
    <div class="lg:col-span-5 p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm space-y-5" id="mp-morphing-card">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-bold uppercase">Primitive 02</span>
          <h4 class="text-base font-black text-slate-900 dark:text-white mt-0.5">Morphing Popover</h4>
        </div>
        <span class="text-[10px] font-mono text-slate-400">layoutId Animation</span>
      </div>

      <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
        Seamlessly morphs from a compact action pill into an expanded interactive panel without layout tearing.
      </p>

      <!-- Morphing Interactive Area -->
      <div class="py-8 px-4 rounded-xl bg-slate-100/70 dark:bg-slate-900/70 border border-slate-200 dark:border-white/10 flex flex-col items-center justify-center min-h-[160px] relative">
        
        <!-- Compact Pill Trigger (Initial state) -->
        <button
          type="button"
          id="mp-popover-trigger"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold text-xs shadow-lg hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-peach-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <span>Quick Launch</span>
          <kbd class="px-1.5 py-0.5 rounded bg-white/20 dark:bg-slate-900/20 text-[10px] font-mono">⌘K</kbd>
        </button>

        <!-- Expanded Morphed Popover Card (Toggled) -->
        <div
          id="mp-popover-panel"
          class="hidden w-full max-w-xs p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-white/15 shadow-2xl space-y-3 transition-all duration-300"
        >
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-white/10">
            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
              <span>Command Palette</span>
            </span>
            <button
              type="button"
              id="mp-popover-close-btn"
              class="w-5 h-5 rounded-md text-slate-400 hover:text-slate-800 dark:hover:text-white flex items-center justify-center text-xs font-bold cursor-pointer"
            >
              &times;
            </button>
          </div>

          <div class="space-y-1.5 text-xs">
            <div class="p-2 rounded-lg bg-slate-50 dark:bg-white/5 hover:bg-peach-50 dark:hover:bg-peach-950/30 text-slate-700 dark:text-slate-300 cursor-pointer flex items-center justify-between transition-colors">
              <span>Generate Bento Grid</span>
              <span class="text-[10px] font-mono text-slate-400">⌘B</span>
            </div>
            <div class="p-2 rounded-lg bg-slate-50 dark:bg-white/5 hover:bg-peach-50 dark:hover:bg-peach-950/30 text-slate-700 dark:text-slate-300 cursor-pointer flex items-center justify-between transition-colors">
              <span>Test WCAG Contrast</span>
              <span class="text-[10px] font-mono text-slate-400">⌘C</span>
            </div>
            <div class="p-2 rounded-lg bg-slate-50 dark:bg-white/5 hover:bg-peach-50 dark:hover:bg-peach-950/30 text-slate-700 dark:text-slate-300 cursor-pointer flex items-center justify-between transition-colors">
              <span>Audit Brand Archetypes</span>
              <span class="text-[10px] font-mono text-slate-400">⌘A</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Copy Action Footer -->
      <div class="pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">npx motion-primitives add popover</span>
        <button
          type="button"
          class="copy-motion-snippet-btn text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline cursor-pointer"
          data-prompt="Implement a fluid Morphing Popover using Framer Motion layoutId where a pill button expands seamlessly into an interactive command palette with spring transition physics."
        >
          Copy Popover Prompt
        </button>
      </div>
    </div>

    <!-- LAB 3: Progressive Blur Reveal (12 cols full width) -->
    <div class="lg:col-span-12 p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm space-y-5" id="mp-progressive-blur-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <span class="text-[10px] font-mono text-purple-600 dark:text-purple-400 font-bold uppercase">Primitive 03</span>
          <h4 class="text-base font-black text-slate-900 dark:text-white mt-0.5">Progressive Blur Reveal & Vignette Shader</h4>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-slate-500">Blur Depth:</span>
          <span id="mp-blur-val" class="text-xs font-mono font-bold text-purple-600 dark:text-purple-400">16px</span>
        </div>
      </div>

      <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
        Multi-step backdrop-filter shader with calibrated alpha gradient masks, creating high-end Apple visionOS style depth reveals.
      </p>

      <!-- Slider Control -->
      <div class="flex items-center gap-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10">
        <label for="mp-blur-slider" class="text-xs font-bold text-slate-700 dark:text-slate-300 shrink-0">
          Adjust Blur:
        </label>
        <input
          type="range"
          id="mp-blur-slider"
          min="0"
          max="32"
          step="2"
          value="16"
          class="w-full accent-purple-600 cursor-pointer"
        />
      </div>

      <!-- Live Progressive Blur Canvas -->
      <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 min-h-[220px] bg-gradient-to-tr from-slate-900 via-indigo-950 to-slate-900 text-white p-6 sm:p-8 flex flex-col justify-end">
        
        <!-- Underlying Content / Typography -->
        <div class="absolute inset-0 p-8 flex flex-col justify-between pointer-events-none opacity-80">
          <div class="space-y-1">
            <span class="text-xs font-mono text-peach-400 font-bold">SYSTEM_LOG_STREAM // KINETIC_RUNTIME</span>
            <div class="text-xl sm:text-2xl font-black text-slate-100">Deterministic Gesture Physics with Spring Velocity</div>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
            Progressive blur prevents harsh hard-edge clips when overlaying interactive controls or sticky headers above rich editorial imagery and live canvas feeds.
          </p>
        </div>

        <!-- The Progressive Blur Overlay Mask -->
        <div
          id="mp-progressive-blur-overlay"
          class="absolute inset-x-0 bottom-0 h-32 progressive-blur-mask flex items-end p-6 pointer-events-none"
        >
          <div class="relative z-10 flex items-center justify-between w-full text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-black/40 backdrop-blur-md border border-white/20 text-white font-bold">
              Layered Shader Active
            </span>
            <span class="text-white/80">mask-image: linear-gradient(to top, black, transparent)</span>
          </div>
        </div>
      </div>

      <!-- Copy Action Footer -->
      <div class="pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">npx motion-primitives add progressive-blur</span>
        <button
          type="button"
          class="copy-motion-snippet-btn text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline cursor-pointer"
          data-prompt="Build a Progressive Blur component with multi-tier backdrop-filter blur steps combined with linear-gradient alpha masking for smooth edge dissipation."
        >
          Copy Progressive Blur Prompt
        </button>
      </div>
    </div>

  </div>
</div>

<style>
  /* Progressive Blur Multi-Step Backdrop Filter */
  .progressive-blur-mask {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.8) 50%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.8) 50%, rgba(0, 0, 0, 0) 100%);
    transition: backdrop-filter 0.2s ease, -webkit-backdrop-filter 0.2s ease;
  }

  .dock-icon {
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: bottom center;
  }
</style>

<script is:inline>
  (function initMotionPrimitivesStudio() {
    // 1. macOS Floating Dock Spring Distance Calculation
    const dock = document.getElementById('mp-floating-dock');
    const scaleFeedback = document.getElementById('mp-dock-scale-feedback');

    if (dock) {
      const items = dock.querySelectorAll('.dock-item');
      const icons = dock.querySelectorAll('.dock-icon');
      const tooltips = dock.querySelectorAll('.dock-tooltip');

      dock.addEventListener('mousemove', e => {
        const mouseX = e.clientX;
        let maxActiveScale = 1.0;

        items.forEach((item, idx) => {
          const rect = item.getBoundingClientRect();
          const itemCenter = rect.left + rect.width / 2;
          const distance = Math.abs(mouseX - itemCenter);
          const maxDistance = 140; // Detection radius in px

          const icon = icons[idx];
          const tooltip = tooltips[idx];

          if (distance < maxDistance) {
            // Distance interpolation: Closer = Larger
            const factor = 1 - distance / maxDistance;
            const scale = 1 + factor * 0.55; // 1.0x to 1.55x
            const translateY = -12 * factor;

            if (scale > maxActiveScale) maxActiveScale = scale;

            if (icon) {
              icon.style.transform = `scale(${scale.toFixed(3)}) translateY(${translateY.toFixed(1)}px)`;
            }
            if (tooltip && factor > 0.6) {
              tooltip.style.opacity = '1';
            } else if (tooltip) {
              tooltip.style.opacity = '0';
            }
          } else {
            if (icon) icon.style.transform = 'scale(1) translateY(0px)';
            if (tooltip) tooltip.style.opacity = '0';
          }
        });

        if (scaleFeedback) {
          scaleFeedback.textContent = `${maxActiveScale.toFixed(2)}x`;
        }
      });

      dock.addEventListener('mouseleave', () => {
        icons.forEach(icon => {
          icon.style.transform = 'scale(1) translateY(0px)';
        });
        tooltips.forEach(t => {
          t.style.opacity = '0';
        });
        if (scaleFeedback) {
          scaleFeedback.textContent = '1.00x';
        }
      });
    }

    // 2. Morphing Popover Toggle
    const popoverTrigger = document.getElementById('mp-popover-trigger');
    const popoverPanel = document.getElementById('mp-popover-panel');
    const popoverClose = document.getElementById('mp-popover-close-btn');

    if (popoverTrigger && popoverPanel) {
      popoverTrigger.addEventListener('click', () => {
        popoverTrigger.classList.add('hidden');
        popoverPanel.classList.remove('hidden');
      });

      if (popoverClose) {
        popoverClose.addEventListener('click', () => {
          popoverPanel.classList.add('hidden');
          popoverTrigger.classList.remove('hidden');
        });
      }
    }

    // 3. Progressive Blur Slider
    const blurSlider = document.getElementById('mp-blur-slider');
    const blurVal = document.getElementById('mp-blur-val');
    const blurOverlay = document.getElementById('mp-progressive-blur-overlay');

    if (blurSlider && blurOverlay) {
      blurSlider.addEventListener('input', e => {
        const val = e.target.value;
        if (blurVal) blurVal.textContent = `${val}px`;
        blurOverlay.style.backdropFilter = `blur(${val}px)`;
        blurOverlay.style.webkitBackdropFilter = `blur(${val}px)`;
      });
    }
  })();
</script>
