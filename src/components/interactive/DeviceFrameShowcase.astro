---
import { BRAND } from '../../config/brand';
---

<div id="device-framing-studio" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80 dark:border-white/10">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-peach-500/10 text-peach-700 dark:text-peach-300 border border-peach-500/20 text-[11px] font-bold uppercase tracking-wider mb-1">
        <span>Device Presentation</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Device Framing & Responsive Mockups
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
        When asking AI models to generate UI previews, specifying device frames turns plain code into persuasive client-ready mockups.
      </p>
    </div>

    <!-- Frame Switcher Tabs -->
    <div class="flex items-center gap-1 p-1 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-white/10 self-start sm:self-auto">
      <button
        id="frame-tab-desktop"
        class="frame-tab active px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs"
        data-frame="desktop"
      >
        macOS Browser
      </button>
      <button
        id="frame-tab-mobile"
        class="frame-tab px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all"
        data-frame="mobile"
      >
        iPhone 16 Pro
      </button>
    </div>
  </div>

  <!-- macOS Browser Frame View -->
  <div id="frame-view-desktop" class="frame-view transition-all duration-300">
    <div class="rounded-2xl overflow-hidden border border-slate-300/80 dark:border-white/15 bg-white dark:bg-slate-950 shadow-2xl">
      <!-- Browser Top Bar -->
      <div class="h-11 px-4 bg-slate-100/90 dark:bg-slate-900/90 border-b border-slate-200 dark:border-white/10 flex items-center justify-between">
        <!-- Traffic Lights -->
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10 inline-block"></span>
        </div>

        <!-- URL Pill -->
        <div class="px-4 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-white/5 text-[11px] font-mono text-slate-500 dark:text-slate-400 flex items-center gap-2 max-w-sm w-full mx-4 justify-center">
          <svg class="w-3 h-3 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          <span class="truncate">https://peach.dev/explore/ai-ml</span>
        </div>

        <!-- Right Window Controls -->
        <div class="flex items-center gap-2 text-slate-400">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
      </div>

      <!-- Browser Inner Content Canvas -->
      <div class="p-6 sm:p-8 bg-gradient-to-b from-slate-50 via-white to-slate-50 dark:from-slate-950 dark:via-darkcard dark:to-slate-950 space-y-6">
        <div class="max-w-2xl mx-auto text-center space-y-3 py-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-peach-500/10 text-peach-700 dark:text-peach-300 text-xs font-bold">
            <span>✨ Live Inside macOS Browser Frame</span>
          </div>
          <h4 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            Realistic Context Accelerates Decision Making
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-md mx-auto leading-relaxed">
            By embedding components inside authentic desktop and mobile frames, reviewers evaluate responsive breakpoints and typography scale in true-to-life form.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- iPhone 16 Pro Frame View (Hidden by default) -->
  <div id="frame-view-mobile" class="frame-view hidden transition-all duration-300">
    <div class="max-w-[340px] mx-auto rounded-[46px] border-[10px] border-slate-900 dark:border-slate-800 bg-slate-950 shadow-2xl p-1 relative overflow-hidden">
      <!-- Screen Area -->
      <div class="rounded-[36px] overflow-hidden bg-white dark:bg-[#121016] min-h-[580px] flex flex-col relative border border-black/20">
        <!-- Status Bar & Dynamic Island -->
        <div class="px-6 pt-3 flex items-center justify-between text-[11px] font-semibold text-slate-900 dark:text-white z-20">
          <span>9:41</span>
          <!-- Dynamic Island Pill -->
          <div class="w-24 h-5 rounded-full bg-black mx-auto flex items-center justify-between px-2 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-[#101010]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#0a192f]/60 border border-blue-900/40"></span>
          </div>
          <div class="flex items-center gap-1">
            <span class="text-[9px] font-bold">5G</span>
            <div class="w-4 h-2 rounded-xs border border-current p-0.5 flex items-center">
              <div class="w-full h-full bg-current rounded-2xs"></div>
            </div>
          </div>
        </div>

        <!-- Mobile Screen Content -->
        <div class="p-5 space-y-4 flex-1 flex flex-col justify-center text-center">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-peach-500 to-brand-500 mx-auto flex items-center justify-center text-white font-bold text-lg shadow-md shadow-peach-500/20">
            🍑
          </div>
          <h5 class="text-lg font-black text-slate-900 dark:text-white leading-tight">
            Mobile-First Experience
          </h5>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed px-2">
            Touch targets are systematically scaled to minimum 44px height with 16px margins to prevent miss-clicks.
          </p>
          <div class="pt-2">
            <button class="w-full py-2.5 px-4 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs shadow-sm">
              Get Started →
            </button>
          </div>
        </div>

        <!-- Bottom Home Indicator -->
        <div class="w-28 h-1 bg-slate-300 dark:bg-slate-700 rounded-full mx-auto mb-2 mt-auto"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const desktopTab = document.getElementById('frame-tab-desktop');
  const mobileTab = document.getElementById('frame-tab-mobile');
  const desktopView = document.getElementById('frame-view-desktop');
  const mobileView = document.getElementById('frame-view-mobile');

  desktopTab?.addEventListener('click', () => {
    desktopTab.classList.add('active', 'bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-xs');
    desktopTab.classList.remove('text-slate-600', 'dark:text-slate-400');
    mobileTab.classList.remove('active', 'bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-xs');
    mobileTab.classList.add('text-slate-600', 'dark:text-slate-400');

    desktopView?.classList.remove('hidden');
    mobileView?.classList.add('hidden');
  });

  mobileTab?.addEventListener('click', () => {
    mobileTab.classList.add('active', 'bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-xs');
    mobileTab.classList.remove('text-slate-600', 'dark:text-slate-400');
    desktopTab.classList.remove('active', 'bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-xs');
    desktopTab.classList.add('text-slate-600', 'dark:text-slate-400');

    mobileView?.classList.remove('hidden');
    desktopView?.classList.add('hidden');
  });
</script>
