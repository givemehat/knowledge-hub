---
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import InsetPanel from '../ui/InsetPanel.astro';
import Button from '../ui/Button.astro';
---

<div id="scenario-prompt-presets" class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80 dark:border-white/10">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-peach-500/10 text-peach-700 dark:text-peach-300 border border-peach-500/20 text-[11px] font-bold uppercase tracking-wider mb-1">
        <span>Production Ready Presets</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        4 Real-World Scenario Typography Presets
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
        Production-tested typographic architectures with exact sizing scales, weights, line heights, and 1-click generative prompts.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="scenario-cards-grid">
    
    <!-- Scenario 1: Modern Business Website -->
    <div class="scenario-card p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            Corporate & Enterprise
          </span>
          <span class="text-xs font-mono text-slate-400">Inter (Modern Sans)</span>
        </div>

        <div>
          <h4 class="font-bold text-lg text-slate-900 dark:text-white">
            Modern Business Website
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Balanced geometric clarity with dark gray readability and crisp hierarchy.
          </p>
        </div>

        <!-- Live Styled Mini Preview Box -->
        <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-white/5 space-y-2.5">
          <div class="text-[11px] font-semibold text-slate-500 font-sans tracking-wide">
            ENTERPRISE PLATFORM
          </div>
          <div class="font-bold text-slate-900 dark:text-white font-sans leading-tight text-xl">
            Scale Operations Globally
          </div>
          <div class="text-xs text-slate-600 dark:text-slate-300 font-sans leading-relaxed">
            Unify data silos and automate mission-critical workflows with zero infrastructure overhead.
          </div>
          <div class="pt-1">
            <span class="inline-block px-3 py-1.5 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 text-xs font-semibold">
              Get Started Now
            </span>
          </div>
        </div>

        <!-- Specifications Breakdown -->
        <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            H1: <strong>48px (700)</strong> · -0.02em
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            H2: <strong>24px (600)</strong> · -0.01em
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Body: <strong>16px (400)</strong> · 1.5 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Button: <strong>16px (600)</strong>
          </div>
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">Neutral #333 Palette</span>
        <button
          type="button"
          class="copy-scenario-prompt-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-peach-600 dark:hover:bg-peach-400 dark:hover:text-white transition-colors"
          data-prompt="Create a business homepage using Inter with the following typography scale: • Headings: 48px, font-weight: 700, letter-spacing: -0.02em • Subheadings: 24px, font-weight: 600, letter-spacing: -0.01em • Body text: 16px, font-weight: 400, line-height: 1.5 • Button text: 16px, font-weight: 600 • Caption text: 12px, font-weight: 400, letter-spacing: 0.02em • Use a dark gray (#333) for text on white backgrounds for readability."
        >
          Copy Prompt
        </button>
      </div>
    </div>

    <!-- Scenario 2: Editorial Blog -->
    <div class="scenario-card p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300">
            Longform & Publication
          </span>
          <span class="text-xs font-mono text-slate-400">Playfair + Merriweather</span>
        </div>

        <div>
          <h4 class="font-bold text-lg text-slate-900 dark:text-white">
            Editorial Publication
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Refined classical serifs optimized for longform immersion and typographic poise.
          </p>
        </div>

        <!-- Live Styled Mini Preview Box -->
        <div class="p-5 rounded-xl bg-[#FAFAF8] dark:bg-slate-900/60 border border-slate-200/60 dark:border-white/5 space-y-2.5">
          <div class="text-[10px] font-bold text-amber-800 dark:text-amber-400 tracking-wider uppercase font-serif">
            CULTURE & CRITIQUE
          </div>
          <div class="font-bold text-slate-900 dark:text-white leading-tight text-xl" style="font-family: 'Playfair Display', serif;">
            The Architecture of Quiet Spaces
          </div>
          <div class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed" style="font-family: 'Merriweather', serif;">
            Modern attention spans fracture under sensory overload; intentional typographic restraint restores contemplative depth.
          </div>
          <div class="text-xs italic text-slate-500 font-serif border-l-2 border-amber-600 pl-2 py-0.5">
            "Design is as much about silence as it is about statement."
          </div>
        </div>

        <!-- Specifications Breakdown -->
        <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            H1: <strong>56px (700)</strong> · 1.1 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            H2: <strong>32px (600)</strong> · 1.2 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Body: <strong>18px (400)</strong> · 1.6 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Max-W: <strong>680px Container</strong>
          </div>
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">Warm Paper Palette</span>
        <button
          type="button"
          class="copy-scenario-prompt-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-peach-600 dark:hover:bg-peach-400 dark:hover:text-white transition-colors"
          data-prompt="Design a blog layout with elegant typography: • Article titles: Playfair Display, 56px, font-weight: 700, line-height: 1.1 • Section headings: Playfair Display, 32px, font-weight: 600, line-height: 1.2 • Body text: Merriweather, 18px, font-weight: 400, line-height: 1.6 • Pull quotes: Playfair Display italic, 24px, line-height: 1.4 • Category labels: Merriweather Bold, 12px, ALL CAPS, letter-spacing: 0.05em • Use a max-width of 680px for text containers to improve readability."
        >
          Copy Prompt
        </button>
      </div>
    </div>

    <!-- Scenario 3: Tech Startup / SaaS -->
    <div class="scenario-card p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-300">
            High-Growth SaaS
          </span>
          <span class="text-xs font-mono text-slate-400">Bricolage + Inter</span>
        </div>

        <div>
          <h4 class="font-bold text-lg text-slate-900 dark:text-white">
            Tech Startup & SaaS
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Expressive grotesque headlines paired with ultra-legible UI primitives and blue CTAs.
          </p>
        </div>

        <!-- Live Styled Mini Preview Box -->
        <div class="p-5 rounded-xl bg-slate-950 text-white border border-slate-800 space-y-2.5">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 text-[10px] font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            <span>V2.4 ENGINE RELEASE</span>
          </div>
          <div class="font-bold leading-tight text-xl tracking-tight" style="font-family: 'Bricolage Grotesque', sans-serif;">
            Ship Features 10x Faster
          </div>
          <div class="text-xs text-slate-300 leading-relaxed font-sans">
            Automate tests, build previews, and deploy globally in seconds with our serverless runtime.
          </div>
          <div class="pt-1 flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-semibold hover:bg-blue-500 transition-colors">
              Deploy Free →
            </span>
            <span class="text-xs text-slate-400 font-mono">CLI: npx run peach</span>
          </div>
        </div>

        <!-- Specifications Breakdown -->
        <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Hero: <strong>64px (700)</strong> · -0.03em
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Titles: <strong>28px (600)</strong> · -0.01em
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            UI Text: <strong>16px (400)</strong> · 1.5 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Accent: <strong>Electric Blue (#3B82F6)</strong>
          </div>
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">Electric Blue Accent</span>
        <button
          type="button"
          class="copy-scenario-prompt-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-peach-600 dark:hover:bg-peach-400 dark:hover:text-white transition-colors"
          data-prompt="Create a SaaS landing page with modern typography: • Hero heading: Bricolage Grotesque, 64px, font-weight: 700, letter-spacing: -0.03em • Feature titles: Bricolage Grotesque, 28px, font-weight: 600, letter-spacing: -0.01em • UI text: Inter, 16px, font-weight: 400, line-height: 1.5 • Button text: Inter, 14px, font-weight: 600, letter-spacing: 0.01em • Nav links: Inter, 14px, font-weight: 500 • Use vibrant blue (#3B82F6) for interactive elements with white text."
        >
          Copy Prompt
        </button>
      </div>
    </div>

    <!-- Scenario 4: E-commerce Store -->
    <div class="scenario-card p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-white/10 shadow-apple-sm flex flex-col justify-between">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300">
            Retail & Commerce
          </span>
          <span class="text-xs font-mono text-slate-400">Plus Jakarta Sans</span>
        </div>

        <div>
          <h4 class="font-bold text-lg text-slate-900 dark:text-white">
            E-commerce Storefront
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Heavy weight contrast with accessible prices, clean specs, and high-impact CTAs.
          </p>
        </div>

        <!-- Live Styled Mini Preview Box -->
        <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-white/5 space-y-2.5 font-sans" style="font-family: 'Plus Jakarta Sans', sans-serif;">
          <div class="text-[11px] font-bold text-slate-400 tracking-wider uppercase">
            FLAGSHIP HARDWARE
          </div>
          <div class="flex items-baseline justify-between">
            <div class="font-extrabold text-slate-900 dark:text-white text-lg">
              Studio Wireless ANC
            </div>
            <div class="font-extrabold text-slate-900 dark:text-white text-base">
              ₹24,999
            </div>
          </div>
          <div class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Custom 40mm transducers, lossless spatial audio, and 40-hour battery life.
          </div>
          <div class="pt-1 flex items-center justify-between">
            <span class="px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500 transition-colors">
              Add to Cart
            </span>
            <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">In Stock · Free Delivery</span>
          </div>
        </div>

        <!-- Specifications Breakdown -->
        <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Title: <strong>40px (800)</strong> · Bold
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Product: <strong>24px (700)</strong> · 1.2 LH
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Price: <strong>18px (700)</strong> · High Contrast
          </div>
          <div class="p-2 rounded bg-slate-50 dark:bg-slate-900/40 text-slate-600 dark:text-slate-400">
            Button: <strong>14px (600)</strong>
          </div>
        </div>
      </div>

      <div class="mt-5 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">WCAG 4.5:1 Contrast</span>
        <button
          type="button"
          class="copy-scenario-prompt-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-peach-600 dark:hover:bg-peach-400 dark:hover:text-white transition-colors"
          data-prompt="Design an e-commerce store with clean, accessible typography: • Page titles: Plus Jakarta Sans, 40px, font-weight: 800 • Product names: Plus Jakarta Sans, 24px, font-weight: 700, line-height: 1.2 • Product descriptions: Plus Jakarta Sans, 16px, font-weight: 400, line-height: 1.5 • Prices: Plus Jakarta Sans, 18px, font-weight: 700 • Button text: Plus Jakarta Sans, 14px, font-weight: 600 • Category labels: Plus Jakarta Sans, 12px, font-weight: 600, letter-spacing: 0.02em • Ensure strong color contrast for prices and CTAs for better accessibility."
        >
          Copy Prompt
        </button>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function initScenarioPresets() {
    document.querySelectorAll('.copy-scenario-prompt-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prompt = btn.dataset.prompt;
        if (!prompt) return;
        try {
          await navigator.clipboard.writeText(prompt);
          const originalText = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = originalText;
          }, 2000);
        } catch (e) {
          console.error('Copy failed:', e);
        }
      });
    });
  })();
</script>
