<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }

  /* Pulse Glow Animation */
  @keyframes pulseGlowRing {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .anim-pulse-glow {
    animation: pulseGlowRing 2s infinite;
  }

  /* Material Ripple Ink */
  .ink-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transform: scale(0);
    animation: inkRippleEffect 0.6s linear;
    pointer-events: none;
  }
  @keyframes inkRippleEffect {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* Magic UI 1: Border Beam Ring Animation */
  @keyframes borderBeamRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .border-beam-ring {
    position: absolute;
    inset: -150%;
    background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, transparent 270deg, #FF7A59 310deg, #9333EA 340deg, #5B3DF5 360deg);
    animation: borderBeamRotate 4s linear infinite;
  }

  /* Magic UI 2: Animated Beam Stream */
  @keyframes beamStreamMove {
    from { stroke-dashoffset: 185; }
    to { stroke-dashoffset: 0; }
  }
  .anim-beam-stream {
    animation: beamStreamMove 2.2s linear infinite;
  }
  .anim-beam-fast {
    animation: beamStreamMove 0.8s linear infinite !important;
  }

  /* Magic UI 3: Shimmer Button Reflection */
  @keyframes shimmerSweep {
    0% { transform: translateX(-150%) skewX(-20deg); }
    100% { transform: translateX(250%) skewX(-20deg); }
  }
  .shimmer-glimmer {
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    animation: shimmerSweep 2.5s infinite ease-in-out;
    pointer-events: none;
  }

  /* Magic UI 4: Meteors */
  @keyframes meteorFlight {
    0% {
      transform: rotate(215deg) translateX(0);
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: rotate(215deg) translateX(-280px);
      opacity: 0;
    }
  }
  .meteor-streak {
    position: absolute;
    height: 1.5px;
    width: 50px;
    background: linear-gradient(to right, #ffffff, transparent);
    animation: meteorFlight 2.5s linear infinite;
    pointer-events: none;
  }
  .meteor-streak::before {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 0 10px 1px #FF9E7A;
  }

  /* Magic UI 5: Floating Particles */
  @keyframes particleFloat {
    0%, 100% {
      transform: translateY(0px) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translateY(-12px) scale(1.3);
      opacity: 1;
    }
  }
  .floating-particle {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: #9333EA;
    box-shadow: 0 0 8px 1px #C084FC;
    animation: particleFloat 3s ease-in-out infinite;
    transition: all 0.5s ease-out;
  }
</style>

<script is:inline>
  (function initCardButtonMotion() {
    // 1. 3D Tilt Card Interaction
    const tiltCard = document.getElementById('interactive-tilt-card');
    if (tiltCard) {
      tiltCard.addEventListener('mousemove', e => {
        const rect = tiltCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;
        tiltCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      });

      tiltCard.addEventListener('mouseleave', () => {
        tiltCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    }

    // 2. Ripple Button Interaction
    const rippleBtn = document.getElementById('ripple-demo-button');
    if (rippleBtn) {
      rippleBtn.addEventListener('click', e => {
        const circle = document.createElement('span');
        const diameter = Math.max(rippleBtn.clientWidth, rippleBtn.clientHeight);
        const radius = diameter / 2;
        const rect = rippleBtn.getBoundingClientRect();

        circle.style.width = circle.style.height = `${diameter}px`;
        circle.style.left = `${e.clientX - rect.left - radius}px`;
        circle.style.top = `${e.clientY - rect.top - radius}px`;
        circle.classList.add('ink-ripple');

        const ripple = rippleBtn.querySelector('.ink-ripple');
        if (ripple) ripple.remove();

        rippleBtn.appendChild(circle);
      });
    }

    // 3. Magic UI: Animated Beam Pulse Trigger
    const beamPulseBtn = document.getElementById('trigger-beam-pulse-btn');
    const activeBeamPath = document.getElementById('magic-beam-active-path');
    if (beamPulseBtn && activeBeamPath) {
      beamPulseBtn.addEventListener('click', () => {
        activeBeamPath.classList.add('anim-beam-fast');
        beamPulseBtn.textContent = 'Streaming...';
        setTimeout(() => {
          activeBeamPath.classList.remove('anim-beam-fast');
          beamPulseBtn.textContent = 'Pulse';
        }, 1600);
      });
    }

    // 4. Magic UI: Randomize Particles Field
    const scatterBtn = document.getElementById('randomize-particles-btn');
    const particles = document.querySelectorAll('.floating-particle');
    if (scatterBtn && particles.length > 0) {
      scatterBtn.addEventListener('click', () => {
        particles.forEach(p => {
          const randTop = Math.floor(Math.random() * 80) + 10;
          const randLeft = Math.floor(Math.random() * 80) + 10;
          p.style.top = `${randTop}%`;
          p.style.left = `${randLeft}%`;
        });
      });
    }

    // 5. Copy prompt buttons
    document.querySelectorAll('.copy-motion-snippet-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const prompt = btn.dataset.prompt;
        if (!prompt) return;
        try {
          await navigator.clipboard.writeText(prompt);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch (e) {
          console.error('Clipboard copy failed:', e);
        }
      });
    });
  })();
</script>
