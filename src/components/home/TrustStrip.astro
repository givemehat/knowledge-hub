---
interface Props {
  topicCount: number;
  roadmapCount: number;
  resourceCount: number;
  sourceCount: number;
}

const { topicCount, roadmapCount, resourceCount, sourceCount } = Astro.props;

const trustPoints = [
  {
    title: 'Har claim ka verified source',
    desc: 'Primary docs, papers, and GitHub code',
    iconSvg: `<svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    title: 'Last verified date on every guide',
    desc: 'Freshly audited, no stale information',
    iconSvg: `<svg class="w-4 h-4 text-peacock-600 dark:text-peacock-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
  },
  {
    title: '100% Free, No Ads, No Login',
    desc: 'Open web architecture for fast learning',
    iconSvg: `<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`
  },
  {
    title: 'Open to community corrections',
    desc: 'Suggest fixes directly via GitHub',
    iconSvg: `<svg class="w-4 h-4 text-saffron-600 dark:text-saffron-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" y1="9" x2="6" y2="21"/></svg>`
  }
];
---

<section class="py-5 sm:py-6 bg-slate-50/70 dark:bg-darkcard/40 border-b border-slate-200/80 dark:border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Real Numbers Strip (Zero Fake Numbers) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 pb-4 mb-4 sm:pb-5 sm:mb-5 border-b border-slate-200/70 dark:border-white/10">
      <div class="text-center sm:text-left">
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          {topicCount}
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
          Curated Topic Guides
        </div>
      </div>

      <div class="text-center sm:text-left">
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          {roadmapCount}
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
          Interactive Career Roadmaps
        </div>
      </div>

      <div class="text-center sm:text-left">
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          {resourceCount}+
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
          Curated Free Resources
        </div>
      </div>

      <div class="text-center sm:text-left">
        <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          {sourceCount}+
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
          Verified Primary Citations
        </div>
      </div>
    </div>

    <!-- 4 Honest Trust Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {trustPoints.map(point => (
        <div class="flex items-start gap-3 p-3 rounded-xl bg-white/70 dark:bg-white/5 border border-slate-200/60 dark:border-white/5 shadow-2xs">
          <div class="p-2 rounded-lg bg-slate-100/90 dark:bg-white/10 shrink-0" set:html={point.iconSvg} />
          <div>
            <h4 class="text-xs font-bold text-slate-900 dark:text-white leading-snug">
              {point.title}
            </h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-tight">
              {point.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
