---
import { CATEGORIES, TOPICS } from '../../data/topics';
import DomainCard from '../domains/DomainCard.astro';
import hiDict from '../../i18n/hi.json';
import enDict from '../../i18n/en.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Default locale is pure Hindi (Devanagari)
const locale = 'hi';
const isHindi = locale === 'hi';
const t = isHindi ? hiDict : enDict;

// Prepare enriched category objects with localized names & benefits
const enrichedCategories = CATEGORIES.map(cat => {
  const catHi = hiDict.categories[cat.id as keyof typeof hiDict.categories];
  const catEn = enDict.categories[cat.id as keyof typeof enDict.categories];

  return {
    id: cat.id,
    name: catHi ? catHi.name : cat.name,
    nameEn: catEn ? catEn.name : cat.name,
    benefit: catHi ? catHi.benefit : cat.description,
    benefitEn: catEn ? catEn.benefit : cat.description
  };
});
---

<section id="domains-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14" aria-labelledby="domains-heading">
  <!-- Section Header: Clean typography, pure language, NO ALL-CAPS, NO Hinglish -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 dark:text-brand-400 mb-2">
        <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="7" x="3" y="3" rx="1.5"/>
          <rect width="7" height="7" x="14" y="3" rx="1.5"/>
          <rect width="7" height="7" x="14" y="14" rx="1.5"/>
          <rect width="7" height="7" x="3" y="14" rx="1.5"/>
        </svg>
        <span id="domains-eyebrow" class="font-medium tracking-normal">{t.domains.eyebrow}</span>
      </div>
      <h2 id="domains-heading" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-normal [letter-spacing:0]">
        {t.domains.heading}
      </h2>
      <p id="domains-subtext" class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-xl leading-relaxed">
        {t.domains.subtext}
      </p>
    </div>

    <a
      id="domains-view-all-link"
      href={`${base}/topics/`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors group self-start sm:self-end"
    >
      <span>{t.domains.viewAllCount.replace('{count}', TOPICS.length.toString())}</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Bento Grid: Responsive 3-columns desktop, 2-columns tablet, 1-column mobile. Equal height auto-rows-fr -->
  <div class="domains-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
    {enrichedCategories.map(category => {
      const categoryTopics = TOPICS.filter(t => t.category === category.id);
      return (
        <DomainCard
          category={category}
          topics={categoryTopics}
          locale={locale}
        />
      );
    })}
  </div>
</section>

<!-- Client-side reactive i18n text switcher for domains section -->
<script is:inline define:vars={{ hiDict, enDict, topicCount: TOPICS.length }}>
  function handleLangSwitch(lang) {
    const dict = lang === 'en' ? enDict : hiDict;
    const isEn = lang === 'en';

    const eyebrow = document.getElementById('domains-eyebrow');
    const heading = document.getElementById('domains-heading');
    const subtext = document.getElementById('domains-subtext');
    const viewAllLink = document.getElementById('domains-view-all-link');

    if (eyebrow) eyebrow.textContent = dict.domains.eyebrow;
    if (heading) heading.textContent = dict.domains.heading;
    if (subtext) subtext.textContent = dict.domains.subtext;
    if (viewAllLink) {
      const textSpan = viewAllLink.querySelector('span');
      if (textSpan) {
        textSpan.textContent = dict.domains.viewAllCount.replace('{count}', topicCount.toString());
      }
    }

    // Update individual cards
    document.querySelectorAll('.domain-card').forEach(card => {
      const catId = card.getAttribute('data-category');
      const isEmpty = card.getAttribute('data-empty') === 'true';
      const catMeta = dict.categories[catId];

      if (catMeta) {
        const titleEl = card.querySelector('h3');
        if (titleEl) titleEl.textContent = catMeta.name;

        const benefitEl = card.querySelector('p');
        if (benefitEl && !isEmpty) benefitEl.textContent = catMeta.benefit;
      }

      // Update CTA
      const ctaSpan = card.querySelector('.card-cta span');
      if (ctaSpan) ctaSpan.textContent = dict.domains.cardCta;

      // Update count pill
      const countPill = card.querySelector('.count-pill');
      if (countPill && !isEmpty) {
        const count = countPill.textContent.trim().split(' ')[0];
        if (isEn) {
          countPill.textContent = count === '1' ? '1 guide' : `${count} guides`;
        } else {
          countPill.textContent = count === '1' ? '1 गाइड' : `${count} गाइड`;
        }
      }
    });

    // Update document lang
    document.documentElement.lang = lang;
  }

  window.addEventListener('peach:lang-change', (event) => handleLangSwitch(event.detail.lang || 'hi'));
  window.addEventListener('app:lang-change', (event) => handleLangSwitch(event.detail.lang || 'hi'));

  // Apply stored preference on initial load
  (function initInitialLang() {
    const saved = localStorage.getItem('peach_preferred_lang') || 'hi';
    if (saved === 'en') {
      window.dispatchEvent(new CustomEvent('peach:lang-change', { detail: { lang: 'en' } }));
    } else {
      document.documentElement.lang = 'hi';
    }
  })();
</script>
