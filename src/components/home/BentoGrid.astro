---
import { CATEGORIES, TOPICS } from '../../data/topics';
import DomainCard from '../domains/DomainCard.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Prepare enriched category objects with localized names & benefits
const enrichedCategories = CATEGORIES.map(cat => {
  return {
    id: cat.id,
    name: t('hi', `categories.${cat.id}.name`),
    nameEn: t('en', `categories.${cat.id}.name`),
    benefit: t('hi', `categories.${cat.id}.benefit`),
    benefitEn: t('en', `categories.${cat.id}.benefit`)
  };
});
---

<section id="domains-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14" aria-labelledby="domains-heading">
  <!-- Section Header: Clean typography, pure language, NO ALL-CAPS, NO Hinglish -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 dark:text-brand-400 mb-2">
        <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="7" x="3" y="3" rx="1.5"/>
          <rect width="7" height="7" x="14" y="3" rx="1.5"/>
          <rect width="7" height="7" x="14" y="14" rx="1.5"/>
          <rect width="7" height="7" x="3" y="14" rx="1.5"/>
        </svg>
        <span id="domains-eyebrow" class="font-medium tracking-normal">{t(locale, 'domains.eyebrow')}</span>
      </div>
      <h2 id="domains-heading" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-normal [letter-spacing:0]">
        {t(locale, 'domains.heading')}
      </h2>
      <p id="domains-subtext" class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-xl leading-relaxed">
        {t(locale, 'domains.subtext')}
      </p>
    </div>

    <a
      id="domains-view-all-link"
      href={`${base}/${locale}/topics/`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors group self-start sm:self-end"
    >
      <span>{t(locale, 'domains.viewAllCount', { count: TOPICS.length })}</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Bento Grid: Responsive 3-columns desktop, 2-columns tablet, 1-column mobile. Equal height auto-rows-fr -->
  <div class="domains-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
    {enrichedCategories.map(category => {
      const categoryTopics = TOPICS.filter(t => t.category === category.id);
      return (
        <DomainCard
          category={category}
          topics={categoryTopics}
          locale={locale}
        />
      );
    })}
  </div>
</section>
