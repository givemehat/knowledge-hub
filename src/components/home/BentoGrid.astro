---
import { CATEGORIES, TOPICS } from '../../data/topics';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Visual styling metadata for each category with distinct palette & 28px Lucide SVGs
const categoryVisuals: Record<string, {
  tileBg: string;
  tileIconColor: string;
  iconSvg: string;
  accentBorder: string;
  badgeBg: string;
  gradientBg: string;
  benefit: string;
}> = {
  'ai-ml': {
    tileBg: 'bg-gradient-to-br from-brand-500 to-indigo-600 text-white shadow-brand-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-brand-500/50',
    badgeBg: 'bg-brand-50 text-brand-700 dark:bg-brand-950/70 dark:text-brand-300 border-brand-500/20',
    gradientBg: 'from-brand-500/10 via-indigo-500/5 to-transparent',
    benefit: 'Transformers, prompt engineering, RAG pipelines, aur production agents.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`
  },
  'quantum': {
    tileBg: 'bg-gradient-to-br from-cyan-500 to-blue-600 text-white shadow-cyan-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-cyan-500/50',
    badgeBg: 'bg-cyan-50 text-cyan-700 dark:bg-cyan-950/70 dark:text-cyan-300 border-cyan-500/20',
    gradientBg: 'from-cyan-500/10 via-blue-500/5 to-transparent',
    benefit: 'Qubit physics, superposition, entanglement, aur Qiskit code examples.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(45 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-45 12 12)"/><circle cx="12" cy="12" r="2"/></svg>`
  },
  'career': {
    tileBg: 'bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-emerald-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-emerald-500/50',
    badgeBg: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-500/20',
    gradientBg: 'from-emerald-500/10 via-teal-500/5 to-transparent',
    benefit: 'DSA sheet 6-month roadmap, off-campus hiring playbook, aur system design basics.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  'projects': {
    tileBg: 'bg-gradient-to-br from-saffron-500 to-amber-600 text-white shadow-saffron-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-saffron-500/50',
    badgeBg: 'bg-saffron-50 text-saffron-700 dark:bg-saffron-950/70 dark:text-saffron-300 border-saffron-500/20',
    gradientBg: 'from-saffron-500/10 via-amber-500/5 to-transparent',
    benefit: 'Unique resume-worthy projects, open source issues, aur GitHub contributions.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
  },
  'tech-fundamentals': {
    tileBg: 'bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-amber-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-amber-500/50',
    badgeBg: 'bg-amber-50 text-amber-700 dark:bg-amber-950/70 dark:text-amber-300 border-amber-500/20',
    gradientBg: 'from-amber-500/10 via-orange-500/5 to-transparent',
    benefit: 'Operating systems, computer networks, DBMS, aur core CS interview concepts.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>`
  },
  'gov-policy': {
    tileBg: 'bg-gradient-to-br from-kumkum-500 to-rose-600 text-white shadow-rose-500/20',
    tileIconColor: 'text-white',
    accentBorder: 'hover:border-rose-500/50',
    badgeBg: 'bg-rose-50 text-rose-700 dark:bg-rose-950/70 dark:text-rose-300 border-rose-500/20',
    gradientBg: 'from-rose-500/10 via-red-500/5 to-transparent',
    benefit: 'Samvidhan structure, EVM & VVPAT working, Union budget, aur DBT architecture.',
    iconSvg: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  }
};
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <!-- Section Header without Jargon -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="7" height="7" x="3" y="3" rx="1"/>
          <rect width="7" height="7" x="14" y="3" rx="1"/>
          <rect width="7" height="7" x="14" y="14" rx="1"/>
          <rect width="7" height="7" x="3" y="14" rx="1"/>
        </svg>
        <span>Chune Hue Domains</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
        Kya seekhna hai aaj?
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-xl">
        Tech fundamentals se le kar advanced AI aur samvidhan tak—har domain ke verified guides aur hands-on roadmaps.
      </p>
    </div>

    <a
      href={`${base}/topics/`}
      class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors group"
    >
      <span>Sab {TOPICS.length} Topics dekho</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Bento Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {CATEGORIES.map((cat, idx) => {
      const catTopics = TOPICS.filter(t => t.category === cat.id);
      const visual = categoryVisuals[cat.id] || categoryVisuals['ai-ml'];
      const isHeroCard = idx === 0; // AI/ML gets prominent featured visual styling

      return (
        <div
          class={`group relative p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 ${visual.accentBorder} hover:shadow-card hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between overflow-hidden ${
            isHeroCard ? 'md:col-span-2 lg:col-span-1 ring-1 ring-brand-500/20' : ''
          }`}
        >
          <!-- Ambient gradient background on hover -->
          <div class={`absolute inset-0 bg-gradient-to-br ${visual.gradientBg} opacity-30 group-hover:opacity-100 transition-opacity pointer-events-none`}></div>

          <div class="relative z-10">
            <!-- 56px Gradient Tile with 28px Lucide Vector Icon -->
            <div class="flex items-center justify-between mb-4">
              <div class={`w-14 h-14 rounded-2xl ${visual.tileBg} flex items-center justify-center shadow-md group-hover:scale-105 transition-transform`} set:html={visual.iconSvg}>
              </div>
              <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${visual.badgeBg}`}>
                {catTopics.length} Guides
              </span>
            </div>

            <!-- Title & Plain Benefit -->
            <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {cat.name}
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
              {visual.benefit}
            </p>

            <!-- 2-3 Direct Clickable Topic Links -->
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
                Top Topics:
              </span>
              <ul class="space-y-1.5">
                {catTopics.slice(0, 3).map(topTopic => (
                  <li>
                    <a
                      href={`${base}/topics/${topTopic.slug}/`}
                      class="text-xs text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-white font-medium flex items-center justify-between group/link py-0.5"
                    >
                      <span class="truncate">{topTopic.title}</span>
                      <span class="text-[10px] text-slate-400 group-hover/link:text-brand-500 ml-2 shrink-0">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom CTA Row -->
          <div class="relative z-10 mt-5 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
            <a
              href={`${base}/topics/?category=${cat.id}`}
              class="font-bold text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Domain explore karo</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      );
    })}
  </div>
</section>
