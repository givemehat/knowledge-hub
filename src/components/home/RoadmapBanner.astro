---
import IndianPattern from '../ui/IndianPattern.astro';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
  <div class="rounded-3xl p-6 sm:p-10 lg:p-12 bg-gradient-to-br from-slate-950 via-indigo-950/80 to-slate-950 text-white shadow-[0_20px_50px_rgba(0,0,0,0.25)] relative overflow-hidden border border-white/10">
    <!-- Subtle Jaali Background Accent -->
    <IndianPattern variant="jaali" opacity={0.03} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
      
      <!-- Left Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15">
          <svg class="w-3.5 h-3.5 text-peacock-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{isHindi ? 'प्रमुख रोडमैप • 100% निःशुल्क' : 'Featured Roadmap • 100% Free'}</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
          {isHindi 
            ? 'DSA से प्लेसमेंट तक: 6-महीने का संपूर्ण रोडमैप'
            : 'From DSA to Placement: 6-Month Complete Roadmap'}
        </h2>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl">
          {isHindi
            ? 'कैंपस और ऑफ़-कैंपस हायरिंग के लिए चरणबद्ध समय-सारणी, ब्राउज़र में स्वतः सुरक्षित होने वाली चेकलिस्ट और चुने हुए मुफ़्त संसाधन।'
            : 'Phase-by-phase timeline for campus and off-campus hiring, interactive checklist progress (saved in browser), and curated free resources.'}
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={`${base}/${locale}/roadmaps/dsa-placement/`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-slate-950 font-bold text-xs sm:text-sm hover:bg-slate-100 transition-all shadow-md hover:shadow-apple-md hover:-translate-y-0.5 active:scale-95"
          >
            <span>{isHindi ? 'रोडमैप शुरू करें' : 'Start roadmap'}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a
            href={`${base}/${locale}/roadmaps/ai-ml-engineer/`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/15 text-white font-bold text-xs sm:text-sm transition-all hover:-translate-y-0.5 active:scale-95"
          >
            <span>{isHindi ? 'AI/ML रोडमैप देखें' : 'View AI/ML roadmap'}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Interactive Preview Box (5 cols) -->
      <div class="lg:col-span-5 bg-white/5 backdrop-blur-md rounded-2xl p-5 border border-white/10 space-y-3">
        <div class="flex items-center justify-between text-xs pb-3 border-b border-white/10">
          <span class="font-bold text-slate-200">
            {isHindi ? 'इंटरैक्टिव चेकलिस्ट डेमो' : 'Interactive Checklist Demo'}
          </span>
          <span class="text-[10px] text-peacock-300 font-mono bg-peacock-500/20 px-2 py-0.5 rounded-full border border-peacock-500/30">
            {isHindi ? 'चरण 1 / 4' : 'Phase 1 of 4'}
          </span>
        </div>

        <div class="space-y-2.5 text-xs text-slate-200">
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/10">
            <span class="w-4 h-4 rounded-full bg-peacock-400 flex items-center justify-center text-slate-950 font-bold text-[9px]">✓</span>
            <span class="font-medium">Time & Space Complexity Basics</span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/10">
            <span class="w-4 h-4 rounded-full bg-peacock-400 flex items-center justify-center text-slate-950 font-bold text-[9px]">✓</span>
            <span class="font-medium">Two Pointers & Sliding Window</span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/10 opacity-75">
            <span class="w-4 h-4 rounded-full border border-white/40 flex items-center justify-center text-[9px]">3</span>
            <span class="font-medium">Binary Search & Recursion</span>
          </div>
        </div>

        <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-300">
          <span>{isHindi ? 'प्रगति स्वतः सहेजी जाती है' : 'Progress saved automatically'}</span>
          <span class="font-bold text-peacock-300 font-mono">2 / 12 {isHindi ? 'पूर्ण' : 'Completed'}</span>
        </div>
      </div>

    </div>
  </div>
</section>
