---
import IndianPattern from '../ui/IndianPattern.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="rounded-3xl p-6 sm:p-10 lg:p-12 bg-gradient-to-r from-brand-900 via-indigo-900 to-peacock-950 text-white shadow-xl relative overflow-hidden border border-white/10">
    <!-- Subtle Jaali Background Accent -->
    <IndianPattern variant="jaali" opacity={0.04} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
      
      <!-- Left Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-extrabold px-3 py-1 rounded-full bg-white/15 backdrop-blur-md border border-white/20">
          <svg class="w-3.5 h-3.5 text-peacock-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Featured Roadmap • 100% Free</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
          DSA se Placement tak: 6-mahine ka complete roadmap
        </h2>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl">
          College campus aur off-campus hiring ke liye phase-by-phase timeline, interactive checklist progress (safely saved in browser), aur chune hue free video/doc resources.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={`${base}/roadmaps/dsa-placement/`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-brand-950 font-bold text-xs sm:text-sm hover:bg-slate-100 transition-all shadow-md hover:scale-[1.02] active:scale-95"
          >
            <span>Roadmap shuru karo</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a
            href={`${base}/roadmaps/ai-ml-engineer/`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/20 text-white font-bold text-xs sm:text-sm transition-all hover:scale-[1.02] active:scale-95"
          >
            <span>AI/ML Roadmap dekho</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Interactive Preview Box (5 cols) -->
      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/15 space-y-3">
        <div class="flex items-center justify-between text-xs pb-3 border-b border-white/10">
          <span class="font-bold text-slate-200">Interactive Checklist Demo</span>
          <span class="text-[10px] text-peacock-300 font-mono bg-peacock-500/20 px-2 py-0.5 rounded-full border border-peacock-500/30">
            Phase 1 of 4
          </span>
        </div>

        <div class="space-y-2.5 text-xs text-slate-200">
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/10">
            <span class="w-4 h-4 rounded-full bg-peacock-400 flex items-center justify-center text-brand-950 font-bold text-[9px]">✓</span>
            <span class="font-medium">Time & Space Complexity Basics</span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/10">
            <span class="w-4 h-4 rounded-full bg-peacock-400 flex items-center justify-center text-brand-950 font-bold text-[9px]">✓</span>
            <span class="font-medium">Two Pointers & Sliding Window</span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-brand-500/30 border border-brand-400/40">
            <span class="w-4 h-4 rounded-full bg-white text-brand-950 flex items-center justify-center font-bold text-[9px] animate-pulse">●</span>
            <span class="font-bold text-white">Binary Trees & DFS/BFS Traversal</span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-xl bg-white/5 opacity-70">
            <span class="w-4 h-4 rounded-full border border-white/40"></span>
            <span class="font-medium">Dynamic Programming & Graphs</span>
          </div>
        </div>

        <div class="pt-2 text-[11px] text-slate-300 text-center flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-peacock-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Progress pure browser ke local storage mein safe rehti hai</span>
        </div>
      </div>

    </div>
  </div>
</section>
