---
import IndianPattern from '../ui/IndianPattern.astro';
import { BRAND } from '../../config/brand';
import { t, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

const quickTopics = [
  {
    label: isHindi ? 'RAG आर्किटेक्चर' : 'RAG Architecture',
    href: `${base}/${locale}/topics/ai-agents-and-rag/`,
    iconSvg: `<svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`
  },
  {
    label: isHindi ? 'DSA 6-महीने का प्लान' : 'DSA 6-Month Plan',
    href: `${base}/${locale}/roadmaps/dsa-placement/`,
    iconSvg: `<svg class="w-3.5 h-3.5 text-peacock-600 dark:text-peacock-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>
    </svg>`
  },
  {
    label: isHindi ? 'क्यूबिट और क्वांटम' : 'Quantum Qubits',
    href: `${base}/${locale}/topics/qubits-superposition-entanglement/`,
    iconSvg: `<svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(45 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-45 12 12)"/><circle cx="12" cy="12" r="2"/></svg>`
  },
  {
    label: isHindi ? 'संविधान की बुनियाद' : 'Constitution Basics',
    href: `${base}/${locale}/topics/indian-constitution-structure/`,
    iconSvg: `<svg class="w-3.5 h-3.5 text-saffron-600 dark:text-saffron-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
];
---

<section class="relative pt-8 pb-10 sm:pt-12 sm:pb-14 overflow-hidden border-b border-slate-200/80 dark:border-white/10">
  <!-- Subtle Colorful Mesh Gradient (Peach, Coral to Electric Indigo) -->
  <div class="absolute inset-0 bg-gradient-to-tr from-peach-500/[0.06] via-transparent to-brand-500/[0.04] dark:from-peach-500/[0.07] dark:via-darkbg dark:to-brand-500/[0.05] pointer-events-none"></div>
  
  <!-- 21st.dev / Magic UI Ambient Glow Depth -->
  <div id="hero-ambient-glow" class="pointer-events-none absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[320px] bg-gradient-to-tr from-peach-500/10 via-violet-500/10 to-pink-500/10 dark:from-peach-500/15 dark:via-violet-600/15 dark:to-pink-500/10 rounded-full blur-3xl opacity-75"></div>
  
  <!-- Extremely Light Masked Jaali Pattern (Text Area is 100% Clean) -->
  <IndianPattern variant="jaali" masked={true} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column (55%): Headings, Search, Solid Quick Chips -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Trust Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-darkcard border border-peach-500/25 text-peach-800 dark:text-peach-300 text-xs font-semibold shadow-xs mb-4">
          <svg class="w-3.5 h-3.5 text-peacock-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
          <span>{t(locale, 'hero.trustPill')}</span>
          <span class="text-slate-300 dark:text-slate-600">•</span>
          <span class="text-slate-500 dark:text-slate-400 font-medium">{t(locale, 'hero.noLogin')}</span>
        </div>

        <!-- H1 Headline (100% Plain Static Text, Peach Underline, Never Cut Off) -->
        <h1 id="hero-h1" class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-black text-slate-900 dark:text-white tracking-[-0.02em] leading-[1.08] mb-4 [text-wrap:balance]">
          {isHindi ? (
            <span class="font-hindi">
              सीखो वही जो{' '}
              <span class="relative inline-block text-slate-900 dark:text-white">
                सच में काम आए
                <svg class="absolute -bottom-1 sm:-bottom-1.5 left-0 w-full h-3 text-peach-500 overflow-visible pointer-events-none" viewBox="0 0 100 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2 9C25 3 75 3 98 8" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                </svg>
              </span>
              ।
            </span>
          ) : (
            <span>
              Learn what{' '}
              <span class="relative inline-block text-slate-900 dark:text-white">
                truly matters
                <svg class="absolute -bottom-1 sm:-bottom-1.5 left-0 w-full h-3 text-peach-500 overflow-visible pointer-events-none" viewBox="0 0 100 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2 9C25 3 75 3 98 8" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                </svg>
              </span>
              {' '}in tech.
            </span>
          )}
        </h1>

        <!-- Human, Benefit-First Subtext (Max 2 lines, High Contrast >= 4.5:1) -->
        <p id="hero-subtext" class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-6 max-w-xl">
          {t(locale, 'hero.subtext')}
        </p>

        <!-- Primary Bada Search Bar (60px height, Glass, OS-aware) -->
        <div class="w-full max-w-xl mb-4">
          <button
            type="button"
            id="hero-primary-search"
            onclick="document.getElementById('open-search-btn')?.click()"
            class="w-full flex items-center justify-between px-4 sm:px-5 py-4 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/15 shadow-apple-md hover:shadow-apple-lg hover:border-brand-500/60 dark:hover:border-brand-400/60 transition-all text-slate-400 cursor-pointer text-left group active:scale-[0.99]"
            aria-label={t(locale, 'hero.searchPlaceholder')}
          >
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-brand-50 dark:bg-brand-950/70 flex items-center justify-center text-brand-600 dark:text-brand-400 group-hover:scale-105 transition-transform">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.35-4.35"/>
                </svg>
              </div>
              <span class="text-slate-500 dark:text-slate-400 font-medium text-xs sm:text-sm line-clamp-1">
                {t(locale, 'hero.searchPlaceholder')}
              </span>
            </div>
            <kbd class="os-shortcut-hint hidden sm:inline-flex items-center gap-1 font-mono text-[11px] font-bold px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 shadow-xs">
              ⌘K
            </kbd>
          </button>
        </div>

        <!-- Solid Quick Topics & Design Studio Shimmer CTA -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="font-semibold text-slate-600 dark:text-slate-300">{t(locale, 'hero.quickTopicsLabel')}</span>
            {quickTopics.map(topic => (
              <a
                href={topic.href}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-200 font-medium hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-300 transition-all shadow-xs hover:shadow-apple-sm active:scale-95"
              >
                <span set:html={topic.iconSvg} />
                <span>{topic.label}</span>
              </a>
            ))}
          </div>

          <!-- 21st.dev & Magic UI Shimmer Action Button -->
          <div class="flex items-center gap-3 pt-1">
            <a
              id="hero-studios-cta"
              href={`${base}/${locale}/topics/ai-ui-prompting-engineering/#shadcn-registry-studio`}
              class="relative group overflow-hidden inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 text-xs font-bold shadow-md hover:shadow-lg hover:scale-105 active:scale-95 transition-all"
            >
              <span class="absolute inset-0 -translate-x-full group-hover:translate-x-full duration-1000 bg-gradient-to-r from-transparent via-white/25 dark:via-black/15 to-transparent transition-transform ease-out pointer-events-none"></span>
              <svg class="w-3.5 h-3.5 text-peach-400 dark:text-peach-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span>{isHindi ? 'डिज़ाइन इंजीनियरिंग स्टूडियो (shadcn + 21st.dev)' : 'Explore Design Engineering Studios (shadcn + 21st.dev)'}</span>
              <span class="text-xs">&rarr;</span>
            </a>
            <span class="text-[11px] font-mono text-slate-400 hidden sm:inline">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-[10px]">⌘K</kbd> to search</span>
          </div>
        </div>

      </div>

      <!-- Right Column (45%): Layered Preview Collage (Layered Overlap, 2-4° Angle, Stepper Chips) -->
      <div class="lg:col-span-5 relative mt-6 lg:mt-0">
        <!-- Soft Ambient Radial Glow Behind Collage -->
        <div class="absolute -inset-4 bg-gradient-to-tr from-brand-500/15 via-peacock-500/10 to-saffron-500/15 rounded-3xl blur-2xl pointer-events-none"></div>

        <div class="relative space-y-3.5 max-w-md mx-auto lg:max-w-none">
          
          <!-- Layer 1: Code / Architecture Snippet (Top Card, Subtle Rotate 1.5°) -->
          <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-900 text-slate-200 border border-slate-800 shadow-apple-md font-mono text-[11px] transform rotate-1 transition-transform hover:rotate-0">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-[10px] text-slate-400">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span class="ml-2 font-mono text-slate-300 font-medium">rag_pipeline.py</span>
              </div>
              <span class="text-[9px] text-brand-300 font-semibold px-1.5 py-0.5 rounded bg-brand-950/80 border border-brand-500/30">Python 3.11</span>
            </div>
            <div class="space-y-1 text-slate-300">
              <div><span class="text-purple-400 font-semibold">chunks</span> = retriever.search(query, k=3)</div>
              <div><span class="text-purple-400 font-semibold">answer</span> = llm.generate(prompt=query, context=chunks)</div>
            </div>
          </div>

          <!-- Layer 2: Mini Roadmap Card with 64px Progress Ring & Stepper Chips (Main Anchor) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-apple-lg transition-transform relative z-10">
            <div class="flex items-center justify-between mb-3.5">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-peacock-50 dark:bg-peacock-950/70 flex items-center justify-center text-peacock-600 dark:text-peacock-400 shadow-xs">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-tight">
                    {isHindi ? 'DSA से प्लेसमेंट रोडमैप' : 'DSA to Tech Placement'}
                  </h4>
                  <span class="text-[10px] text-slate-500 dark:text-slate-400">
                    {isHindi ? 'फ़ेज़ 2: ट्रीज़ और ग्राफ़्स' : 'Phase 2: Trees & Graphs'}
                  </span>
                </div>
              </div>
              
              <!-- 64px Crisp SVG Progress Ring (68%) -->
              <div class="relative w-12 h-12 flex items-center justify-center">
                <svg class="w-12 h-12 transform -rotate-90" viewBox="0 0 36 36">
                  <path class="text-slate-100 dark:text-slate-800" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                  <path class="text-peacock-500" stroke-dasharray="68, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                </svg>
                <span class="absolute text-[11px] font-black text-slate-800 dark:text-slate-100 font-mono">68%</span>
              </div>
            </div>

            <!-- Stepper Progress Chips: Done / Active / Next -->
            <div class="grid grid-cols-3 gap-2 text-[10px]">
              <div class="p-2 rounded-xl bg-peacock-50/80 dark:bg-peacock-950/50 border border-peacock-500/25 text-slate-800 dark:text-slate-200">
                <span class="text-[9px] font-bold text-peacock-600 dark:text-peacock-400 block mb-0.5">
                  {isHindi ? '✓ पूर्ण' : '✓ Done'}
                </span>
                <span class="font-medium truncate block">Arrays & Strings</span>
              </div>
              <div class="p-2 rounded-xl bg-brand-50/80 dark:bg-brand-950/60 border border-brand-500/40 text-brand-950 dark:text-white ring-1 ring-brand-500/20">
                <span class="text-[9px] font-bold text-brand-600 dark:text-brand-400 block mb-0.5">
                  {isHindi ? '● सक्रिय' : '● Active'}
                </span>
                <span class="font-bold truncate block">Trees & Graphs</span>
              </div>
              <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 text-slate-500 dark:text-slate-400">
                <span class="text-[9px] font-medium block mb-0.5">
                  {isHindi ? '○ अगला' : '○ Next'}
                </span>
                <span class="font-medium truncate block">System Design</span>
              </div>
            </div>
          </div>

          <!-- Layer 3: Mini Topic Card with Verified HIGH Badge (Subtle Rotate -1.5°) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-apple-md transform -rotate-1 transition-transform hover:rotate-0">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-brand-50 dark:bg-brand-950/70 text-brand-600 dark:text-brand-300 border border-brand-500/20">
                {isHindi ? 'AI और सिस्टम्स' : 'AI & Systems'}
              </span>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded-md border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                {isHindi ? 'जाँचा हुआ · उच्च' : 'Verified · HIGH'}
              </span>
            </div>
            
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white mb-1">
              {isHindi ? 'AI एजेंट्स और RAG आर्किटेक्चर' : 'AI Agents & RAG Architecture'}
            </h4>
            
            <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-2">
              {isHindi 
                ? 'वेक्टर सिमिलैरिटी सर्च से प्राइवेट नॉलेज बेस को बिना मॉडल फ़ाइन-ट्यूनिंग के सटीक उत्तर प्राप्त करें।'
                : 'Query private knowledge bases accurately using vector similarity retrieval without model fine-tuning.'}
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
