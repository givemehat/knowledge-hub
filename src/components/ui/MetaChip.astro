---
interface Props {
  label: string;
  value: string;
  icon?: 'signal' | 'shield' | 'clock' | 'sparkles' | 'book';
  variant?: 'default' | 'success' | 'warning' | 'info' | 'evolving';
}

const { label, value, icon = 'signal', variant = 'default' } = Astro.props;

const variantStyles = {
  default: 'bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-200 border-slate-200/80 dark:border-slate-700/60',
  success: 'bg-teal-50 dark:bg-teal-950/40 text-teal-700 dark:text-teal-300 border-teal-200 dark:border-teal-800/40',
  warning: 'bg-saffron-50 dark:bg-saffron-950/40 text-saffron-600 dark:text-saffron-400 border-saffron-200 dark:border-saffron-800/40',
  info: 'bg-violet-50 dark:bg-violet-950/40 text-violet-700 dark:text-violet-300 border-violet-200 dark:border-violet-800/40',
  evolving: 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800/40'
};
---

<div class={`inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl border text-xs font-medium transition-colors shadow-apple-sm ${variantStyles[variant]}`}>
  <!-- Lucide Style SVG Icons -->
  {icon === 'signal' && (
    <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 20h.01M7 20v-4M12 20v-8M17 20V4" />
    </svg>
  )}
  {icon === 'clock' && (
    <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <circle cx="12" cy="12" r="10" stroke-width="2"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"/>
    </svg>
  )}
  {icon === 'shield' && (
    <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>
  )}
  {icon === 'sparkles' && (
    <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
    </svg>
  )}

  <div class="flex items-center gap-1.5 leading-none">
    <span class="text-[10px] uppercase font-mono tracking-wider opacity-60 font-semibold">{label}:</span>
    <span class="font-bold tracking-tight">{value}</span>
  </div>
</div>
