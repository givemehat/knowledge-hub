---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item, index) => (
    <details class="group rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder shadow-apple-sm transition-all duration-200 overflow-hidden">
      <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer font-bold text-sm sm:text-base text-slate-900 dark:text-white select-none hover:text-violet-600 dark:hover:text-violet-400 transition-colors list-none">
        <span class="flex items-center gap-3 pr-4">
          <span class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 text-xs font-mono flex items-center justify-center shrink-0">
            {index + 1}
          </span>
          <span>{item.question}</span>
        </span>
        <!-- Lucide ChevronDown with rotation -->
        <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/30">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
