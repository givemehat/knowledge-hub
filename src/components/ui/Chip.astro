---
interface Props {
  variant?: 'neutral' | 'language' | 'free' | 'status' | 'level' | 'phase' | 'category';
  size?: 'sm' | 'md';
  level?: 'beginner' | 'intermediate' | 'advanced' | string;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'neutral',
  size = 'sm',
  level,
  class: className = '',
  ...rest
} = Astro.props;

const sizeStyles = {
  sm: 'text-[10px] px-2 py-0.5 rounded-full',
  md: 'text-xs px-2.5 py-1 rounded-full'
};

const getVariantStyle = () => {
  if (variant === 'level') {
    if (level === 'beginner') {
      return 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 font-semibold';
    }
    if (level === 'intermediate') {
      return 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 font-semibold';
    }
    if (level === 'advanced') {
      return 'bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20 font-semibold';
    }
    return 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-white/10 font-semibold';
  }

  const styles: Record<string, string> = {
    neutral: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/70 dark:border-white/10 font-bold uppercase tracking-wider',
    language: 'bg-peacock-500/10 text-peacock-700 dark:text-peacock-300 border border-peacock-500/20 font-semibold',
    free: 'bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20 font-bold',
    status: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 font-semibold',
    phase: 'bg-saffron-500/10 text-saffron-700 dark:text-saffron-300 border border-saffron-500/20 font-bold font-mono',
    category: 'bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 font-bold'
  };

  return styles[variant] || styles.neutral;
};
---

<span
  class={`inline-flex items-center gap-1.5 leading-none transition-colors select-none ${sizeStyles[size]} ${getVariantStyle()} ${className}`}
  data-component="chip"
  data-variant={variant}
  {...rest}
>
  <slot />
</span>
