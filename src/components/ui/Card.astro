---
interface Props {
  variant?: 'default' | 'dashed' | 'elevated';
  as?: 'div' | 'article' | 'li' | 'section';
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'default',
  as: Tag = 'div',
  class: className = '',
  id,
  ...rest
} = Astro.props;

const baseStyles = 'group relative rounded-2xl sm:rounded-3xl transition-all duration-200 flex flex-col justify-between h-full p-5 sm:p-6';

const variantStyles = {
  default: 'bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 hover:shadow-apple-sm hover:-translate-y-0.5',
  dashed: 'bg-slate-50/60 dark:bg-darkcard/40 border-2 border-dashed border-slate-300/80 dark:border-slate-700/80 hover:border-slate-400 dark:hover:border-slate-600',
  elevated: 'bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 shadow-apple-sm hover:shadow-apple-md hover:-translate-y-1'
};
---

<Tag
  id={id}
  class={`${baseStyles} ${variantStyles[variant]} ${className}`}
  data-component="card"
  {...rest}
>
  <slot />
</Tag>
