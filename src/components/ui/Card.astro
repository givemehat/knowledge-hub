---
interface Props {
  variant?: 'default' | 'dashed' | 'elevated';
  as?: 'div' | 'article' | 'li' | 'section';
  class?: string;
  id?: string;
  enableGlow?: boolean;
  [key: string]: any;
}

const {
  variant = 'default',
  as: Tag = 'div',
  class: className = '',
  id,
  enableGlow = true,
  ...rest
} = Astro.props;

const baseStyles = 'group relative rounded-2xl sm:rounded-3xl transition-all duration-300 ease-out flex flex-col justify-between h-full p-5 sm:p-6 overflow-hidden';

const variantStyles = {
  default: 'bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/25 shadow-[0_1px_3px_rgba(0,0,0,0.04),0_1px_2px_rgba(0,0,0,0.02)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.07)] hover:shadow-apple-md hover:-translate-y-0.5',
  dashed: 'bg-slate-50/60 dark:bg-darkcard/40 border-2 border-dashed border-slate-300/80 dark:border-slate-700/80 hover:border-slate-400 dark:hover:border-slate-600',
  elevated: 'bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 shadow-apple-sm dark:shadow-[0_4px_16px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.08)] hover:shadow-apple-lg hover:-translate-y-1'
};
---

<Tag
  id={id}
  class={`${baseStyles} ${variantStyles[variant]} ${className}`}
  data-component="card"
  {...rest}
>
  {enableGlow && (
    <div
      class="card-ambient-glow pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-[inherit]"
      style="background: radial-gradient(380px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 122, 89, 0.08), rgba(91, 61, 245, 0.03), transparent 75%);"
      aria-hidden="true"
    />
  )}
  <slot />
</Tag>
