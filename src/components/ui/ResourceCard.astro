---
interface Props {
  type: 'video' | 'doc' | 'book' | 'tool' | 'course';
  title: string;
  url: string;
  author: string;
  language: 'hi' | 'en';
  duration?: string;
  free: boolean;
  whyWatch: string;
}

const { type, title, url, author, language, duration, free, whyWatch } = Astro.props;

const typeIcons = {
  video: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  doc: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  book: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  tool: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  course: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
};
---

<div class="p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder shadow-apple-sm hover:shadow-apple-md hover:border-violet-500/60 transition-all flex flex-col justify-between group space-y-4">
  <div class="space-y-3">
    <!-- Top Row: Badges & Chips -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-1.5">
        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
          <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={typeIcons[type] || typeIcons.doc} />
          </svg>
          {type}
        </span>

        <span class={`text-[10px] font-bold px-2 py-0.5 rounded ${
          language === 'hi' 
            ? 'bg-saffron-50 text-saffron-600 dark:bg-saffron-950/60 dark:text-saffron-400 border border-saffron-200/50' 
            : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
        }`}>
          {language === 'hi' ? 'हिन्दी' : 'English'}
        </span>
      </div>

      <div class="flex items-center gap-2">
        {duration && (
          <span class="text-[11px] font-mono text-slate-400">
            {duration}
          </span>
        )}
        {free && (
          <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-peacock-50 dark:bg-peacock-950/60 text-peacock-600 dark:text-peacock-400 border border-peacock-200/50">
            100% Free
          </span>
        )}
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug line-clamp-2">
      {title}
    </h3>

    <!-- Editorial Takeaway Note -->
    {whyWatch && (
      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800 flex items-start gap-1.5">
        <svg class="w-3.5 h-3.5 text-brand-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span><strong class="text-brand-600 dark:text-brand-400">काम की बात:</strong> {whyWatch}</span>
      </p>
    )}
  </div>

  <!-- Bottom Strip: Author + Single Clean Action CTA -->
  <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
    <span class="text-xs text-slate-500 truncate max-w-[160px]">
      By <strong class="text-slate-700 dark:text-slate-300">{author}</strong>
    </span>

    <a 
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-violet-50 hover:bg-violet-600 dark:bg-violet-950/60 dark:hover:bg-violet-600 text-violet-700 hover:text-white dark:text-violet-300 dark:hover:text-white border border-violet-200 dark:border-violet-800/60 transition-all text-xs font-bold shrink-0 shadow-sm"
      aria-label={`Open external resource: ${title}`}
    >
      <span>Resource Kholo</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
