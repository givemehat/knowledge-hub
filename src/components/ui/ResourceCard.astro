---
import Card from './Card.astro';
import Chip from './Chip.astro';
import InsetPanel from './InsetPanel.astro';
import CardFooter from './CardFooter.astro';
import Button from './Button.astro';
import IconTile from '../domains/IconTile.astro';

interface Props {
  type: 'video' | 'doc' | 'book' | 'tool' | 'course';
  title: string;
  url: string;
  author: string;
  language: 'hi' | 'en';
  duration?: string;
  free: boolean;
  whyWatch: string;
  whyWatchHi?: string;
  videoId?: string;
  lastVerified?: string;
  locale?: 'hi' | 'en';
  class?: string;
}

const {
  type,
  title,
  url,
  author,
  language,
  duration,
  free,
  whyWatch,
  whyWatchHi,
  videoId,
  lastVerified = '2026-11-05',
  locale = 'hi',
  class: className = ''
} = Astro.props;

const isHindi = locale === 'hi';

const typeLabels: Record<string, { hi: string; en: string }> = {
  video: { hi: 'वीडियो', en: 'Video' },
  doc: { hi: 'दस्तावेज़', en: 'Doc' },
  book: { hi: 'पुस्तक', en: 'Book' },
  tool: { hi: 'टूल', en: 'Tool' },
  course: { hi: 'कोर्स', en: 'Course' }
};

const displayType = isHindi ? (typeLabels[type]?.hi || type) : (typeLabels[type]?.en || type);
const displayWhyWatch = (isHindi && whyWatchHi) ? whyWatchHi : whyWatch;
const recommendLabel = isHindi ? 'हम इसे क्यों सुझाते हैं' : 'Why We Recommend';
const openLabel = isHindi ? 'खोलें' : 'Open';
const verifiedLabel = isHindi ? 'जाँचा गया' : 'Verified';
---

<Card class={`resource-card ${className}`} data-resource-type={type} data-resource-lang={language}>
  <div>
    <!-- Row 1: Chip Header (Type on Left, Language & Free on Right) -->
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <Chip variant="neutral" size="sm">
        {displayType}
      </Chip>

      <div class="flex items-center gap-1.5">
        <Chip variant="language" size="sm" lang={language === 'hi' && isHindi ? 'hi' : undefined}>
          {language === 'hi' ? (isHindi ? 'हिन्दी' : 'Hindi') : 'English'}
        </Chip>
        {free && (
          <Chip variant="free" size="sm">
            {isHindi ? 'मुफ़्त' : 'Free'}
          </Chip>
        )}
      </div>
    </div>

    <!-- Row 2: Media Thumbnail for Video, or Clean Category Icon for Non-Video -->
    {videoId ? (
      <div class="relative aspect-video w-full rounded-xl overflow-hidden mb-3.5 bg-slate-900 group/thumb">
        <img
          src={`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`}
          alt={`Thumbnail: ${title}`}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-300"
        />
        <!-- Play Overlay -->
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute inset-0 bg-slate-900/30 hover:bg-slate-900/10 flex items-center justify-center transition-colors cursor-pointer"
          aria-label={`Watch video: ${title}`}
        >
          <div class="w-10 h-10 rounded-full bg-white/90 dark:bg-slate-900/90 text-slate-900 dark:text-white flex items-center justify-center shadow-apple-md group-hover/thumb:scale-110 transition-transform">
            <svg class="w-4 h-4 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </a>
        {duration && (
          <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md bg-black/80 text-white text-[10px] font-mono font-bold">
            {duration}
          </span>
        )}
      </div>
    ) : null}

    <!-- Row 3: Title -->
    <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug line-clamp-2 mb-3">
      <a href={url} target="_blank" rel="noopener noreferrer" class="hover:underline">
        {title}
      </a>
    </h3>

    <!-- Row 4: Signature InsetPanel (Why We Recommend) -->
    <InsetPanel variant="recommend" label={recommendLabel} class="mb-4">
      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        {displayWhyWatch}
      </p>
    </InsetPanel>
  </div>

  <!-- Row 5: Pinned Footer -->
  <CardFooter>
    <div slot="meta" class="flex flex-col text-[11px] text-slate-400 dark:text-slate-500 leading-tight">
      <span class="truncate max-w-[140px] text-slate-600 dark:text-slate-300 font-medium">By {author}</span>
      <span class="text-[10px] font-mono">{verifiedLabel}: {lastVerified}</span>
    </div>

    <div slot="action" class="flex items-center gap-1.5">
      <!-- Report broken link ghost icon button -->
      <a
        href={`https://github.com/givemehat/knowledge-hub/issues/new?title=Broken+Link+Report:+${encodeURIComponent(title)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        title="Report broken link"
        aria-label="Report broken link"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </a>

      <!-- Primary Dark Pill Action Button -->
      <Button
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="sm"
        icon="external"
      >
        <span>{openLabel}</span>
      </Button>
    </div>
  </CardFooter>
</Card>
