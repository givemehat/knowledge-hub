---
interface Props {
  variant?: 'jaali' | 'rangoli-dots';
  className?: string;
  masked?: boolean;
}

const { variant = 'jaali', className = '', masked = true } = Astro.props;
const patternId = `pat-${variant}-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`absolute inset-0 pointer-events-none overflow-hidden ${className}`}>
  {variant === 'jaali' && (
    <svg
      class="w-full h-full text-brand-600/5 dark:text-white/[0.065]"
      style={masked ? 'mask-image: radial-gradient(circle at 85% 20%, black 15%, transparent 70%); -webkit-mask-image: radial-gradient(circle at 85% 20%, black 15%, transparent 70%);' : ''}
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern id={patternId} width="64" height="64" patternUnits="userSpaceOnUse">
          <!-- 1px Clean Vector Lattice without Heavy Filled Circles -->
          <path
            d="M32 0 L64 32 L32 64 L0 32 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          />
          <path
            d="M0 0 L16 16 M48 16 L64 0 M48 48 L64 64 M0 64 L16 48"
            stroke="currentColor"
            stroke-width="0.8"
          />
          <circle
            cx="32"
            cy="32"
            r="2"
            fill="none"
            stroke="currentColor"
            stroke-width="0.8"
          />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${patternId})`} />
    </svg>
  )}

  {variant === 'rangoli-dots' && (
    <svg
      class="w-full h-full text-brand-600/5 dark:text-white/[0.05]"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern id={patternId} width="48" height="48" patternUnits="userSpaceOnUse">
          <circle cx="24" cy="24" r="1" fill="currentColor" />
          <circle cx="0" cy="0" r="0.75" fill="currentColor" />
          <circle cx="48" cy="0" r="0.75" fill="currentColor" />
          <circle cx="0" cy="48" r="0.75" fill="currentColor" />
          <circle cx="48" cy="48" r="0.75" fill="currentColor" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${patternId})`} />
    </svg>
  )}
</div>
