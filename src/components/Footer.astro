---
import IndianPattern from './ui/IndianPattern.astro';
import { CREATOR } from '../data/creator';
import { BRAND } from '../config/brand';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';
---

<footer class="relative mt-24 border-t border-slate-200/80 dark:border-white/10 bg-surface-light dark:bg-surface-dark text-slate-600 dark:text-slate-400 text-xs overflow-hidden">
  <!-- Subtle decorative Rangoli background texture -->
  <IndianPattern variant="rangoli" opacity={0.03} />

  <!-- Tricolor Micro Top Border -->
  <div class="h-0.5 w-full bg-gradient-to-r from-peach-500 via-peacock-500 to-brand-500 opacity-60"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 mb-12">
      <!-- Col 1 & 2: Brand, Creator & Mission -->
      <div class="md:col-span-2 space-y-4">
        <a href={`${base}/${locale}/`} class="inline-flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-peach-500 via-coral-500 to-brand-500 p-0.5 shadow-md shadow-peach-500/20 group-hover:scale-105 transition-transform flex items-center justify-center shrink-0">
            <svg class="w-full h-full" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="peach-footer-logo-grad" x1="8" y1="6" x2="28" y2="31" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFB396"/>
                  <stop offset="45%" stop-color="#FF7A59"/>
                  <stop offset="100%" stop-color="#DE4321"/>
                </linearGradient>
                <linearGradient id="peach-footer-leaf-grad" x1="18" y1="3" x2="28" y2="9" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#10B981"/>
                  <stop offset="60%" stop-color="#0E8A8A"/>
                  <stop offset="100%" stop-color="#5B3DF5"/>
                </linearGradient>
              </defs>
              <path d="M 17.5 8.5 C 19 3.5 25.5 3 28 5 C 28 8.5 23 10.5 17.5 8.5 Z" fill="url(#peach-footer-leaf-grad)"/>
              <path d="M 18.5 8.2 C 21.5 6 25 5.5 27 5.2" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" opacity="0.8"/>
              <path d="M 18 9.5 C 13.5 6 6 10 6 18 C 6 25.5 12 30.5 18 30.5 C 24 30.5 30 25.5 30 18 C 30 10 22.5 6 18 9.5 Z" fill="url(#peach-footer-logo-grad)"/>
              <path d="M 18 9.5 C 18 14 16.8 17 16.8 20" stroke="#FFFFFF" stroke-width="1.3" stroke-linecap="round" opacity="0.45"/>
              <circle cx="18" cy="22" r="1.5" fill="#FFFFFF" opacity="0.95"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5">
              {BRAND.name} <span lang="hi" class="text-peach-600 dark:text-peach-400 font-hindi">{BRAND.nameHi}</span>
            </span>
            <span class="text-[10px] text-slate-400 font-medium">
              {isHindi ? 'सत्यापित ज्ञान इंजन' : 'Verified Knowledge Engine'}
            </span>
          </div>
        </a>

        <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed max-w-sm">
          {isHindi 
            ? 'भारतीय कॉलेज छात्रों, डेवलपर्स और जिज्ञासु पाठकों के लिए निर्मित एक उच्च-गति, विज्ञापन-मुक्त ज्ञान इंजन। प्राथमिक स्रोत और पूर्णतः मुफ़्त।'
            : 'A high-velocity, zero-distraction knowledge engine built for Indian college students, developers, and curious minds. Primary sources, zero trackers, and ad-free forever.'}
        </p>

        <!-- Builder Credit Badge -->
        <div class="pt-1 flex items-center gap-2">
          <a
            href={`${base}/${locale}/about/`}
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 hover:border-brand-500/40 text-xs transition-colors shadow-xs"
          >
            <div class="w-5 h-5 rounded-full bg-brand-600 text-white font-bold text-[10px] flex items-center justify-center">
              {CREATOR.name.split(' ').map(n => n[0]).join('')}
            </div>
            <span class="text-slate-700 dark:text-slate-300">
              {isHindi ? 'निर्माता:' : 'Built by'} <strong class="text-slate-900 dark:text-white">{CREATOR.name}</strong>
            </span>
          </a>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com/givemehat/knowledge-hub"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 dark:bg-slate-800 text-white font-medium hover:bg-slate-800 dark:hover:bg-slate-700 transition-all text-xs shadow-xs hover:scale-[1.02]"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>

          <a
            href={`${base}/${locale}/design-system/`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 font-medium hover:border-brand-500/50 transition-all text-xs"
          >
            <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
            <span>{isHindi ? 'डिज़ाइन सिस्टम' : 'Design Tokens'}</span>
          </a>
        </div>
      </div>

      <!-- Col 3: Knowledge Library -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
          {isHindi ? 'ज्ञान भंडार' : 'Knowledge'}
        </h4>
        <ul class="space-y-2.5">
          <li><a href={`${base}/${locale}/topics/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'विषय गाइड्स (19+)' : 'Topic Guides (19+)'}</a></li>
          <li><a href={`${base}/${locale}/roadmaps/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'कैरियर रोडमैप्स' : 'Career Roadmaps'}</a></li>
          <li><a href={`${base}/${locale}/resources/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'मुफ़्त संसाधन' : 'Curated Resources'}</a></li>
          <li><a href={`${base}/${locale}/updates/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'नए अपडेट्स' : 'Recent Updates'}</a></li>
        </ul>
      </div>

      <!-- Col 4: Research & Deep Dives -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-saffron-500"></span>
          {isHindi ? 'शोध केंद्र' : 'Research Lab'}
        </h4>
        <ul class="space-y-2.5">
          <li><a href={`${base}/${locale}/scenarios/`} class="hover:text-saffron-600 dark:hover:text-saffron-400 transition-colors">{isHindi ? 'काल्पनिक परिदृश्य' : 'Hypothetical Scenarios'}</a></li>
          <li><a href={`${base}/${locale}/research/media-sentiment-study/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'मीडिया सेंटिमेंट (38.4 लाख)' : 'Media Sentiment (3.8M)'}</a></li>
          <li><a href={`${base}/${locale}/research/fact-vs-hypothesis/`} class="hover:text-saffron-600 dark:hover:text-saffron-400 transition-colors">{isHindi ? 'तथ्य बनाम परिकल्पना नियम' : 'Fact vs Hypothesis Protocol'}</a></li>
          <li><a href={`${base}/${locale}/research/data-cards/`} class="hover:text-brand-500 transition-colors">{isHindi ? 'Kaggle डेटा कार्ड्स' : 'Kaggle Data Cards'}</a></li>
        </ul>
      </div>

      <!-- Col 5: Creator, Contact & Trust -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-peacock-500"></span>
          {isHindi ? 'संवाद और विश्वास' : 'Connect & Trust'}
        </h4>
        <ul class="space-y-2.5">
          <li><a href={`${base}/${locale}/about/`} class="hover:text-peacock-600 dark:hover:text-peacock-400 transition-colors font-medium">{isHindi ? 'निर्माता परिचय' : 'About & Creator Story'}</a></li>
          <li><a href={`${base}/${locale}/contact/`} class="hover:text-peacock-600 dark:hover:text-peacock-400 transition-colors font-medium">{isHindi ? 'संपर्क करें' : 'Contact & Collaborate'}</a></li>
          <li><a href={`${base}/${locale}/sources-policy/`} class="hover:text-peacock-600 dark:hover:text-peacock-400 transition-colors">{isHindi ? 'स्रोत और तथ्य-जाँच' : 'Sources & Fact-Checking'}</a></li>
          <li><a href={`${base}/humans.txt`} target="_blank" class="hover:text-peacock-600 dark:hover:text-peacock-400 transition-colors">humans.txt</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="pt-8 border-t border-slate-200/80 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 dark:text-slate-400 text-[11px]">
      <p class="flex items-center gap-2 flex-wrap">
        <span>{isHindi ? 'भारत में सप्रेम निर्मित —' : 'Made with'}</span>
        <svg class="w-3.5 h-3.5 text-rose-500 inline fill-rose-500" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span>{isHindi ? 'द्वारा' : 'in India by'} <a href={`${base}/${locale}/about/`} class="text-slate-800 dark:text-slate-200 font-bold hover:underline">{CREATOR.name}</a>.</span>
        <span>•</span>
        <span>{isHindi ? 'लाइसेंस:' : 'Licensed under'} <strong class="text-slate-700 dark:text-slate-200">CC BY-SA 4.0</strong>.</span>
      </p>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1 text-peacock-600 dark:text-peacock-400">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          {isHindi ? 'कोई विज्ञापन नहीं, कोई ट्रैकर नहीं' : 'No Ads, No Trackers'}
        </span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span class="text-slate-400">
          {isHindi ? 'उच्च गति और सुलभ' : 'High-Performance & Accessible'}
        </span>
      </div>
    </div>
  </div>
</footer>
