---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-24 border-t border-slate-200 dark:border-darkborder bg-slate-50 dark:bg-darkcard/50 text-slate-600 dark:text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: About -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-emerald-500 flex items-center justify-center text-white font-bold text-xs">
            K
          </div>
          <span class="font-bold text-sm text-slate-900 dark:text-white">KnowledgeHub</span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">
          The modern Wikipedia for college students, developers, and curious readers. 100% free, static, open-source, and ad-free.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider">Explore</h4>
        <ul class="space-y-2">
          <li><a href={`${base}/topics/`} class="hover:text-emerald-500 transition-colors">All Topics</a></li>
          <li><a href={`${base}/roadmaps/`} class="hover:text-emerald-500 transition-colors">Career Roadmaps</a></li>
          <li><a href={`${base}/resources/`} class="hover:text-emerald-500 transition-colors">Curated Resources</a></li>
          <li><a href={`${base}/updates/`} class="hover:text-emerald-500 transition-colors">Changelog & Updates</a></li>
        </ul>
      </div>

      <!-- Col 3: Editorial & Sourcing -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider">Trust & Policy</h4>
        <ul class="space-y-2">
          <li><a href={`${base}/sources-policy/`} class="hover:text-emerald-500 transition-colors">Fact-Checking & Sourcing</a></li>
          <li><a href={`${base}/about/`} class="hover:text-emerald-500 transition-colors">Methodology & Editorial</a></li>
          <li><a href={`${base}/contribute/`} class="hover:text-emerald-500 transition-colors">Contribute / Report Issue</a></li>
        </ul>
      </div>

      <!-- Col 4: Open Source -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white mb-3 text-xs uppercase tracking-wider">Community</h4>
        <p class="text-xs mb-3 text-slate-500">
          Built with Astro & Tailwind. Hosted publicly on GitHub Pages.
        </p>
        <a
          href="https://github.com/givemehat/knowledge-hub"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 text-white font-medium hover:bg-slate-800 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          Star on GitHub
        </a>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-400 text-[11px]">
      <p>© 2026 Knowledge Hub. Content licensed under CC BY-SA 4.0. No tracking cookies.</p>
      <p class="flex items-center gap-2">
        <span>Designed with Cognitive & Ergonomic principles (Hick's & Fitts's Laws)</span>
      </p>
    </div>
  </div>
</footer>
