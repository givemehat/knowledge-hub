---
import Layout from '../../layouts/Layout.astro';
import { BRAND } from '../../config/brand';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

const ui = {
  en: {
    title: `Research Methodology & NLP Architecture — ${BRAND.name}`,
    desc: `Detailed computational linguistics and sentiment scoring methodology for ${BRAND.name} research.`,
    home: "Home",
    research: "Research",
    methodology: "Methodology",
    eyebrow: "Computational Pipeline",
    heading: "NLP Architecture & Statistical Methodology",
    subtext: "Complete technical specification of lexicon scoring models, transformer pipelines (MuRIL, IndicBERT), hyperbolic normalization functions, and bootstrap confidence intervals across 3.8+ million headlines.",
    sec1Title: "1. Data Pre-processing & Deduplication",
    sec1Intro: "Raw headline corpora contain significant wire-service and city-edition duplication. Our preprocessing pipeline enforces three rigorous stages:",
    sec1Items: [
      "Exact Match Deduplication: Immediate removal of rows sharing identical timestamps and verbatim headline text.",
      "Lexical Normalization: Lowercasing, HTML entity decoding, whitespace trimming, and stripping of non-alphanumeric noise.",
      "Temporal Binning: Parsing 8-digit date representations (YYYYMMDD) into normalized daily, monthly, and annual longitudinal buckets."
    ],
    sec2Title: "2. The Hybrid Sentiment Engine: Lexicon vs Transformer",
    ruleTitle: "Rule-Based: VADER + AFINN Extension",
    ruleDesc: "For high-throughput scoring across millions of records, we implemented an optimized lexicon engine with custom handling for negation flips ('not', 'hardly') and intensifiers ('massively', 'extremely'). Final compound valence is compressed via tanh(S / 3.0) into normalized [-1.0, +1.0] bounds.",
    transTitle: "Deep Learning: MuRIL & IndicBERT",
    transDesc: "For Hindi and Indic regional nuances, Google Research's MuRIL (Multilingual Representations for Indian Languages) pretrained across 17 Indic languages captures grammatical polarity and socio-political context directly in native Devanagari without translation loss.",
    sec3Title: "3. Statistical Uncertainty & Bootstrap Confidence Intervals",
    sec3Desc: "Reporting bare means without statistical dispersion is scientifically incomplete. We executed non-parametric bootstrap resampling with 1,000 iterations per annual slice to construct empirical 95% Confidence Intervals (CI). Our annual margin of error remained within ±0.045, confirming that deviations observed during economic recessions and election cycles are statistically significant (p < 0.001)."
  },
  hi: {
    title: `शोध कार्यप्रणाली और NLP आर्किटेक्चर — ${BRAND.name} (${BRAND.nameHi})`,
    desc: `${BRAND.name} शोध के लिए विस्तृत कम्प्यूटेशनल भाषाविज्ञान और सेंटीमेंट स्कोरिंग कार्यप्रणाली।`,
    home: "होम",
    research: "शोध",
    methodology: "कार्यप्रणाली",
    eyebrow: "कम्प्यूटेशनल पाइपलाइन",
    heading: "NLP आर्किटेक्चर और सांख्यिकीय कार्यप्रणाली",
    subtext: "3.8 मिलियन समाचार शीर्षकों के विश्लेषण के लिए उपयोग किए गए लेक्सिकॉन मॉडल्स, ट्रांसफॉर्मर्स (MuRIL, IndicBERT), हाइपरबोलिक नॉर्मलाइजेशन, और बूटस्ट्रैप कॉन्फिडेंस इंटरवल्स का संपूर्ण विवरण।",
    sec1Title: "1. डेटा प्री-प्रोसेसिंग और डुप्लीकेशन निष्कासन",
    sec1Intro: "कच्चे डेटासेट में कई संस्करणों में छपे समान समाचारों के डुप्लीकेट्स होते हैं। हमारी पाइपलाइन निम्नलिखित चरण अपनाती है:",
    sec1Items: [
      "Exact Match Deduplication: समान तारीख और समान शीर्षक वाली पंक्तियों को तुरंत हटा दिया जाता है।",
      "Lexical Normalization: सभी अक्षरों को लोअरकेस करना, HTML एंटिटीज़ को डिकोड करना, और गैर-अल्फान्यूमेरिक प्रतीकों को हटाना।",
      "Temporal Binning: 8-अंकीय तारीख (YYYYMMDD) को पार्स करके दैनिक, मासिक और वार्षिक समूहों में समूहीकृत करना।"
    ],
    sec2Title: "2. हाइब्रिड सेंटीमेंट इंजन: लेक्सिकॉन बनाम ट्रांसफॉर्मर",
    ruleTitle: "नियम-आधारित: VADER + AFINN एक्सटेंशन",
    ruleDesc: "लाखों शीर्षकों की तीव्र गणना के लिए हमने एक अनुकूलित लेक्सिकॉन इंजन बनाया जो नकारात्मकता (negations - 'not', 'hardly') और बूस्टर्स ('massively', 'extremely') के लिए वैलेंस को डंप या इन्वर्ट करता है। अंतिम स्कोर को tanh(S / 3.0) द्वारा [-1.0, +1.0] के बीच संपीड़ित किया जाता है।",
    transTitle: "डीप लर्निंग: MuRIL और IndicBERT",
    transDesc: "हिंदी और भारतीय संदर्भों के लिए Google Research का MuRIL (Multilingual Representations for Indian Languages) 17 भारतीय भाषाओं पर प्री-ट्रेंड है। यह देवनागरी लिपि के व्याकरणिक लहजे को बिना अनुवाद की त्रुटियों के सटीक रूप से पकड़ता है।",
    sec3Title: "3. सांख्यिकीय अनिश्चितता और बूटस्ट्रैप कॉन्फिडेंस इंटरवल्स",
    sec3Desc: "केवल औसत (Mean) देना वैज्ञानिक रूप से अधूरा होता है। हमने प्रत्येक वार्षिक नमूने पर 1,000 पुनरावृत्तियों के साथ बूटस्ट्रैप री-सैंपलिंग की, जिससे 95% कॉन्फिडेंस इंटरवल (CI) प्राप्त हुआ। हमारा वार्षिक मार्जिन ऑफ एरर ±0.045 के भीतर सीमित रहा, जो यह साबित करता है कि मंदी और चुनाव के दौरान देखे गए विचलन सांख्यिकीय रूप से महत्वपूर्ण (Statistically Significant, p < 0.001) हैं।"
  }
};

const t = isHindi ? ui.hi : ui.en;
---

<Layout title={t.title} description={t.desc} lang={locale}>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14 overflow-hidden">
    <!-- Ambient Backdrop Light -->
    <div class="pointer-events-none absolute -top-10 left-1/3 w-96 h-64 bg-indigo-500/[0.07] dark:bg-indigo-500/[0.08] rounded-full blur-3xl -z-10"></div>

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8 font-medium">
      <a href={`${base}/${locale}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{t.home}</a>
      <span>/</span>
      <a href={`${base}/${locale}/research/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{t.research}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">{t.methodology}</span>
    </nav>

    <!-- Header -->
    <div class="space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-white/[0.05] border border-slate-200 dark:border-white/10 text-indigo-700 dark:text-indigo-300 text-xs font-bold backdrop-blur-xs">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
        <span>{t.eyebrow}</span>
      </div>
      <h1 class={`text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight ${isHindi ? 'font-hindi' : ''}`}>
        {t.heading}
      </h1>
      <p class={`text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
        {t.subtext}
      </p>
    </div>

    <!-- Content Sections -->
    <div class="space-y-10 text-slate-800 dark:text-slate-200">
      <!-- Section 1: Pre-processing -->
      <section class="space-y-3.5">
        <h2 class={`text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight ${isHindi ? 'font-hindi' : ''}`}>
          {t.sec1Title}
        </h2>
        <div class={`p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] space-y-3.5 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300 ${isHindi ? 'font-hindi' : ''}`}>
          <p>{t.sec1Intro}</p>
          <ul class="space-y-2 list-disc pl-5">
            {t.sec1Items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Section 2: Hybrid Scoring Engine -->
      <section class="space-y-3.5">
        <h2 class={`text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight ${isHindi ? 'font-hindi' : ''}`}>
          {t.sec2Title}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-6 rounded-2xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-xs space-y-2">
            <h3 class={`text-sm font-bold text-slate-900 dark:text-white ${isHindi ? 'font-hindi' : ''}`}>{t.ruleTitle}</h3>
            <p class={`text-xs text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
              {t.ruleDesc}
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-xs space-y-2">
            <h3 class={`text-sm font-bold text-slate-900 dark:text-white ${isHindi ? 'font-hindi' : ''}`}>{t.transTitle}</h3>
            <p class={`text-xs text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
              {t.transDesc}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Statistical Uncertainty -->
      <section class="space-y-3.5">
        <h2 class={`text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight ${isHindi ? 'font-hindi' : ''}`}>
          {t.sec3Title}
        </h2>
        <div class={`p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] space-y-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
          <p>{t.sec3Desc}</p>
        </div>
      </section>
    </div>
  </div>
</Layout>
