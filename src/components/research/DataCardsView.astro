---
import Layout from '../../layouts/Layout.astro';
import { DATA_CARDS } from '../../data/datacards';
import { BRAND } from '../../config/brand';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

const ui = {
  en: {
    title: `Dataset Cards & Data Transparency — ${BRAND.name}`,
    desc: "Comprehensive Data Cards for Kaggle datasets used in media sentiment research.",
    home: "Home",
    research: "Research",
    dataCards: "Data Cards",
    eyebrow: "Open Data Transparency",
    heading: "Kaggle Dataset Cards & Specifications",
    subtext: "Transparent, empirical documentation of all datasets leveraged in our computational research. Every dataset is verified against official Kaggle public repositories with zero synthetic or fabricated data.",
    creatorPrefix: "Creator",
    viewOnKaggle: "View on Kaggle",
    timeRange: "Time Range",
    sampleCount: "Sample Count",
    fileSize: "File Size",
    license: "License",
    descriptionLabel: "Description",
    intendedUseLabel: "Intended Use",
    schemaTitle: "Schema & Column Attributes",
    colName: "Column Name",
    colType: "Data Type",
    colDesc: "Description",
    biasesTitle: "Known Biases & Limitations",
    cleaningTitle: "Data Cleaning Protocol"
  },
  hi: {
    title: `डेटासेट कार्ड्स और डेटा पारदर्शिता — ${BRAND.name} (${BRAND.nameHi})`,
    desc: "मीडिया सेंटीमेंट शोध में प्रयुक्त कैगल डेटासेट्स के विस्तृत डेटा कार्ड्स।",
    home: "होम",
    research: "शोध",
    dataCards: "डेटा कार्ड्स",
    eyebrow: "ओपन डेटा पारदर्शिता",
    heading: "कैगल डेटासेट कार्ड्स और विनिर्देश",
    subtext: "हमारे शोध में उपयोग किए गए सभी डेटासेट्स का पूर्ण पारदर्शी विवरण। कोई भी अप्रमाणित या गढ़ा हुआ डेटासेट नहीं है; सभी विवरण Kaggle के आधिकारिक सार्वजनिक रिपॉजिटरी से सत्यापित हैं।",
    creatorPrefix: "रचयिता",
    viewOnKaggle: "Kaggle पर देखें",
    timeRange: "समय सीमा",
    sampleCount: "नमूना संख्या",
    fileSize: "फ़ाइल आकार",
    license: "लाइसेंस",
    descriptionLabel: "विवरण",
    intendedUseLabel: "लक्षित उपयोग",
    schemaTitle: "स्कीमा और कॉलम विशेषताएँ",
    colName: "कॉलम नाम",
    colType: "डेटा प्रकार",
    colDesc: "विवरण",
    biasesTitle: "ज्ञात पूर्वाग्रह और सीमाएँ",
    cleaningTitle: "डेटा सफ़ाई प्रोटोकॉल"
  }
};

const t = isHindi ? ui.hi : ui.en;
---

<Layout title={t.title} description={t.desc} lang={locale}>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14 overflow-hidden">
    <!-- Ambient Backdrop Light -->
    <div class="pointer-events-none absolute -top-10 left-1/3 w-96 h-64 bg-indigo-500/[0.07] dark:bg-indigo-500/[0.08] rounded-full blur-3xl -z-10"></div>

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8 font-medium">
      <a href={`${base}/${locale}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{t.home}</a>
      <span>/</span>
      <a href={`${base}/${locale}/research/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{t.research}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">{t.dataCards}</span>
    </nav>

    <!-- Header -->
    <div class="space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-white/[0.05] border border-slate-200 dark:border-white/10 text-indigo-700 dark:text-indigo-300 text-xs font-bold backdrop-blur-xs">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        <span>{t.eyebrow}</span>
      </div>
      <h1 class={`text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight ${isHindi ? 'font-hindi' : ''}`}>
        {t.heading}
      </h1>
      <p class={`text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
        {t.subtext}
      </p>
    </div>

    <!-- Cards List -->
    <div class="space-y-12">
      {DATA_CARDS.map(dc => {
        const displayName = isHindi ? (dc.datasetNameHi || dc.datasetName) : dc.datasetName;
        const displayTime = isHindi ? (dc.timeRangeHi || dc.timeRange) : dc.timeRange;
        const displayCount = isHindi ? (dc.sampleCountHi || dc.sampleCount) : dc.sampleCount;
        const displayDesc = isHindi ? dc.description : (dc.descriptionEn || dc.description);
        const displayUse = isHindi ? dc.intendedUse : (dc.intendedUseEn || dc.intendedUse);
        const displayBiases = isHindi ? dc.limitationsAndBiases : (dc.limitationsAndBiasesEn || dc.limitationsAndBiases);
        const displayCleaning = isHindi ? dc.cleaningSteps : (dc.cleaningStepsEn || dc.cleaningSteps);

        return (
          <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] space-y-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 dark:border-white/10">
              <div>
                <span class="text-xs font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                  {t.creatorPrefix}: {dc.creator}
                </span>
                <h2 class={`text-xl sm:text-2xl font-black text-slate-900 dark:text-white mt-0.5 ${isHindi ? 'font-hindi' : ''}`}>
                  {displayName}
                </h2>
              </div>
              <a 
                href={dc.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 rounded-xl bg-indigo-50 dark:bg-white/[0.06] border border-indigo-200 dark:border-white/10 text-indigo-700 dark:text-indigo-300 font-bold text-xs hover:bg-indigo-100 dark:hover:bg-white/10 transition-colors inline-flex items-center gap-1.5 shrink-0"
              >
                <span>{t.viewOnKaggle}</span>
                <span>↗</span>
              </a>
            </div>

            <!-- Quick Stats Pill Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5">
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">{t.timeRange}</span>
                <span class={`font-bold text-slate-800 dark:text-slate-200 ${isHindi ? 'font-hindi' : ''}`}>{displayTime}</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5">
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">{t.sampleCount}</span>
                <span class={`font-bold font-mono text-slate-800 dark:text-slate-200 ${isHindi ? 'font-hindi' : ''}`}>{displayCount}</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5">
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">{t.fileSize}</span>
                <span class="font-bold font-mono text-slate-800 dark:text-slate-200">{dc.size}</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5">
                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">{t.license}</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400">{dc.license}</span>
              </div>
            </div>

            <!-- Description & Intended Use -->
            <div class={`space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300 ${isHindi ? 'font-hindi' : ''}`}>
              <p><strong>{t.descriptionLabel}:</strong> {displayDesc}</p>
              <p><strong>{t.intendedUseLabel}:</strong> {displayUse}</p>
            </div>

            <!-- Schema Table -->
            <div class="space-y-2">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">{t.schemaTitle}</h3>
              <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-darkborder">
                <table class="w-full text-xs text-left">
                  <thead class="bg-slate-50 dark:bg-slate-900 text-slate-400 font-mono uppercase text-[10px]">
                    <tr>
                      <th class="py-2 px-3">{t.colName}</th>
                      <th class="py-2 px-3">{t.colType}</th>
                      <th class="py-2 px-3">{t.colDesc}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    {dc.columns.map(col => (
                      <tr>
                        <td class="py-2 px-3 font-mono font-bold text-indigo-600 dark:text-indigo-400">{col.name}</td>
                        <td class="py-2 px-3 font-mono text-slate-400">{col.type}</td>
                        <td class={`py-2 px-3 text-slate-600 dark:text-slate-300 ${isHindi ? 'font-hindi' : ''}`}>
                          {isHindi ? col.description : (col.descriptionEn || col.description)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Limitations & Cleaning Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-rose-50/50 dark:bg-rose-950/20 border border-rose-200/50 dark:border-rose-800/40 space-y-2">
                <h3 class="text-xs font-bold text-rose-700 dark:text-rose-400 uppercase tracking-wider flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-rose-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  <span>{t.biasesTitle}</span>
                </h3>
                <ul class={`text-xs space-y-1 text-slate-700 dark:text-slate-300 ${isHindi ? 'font-hindi' : ''}`}>
                  {displayBiases.map(lb => <li>• {lb}</li>)}
                </ul>
              </div>

              <div class="p-4 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/50 dark:border-emerald-800/40 space-y-2">
                <h3 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span>{t.cleaningTitle}</span>
                </h3>
                <ul class={`text-xs space-y-1 text-slate-700 dark:text-slate-300 ${isHindi ? 'font-hindi' : ''}`}>
                  {displayCleaning.map(cs => <li>• {cs}</li>)}
                </ul>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
