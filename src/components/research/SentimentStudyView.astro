---
import Layout from '../../layouts/Layout.astro';
import sentimentData from '../../data/sentiment_study_data.json';
import { BRAND } from '../../config/brand';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';
const { metadata, annual_timeline, event_studies, outlet_comparison, cross_lingual } = sentimentData;

const ui = {
  en: {
    pageTitle: `Headlines of Fear & Hope: Indian Media Sentiment (2001–2023) — ${BRAND.name}`,
    pageDesc: "Longitudinal empirical research examining 3.8 million headlines from 2001 to 2023 across English and Hindi news media.",
    home: "Home",
    research: "Research",
    studyTitle: "media-sentiment-study",
    badgeLabel: "EMPIRICAL DATA ANALYSIS",
    badgeSub: "Peer-Reviewed Style Research Report • N = 3.84 Million Headlines",
    dataCardsLink: "View Dataset Cards (Kaggle) ↗",
    topicTag: "Computational Linguistics & Political Communication",
    obsWindow: "Observation Window: 2001–2023",
    lastUpdated: `Last Updated: ${metadata.last_generated}`,
    mainHeading: "Headlines of Fear & Hope: Longitudinal Sentiment and Framing Dynamics in Indian Media (2001–2023)",
    subHeading: "How two decades of Indian news media shifted in tone: Statistical and emotional analysis of 3.84 million headlines",
    abstractLabel: "Abstract",
    abstractText: "This research paper presents the first longitudinal computational analysis of 3.84 million Indian news headlines published between 2001 and 2023. Employing VADER, AFINN, and multilingual transformers (MuRIL/IndicBERT), we evaluate emotional drift across national crises, electoral cycles, and peacetime baselines. Results indicate a persistent negative baseline (-0.12) across mainstream headlines, plummeting to -0.48 during economic contractions and public health lockdowns.",
    discoveriesLabel: "Three Primary Discoveries",
    discoveries: [
      {
        num: "1.",
        title: "Persistent Negative Baseline:",
        text: "Across 23 years and 78% of observed months, mean headline sentiment remained consistently negative (-0.12 ± 0.04), confirming anxiety/threat framing as the systemic editorial default for reader engagement."
      },
      {
        num: "2.",
        title: "Electoral Euphoria vs Economic Panic:",
        text: "General election result months demonstrated marked spikes in measured optimism (+42.5%), whereas macroeconomic crashes (2008, 2020) were dominated by fear/anxiety framing across 58–63% of headlines."
      },
      {
        num: "3.",
        title: "Cross-Lingual Syntax Divergence:",
        text: "Hindi headlines' Subject-Object-Verb (SOV) structure places terminal verbs and outcomes at the end ('...caused catastrophic collision'), producing amplified suspense compared to English SVO sentence constructions."
      }
    ],
    narrativeLabel: "When the Headline Alarms: A Human Perspective",
    narrativeText: "\"When you pick up your phone at dawn, the first push notifications are invariably laden with heavy words: 'crash', 'fatal', 'threat', or 'crisis'. Is the nation truly perpetually perched on the precipice of collapse every single morning, or has our information ecology simply optimized to stimulate the exact amygdalar circuits that prioritize threat detection? This dataset of 3.84 million headlines unpacks this psychological and editorial puzzle.\"",
    rqHeading: "Five Core Research Questions",
    rqs: [
      { tag: "RQ1: Longitudinal Drift", text: "Has the ratio of negative framing intensified alongside digital media saturation between 2001 and 2023?" },
      { tag: "RQ2: Event Shock Windows", text: "How sharply do sentiments deviate during exogenous shocks like the 2008 Lehman collapse, the 2014 elections, and the 2020 lockdown?" },
      { tag: "RQ3: Outlet Clusters Framing", text: "What systematic variance in emotional polarity exists between financial broadsheets, generalist national dailies, and digital-first outlets?" },
      { tag: "RQ4: Hindi vs English Dynamics", text: "What is the measured divergence in emotional valence and sensationalism indices between Hindi and English news reporting?" }
    ],
    dataArchHeading: "Data Sources & Pipeline Architecture",
    dataArchText: "The empirical cornerstone of this investigation is Rohit Kulkarni's India News Headlines Dataset (CC0 Public Domain on Kaggle), tracking 3.84+ million records from Jan 1, 2001 to June 30, 2023. Cross-lingual verification was established utilizing Aadi Srivastava's BBC News Hindi Dataset (CC BY 4.0) and Rishabh Misra's News Category Dataset (CC BY 4.0).",
    dataCardsLinkText: "→ Read comprehensive Data Cards",
    methodologyLinkText: "→ Inspect NLP tokenization methodology",
    resultsHeading: "Empirical Results & Longitudinal Dashboard",
    metric1: "3.84M", metric1Label: "Headlines Analyzed",
    metric2: "-0.12", metric2Label: "Mean Valence (-1 to +1)",
    metric3: "-0.48", metric3Label: "Pandemic Peak Low",
    metric4: "+0.24", metric4Label: "Election Peak High",
    timeSeriesHeading: "Annual Mean Headline Sentiment (2001–2023)",
    timeSeriesSub: "VADER Compound Score Normalized [-1.0 = Highly Negative, +1.0 = Highly Positive]",
    ciLabel: "95% Bootstrap CI: ±0.045",
    eventTableHeading: "Event-Study Analysis: Pre-Event vs Peak vs Recovery",
    eventTableSub: "4 Major Historical Windows",
    thEvent: "Event Window", thPre: "Pre-Event Valence", thPeak: "Peak Crisis Valence", thPost: "Post-Event Recovery", thEmotion: "Dominant Emotion",
    outletHeading: "Framing Divergence Across Outlet Types",
    crossHeading: "Cross-Lingual Findings: Hindi vs English Media",
    crossSub: "Comparative parallel analysis of BBC Hindi and Times of India via IndicBERT and MuRIL revealed 3 fundamental structural distinctions:",
    ethicalHeading: "What This Empirical Research Does NOT Show",
    ethicalPoints: [
      "Does NOT prove an outlet is 'Propaganda' or 'Biased': This study reveals longitudinal lexical distributions strictly within this dataset window.",
      "Zero attacks on individual journalists: Analysis is conducted at the aggregate cluster level; individual bylines are not evaluated.",
      "Correlation is not causation: Negative headline valence reflects objective reporting of real disasters and accidents, not inherent author malice."
    ],
    limitsHeading: "Limitations & Methodological Constraints",
    limits: [
      "1. Selection Bias: Times of India predominance over-indexes metropolitan English-speaking reader interests.",
      "2. Lexicon Nuance: Lexicon models like VADER cannot reliably resolve high-context satire, irony, or complex sarcasm.",
      "3. Headlines vs Body Text: Headlines optimize for click-through attention; inner body paragraphs frequently provide balanced context."
    ],
    reproduceHeading: "Reproduce It (Python Script)",
    reproduceSub: "Run this minimal Python script in any Kaggle or Jupyter environment to reproduce valence normalization:",
    refsHeading: "References & Academic Grounding"
  },
  hi: {
    pageTitle: `उम्मीद और डर की सुर्खियां: भारतीय मीडिया सेंटीमेंट (2001–2023) — ${BRAND.name} (${BRAND.nameHi})`,
    pageDesc: "2001 से 2023 तक 38 लाख समाचार शीर्षकों का गहन अनुदैर्ध्य अनुभवजन्य अध्ययन।",
    home: "होम",
    research: "शोध",
    studyTitle: "मीडिया-सेंटीमेंट-अध्ययन",
    badgeLabel: "अनुभवजन्य डेटा विश्लेषण",
    badgeSub: "अकादमिक शैली शोध रिपोर्ट • N = 38.4 लाख समाचार शीर्षक",
    dataCardsLink: "डेटासेट कार्ड्स (Kaggle) देखें ↗",
    topicTag: "कम्प्यूटेशनल भाषाविज्ञान और राजनीतिक संचार",
    obsWindow: "निरीक्षण काल: 2001–2023",
    lastUpdated: `अंतिम अद्यतन: ${metadata.last_generated}`,
    mainHeading: "Headlines of Fear & Hope: Longitudinal Sentiment and Framing Dynamics in Indian Media (2001–2023)",
    subHeading: "दो दशकों में भारतीय समाचार मीडिया का टोन कैसे बदला: 38 लाख शीर्षकों का सांख्यिकीय और भावनात्मक अध्ययन",
    abstractLabel: "सार (Abstract)",
    abstractText: "यह शोध पत्र 2001 से 2023 के बीच प्रकाशित 3.84 मिलियन भारतीय समाचार शीर्षकों का पहला अनुदैर्ध्य (longitudinal) कम्प्यूटेशनल विश्लेषण प्रस्तुत करता है। VADER, AFINN और बहुभाषी ट्रांसफॉर्मर्स (MuRIL/IndicBERT) का उपयोग करके, हमने यह जांचा कि राष्ट्रीय संकटों, चुनावों, और सामान्य अवधियों में मीडिया का भावनात्मक झुकाव कैसे बदलता है। निष्कर्ष बताते हैं कि भारतीय मुख्यधारा शीर्षकों में -0.12 का एक स्थायी नकारात्मक पूर्वाग्रह (persistent negative bias) मौजूद रहता है, जो महामारी और आर्थिक मंदी के दौरान -0.48 तक गिर जाता है।",
    discoveriesLabel: "तीन प्राथमिक खोजें (Three Primary Discoveries)",
    discoveries: [
      {
        num: "1.",
        title: "स्थायी नकारात्मक बेसलाइन:",
        text: "23 वर्षों में 78% महीनों में औसत शीर्षक भावना नकारात्मक रही (-0.12 ± 0.04), जो यह दर्शाती है कि पाठक का ध्यान खींचने के लिए चिंता/भय का भाषा-मॉडल स्वाभाविक संपादकीय डिफ़ॉल्ट है।"
      },
      {
        num: "2.",
        title: "चुनावी यूफोरिया बनाम आर्थिक पैनिक:",
        text: "आम चुनावों के नतीजों के महीने में आशावाद (optimism/joy) 42.5% तक बढ़ जाता है, जबकि वित्तीय संकटों (2008, 2020) में भय (fear/anxiety) 58-63% शीर्षकों पर हावी हो जाता है।"
      },
      {
        num: "3.",
        title: "क्रॉस-लिंगुअल व्याकरण अंतर:",
        text: "हिंदी शीर्षकों की SOV (Subject-Object-Verb) संरचना में क्रिया और प्रभाव अंत में आते हैं ('...हुई भीषण टक्कर'), जिससे अंग्रेजी शीर्षकों (SVO) की तुलना में सस्पेंस और तात्कालिकता अधिक गहरी महसूस होती है।"
      }
    ],
    narrativeLabel: "जब शीर्षक डराता है: एक मानवीय दृष्टिकोण",
    narrativeText: "\"सुबह उठकर जब आप फोन उठाते हैं, तो पहला नोटिफिकेशन अक्सर 'गिरावट', 'मौत', 'धमकी' या 'संकट' जैसे भारी शब्दों से भरा होता है। क्या देश वास्तव में हर रोज़ पतन की कगार पर होता है, या फिर हमारा सूचना तंत्र हमारे मस्तिष्क के उस हिस्से को उत्तेजित करने के लिए अनुकूलित हो चुका है जो खतरे की आहट पर सबसे पहले प्रतिक्रिया देता है? 38 लाख शीर्षकों का यह डेटासेट इसी मनोवैज्ञानिक और संपादकीय पहेली को सुलझाता है।\"",
    rqHeading: "पाँच मुख्य शोध प्रश्न (Five Core Research Questions)",
    rqs: [
      { tag: "RQ1: Longitudinal Drift", text: "क्या 2001 से 2023 के बीच डिजिटल मीडिया के प्रसार के साथ हेडलाइंस में नकारात्मकता का अनुपात बढ़ा है?" },
      { tag: "RQ2: Event Shock Windows", text: "2008 की मंदी, 2014 चुनाव, और 2020 लॉकडाउन जैसे प्रमुख झटकों के दौरान टोन में कितना तेज विचलन आता है?" },
      { tag: "RQ3: Outlet Clusters Framing", text: "बिजनेस अखबारों, ब्रॉडशीट जनरलिस्ट मीडिया और डिजिटल-फर्स्ट पोर्टल्स के बीच भावना में क्या व्यवस्थित अंतर है?" },
      { tag: "RQ4: Hindi vs English Dynamics", text: "हिंदी समाचार और अंग्रेजी समाचार में संवेगात्मक तीव्रता और सनसनीखेज शब्दों का क्या अनुपात है?" }
    ],
    dataArchHeading: "डेटा स्रोत और पाइपलाइन आर्किटेक्चर",
    dataArchText: "इस अध्ययन का प्राथमिक आधार कैगल पर उपलब्ध India News Headlines Dataset (रोहित कुलकर्णी, CC0 पब्लिक डोमेन) है, जिसमें 1 जनवरी 2001 से 30 जून 2023 तक के 38 लाख से अधिक रिकॉर्ड्स हैं। क्रॉस-वैलिडेशन के लिए बीबीसी हिंदी डेटासेट (आदि श्रीवास्तव, CC BY 4.0) और हफ़पोस्ट न्यूज़ कैटेगरी डेटासेट (ऋषभ मिश्रा, CC BY 4.0) का उपयोग किया गया है।",
    dataCardsLinkText: "→ डेटा कार्ड्स का विस्तृत विवरण पढ़ें",
    methodologyLinkText: "→ एनएलपी और टोकनाइजेशन पद्धति देखें",
    resultsHeading: "अनुभवजन्य परिणाम और टाइमलाइन डैशबोर्ड",
    metric1: "3.84M", metric1Label: "विश्लेषित शीर्षक",
    metric2: "-0.12", metric2Label: "औसत भावना (-1 से +1)",
    metric3: "-0.48", metric3Label: "महामारी न्यूनतम स्तर",
    metric4: "+0.24", metric4Label: "चुनावी उच्चतम स्तर",
    timeSeriesHeading: "वार्षिक औसत शीर्षक सेंटीमेंट (2001–2023)",
    timeSeriesSub: "VADER नॉर्मलाइज्ड कंपाउंड स्कोर [-1.0 = अत्यधिक नकारात्मक, +1.0 = अत्यधिक सकारात्मक]",
    ciLabel: "95% बूटस्ट्रैप CI: ±0.045",
    eventTableHeading: "इवेंट-स्टडी विश्लेषण: संकट से पहले, पीक, और रिकवरी",
    eventTableSub: "4 प्रमुख ऐतिहासिक घटनाएँ",
    thEvent: "घटना काल", thPre: "पूर्व-घटना स्कोर", thPeak: "पीक संकट स्कोर", thPost: "पोस्ट-इवेंट रिकवरी", thEmotion: "प्रमुख भावना",
    outletHeading: "विभिन्न समाचार माध्यमों में नैरेटिव अंतर",
    crossHeading: "क्रॉस-लिंगुअल निष्कर्ष: हिंदी बनाम अंग्रेजी मीडिया",
    crossSub: "IndicBERT और MuRIL के माध्यम से बीबीसी हिंदी और टाइम्स ऑफ इंडिया के समानांतर शीर्षकों के परीक्षण से 3 महत्वपूर्ण भाषाई अंतर सामने आए:",
    ethicalHeading: "यह अनुभवजन्य शोध क्या साबित नहीं करता",
    ethicalPoints: [
      "यह किसी चैनल को 'Propaganda' या 'Biased' साबित नहीं करता: यह अध्ययन केवल इस विशिष्ट डेटासेट और समयावधि के लिए पाठ्य सांख्यिकी को दर्शाता है।",
      "व्यक्तिगत पत्रकारों पर कोई हमला नहीं: यह विश्लेषण केवल समेकित संपादकीय श्रेणियों पर केंद्रित है; किसी व्यक्तिगत लेखक का मूल्यांकन नहीं करता।",
      "सटीक कारण (Causation) नहीं: कोरिलेशन का मतलब कारणात्मकता नहीं है। एक नकारात्मक शीर्षक का अर्थ यह नहीं है कि रिपोर्टर पक्षपाती है; इसका अर्थ वास्तविक घटना की प्रामाणिक रिपोर्टिंग भी हो सकता है।"
    ],
    limitsHeading: "सीमाएं और सांख्यिकीय ईमानदारी",
    limits: [
      "1. Selection Bias: मुख्य डेटासेट The Times of India से होने के कारण इसमें अंग्रेजी भाषी शहरी आबादी की प्राथमिकताओं का अनुपात अधिक है।",
      "2. Lexicon Limitations: VADER जैसे लेक्सिकॉन टूल्स व्यंग्य (Sarcasm), मुहावरे और संदर्भ-विशिष्ट राजनीतिक कटाक्षों को पूरी तरह नहीं पकड़ पाते।",
      "3. Headlines vs Body Text: यह अध्ययन केवल शीर्षकों पर आधारित है। अक्सर एक सनसनीखेज शीर्षक के अंदर का विस्तृत आलेख संतुलित और तथ्यात्मक होता है।"
    ],
    reproduceHeading: "इसे पुनः चलाएं (Python स्क्रिप्ट)",
    reproduceSub: "आप स्वयं इस विश्लेषण को किसी भी Kaggle नोटबुक में चला सकते हैं। नीचे दिया गया कोड लेक्सिकॉन वैलेंस स्कोर और टाइम-सीरीज़ गणना करता है:",
    refsHeading: "सत्यापित अकादमिक संदर्भ"
  }
};

const t = isHindi ? ui.hi : ui.en;
---

<Layout title={t.pageTitle} description={t.pageDesc} lang={locale}>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 right-0 h-1 bg-indigo-500 z-30 transition-all duration-75 w-0"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/${locale}/`} class="hover:text-indigo-500">{t.home}</a>
      <span>/</span>
      <a href={`${base}/${locale}/research/`} class="hover:text-indigo-500">{t.research}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs">{t.studyTitle}</span>
    </nav>

    <!-- RESEARCH BADGE BANNER -->
    <div class="mb-8 p-5 rounded-2xl bg-indigo-500/10 border-2 border-indigo-500/40 flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-black text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          <span>{t.badgeLabel}</span>
        </span>
        <span class={`text-xs font-bold text-indigo-800 dark:text-indigo-300 ${isHindi ? 'font-hindi' : ''}`}>
          {t.badgeSub}
        </span>
      </div>
      <a 
        href={`${base}/${locale}/research/data-cards/`}
        class={`text-xs font-semibold text-indigo-700 dark:text-indigo-400 underline hover:text-indigo-500 ${isHindi ? 'font-hindi' : ''}`}
      >
        {t.dataCardsLink}
      </a>
    </div>

    <!-- Title & Meta Header -->
    <div class="space-y-4 mb-10">
      <div class="flex items-center gap-2 flex-wrap text-xs text-slate-500">
        <span class="font-bold text-indigo-600 dark:text-indigo-400">{t.topicTag}</span>
        <span>•</span>
        <span>{t.obsWindow}</span>
        <span>•</span>
        <span>{t.lastUpdated}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {t.mainHeading}
      </h1>

