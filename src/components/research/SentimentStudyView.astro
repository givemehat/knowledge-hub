import re, math

VALENCE_LEXICON = {
    "crash": -3.2, "crisis": -3.0, "panic": -3.1, "surge": 2.7,
    "recovery": 2.3, "growth": 2.2, "fear": -2.5, "win": 2.8
}

def calculate_valence(headline: str) -> float:
    words = re.findall(r"\\b[a-z]+\\b", headline.lower())
    score = sum(VALENCE_LEXICON.get(w, 0.0) for w in words)
    # Hyperbolic tangent normalization to range [-1.0, 1.0]
    return round(math.tanh(score / 3.0), 3)

sample = "Sensex logs massive crash amid global financial crisis"
print(f"Headline Valence: {calculate_valence(sample)}") # Output: -0.963`}</code></pre>
