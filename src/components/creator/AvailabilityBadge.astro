---
import { CREATOR } from '../../data/creator';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{CREATOR.availableForWork && (
  <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-peacock-500/10 dark:bg-peacock-950/40 border border-peacock-500/25 text-peacock-700 dark:text-peacock-300 text-xs font-semibold shadow-xs ${className}`}>
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-peacock-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-peacock-500"></span>
    </span>
    <span>{CREATOR.availabilityStatus}</span>
  </div>
)}
