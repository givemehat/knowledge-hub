---
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Button from '../ui/Button.astro';
import { CREATOR } from '../../data/creator';

interface Props {
  topicTitle?: string;
  topicSlug?: string;
  lastVerified?: string;
}

const { topicTitle = 'this topic', topicSlug = '', lastVerified = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issueUrl = topicSlug 
  ? `https://github.com/givemehat/knowledge-hub/issues/new?title=Correction:+${encodeURIComponent(topicTitle)}`
  : 'https://github.com/givemehat/knowledge-hub/issues/new';
---

<Card class="author-signature-card my-10 p-6 sm:p-8" id="author-card">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="flex items-start gap-4">
      <!-- Monogram Avatar -->
      <a href={`${base}/about/`} class="shrink-0 group" aria-label={`View profile of ${CREATOR.name}`}>
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-600 via-indigo-600 to-peacock-600 flex items-center justify-center text-white text-lg font-black shadow-apple-sm group-hover:scale-105 transition-transform">
          {CREATOR.name.split(' ').map(n => n[0]).join('')}
        </div>
      </a>

      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <a href={`${base}/about/`} class="font-bold text-base text-slate-900 dark:text-white hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            {CREATOR.name}
          </a>
          <Chip variant="neutral" size="sm">
            Curator & Builder
          </Chip>
          {CREATOR.availableForWork && (
            <Chip variant="language" size="sm">
              Available for Roles
            </Chip>
          )}
        </div>

        <p class="text-xs text-slate-600 dark:text-slate-400 max-w-lg leading-relaxed">
          {CREATOR.role} • {CREATOR.tagline}
        </p>

        <p class="text-[11px] text-slate-400 pt-0.5">
          Notice an inaccuracy? Every guide is open-source and welcomes peer corrections.
        </p>
      </div>
    </div>

    <!-- Unified Buttons: Ghost 'Report an issue' + Primary dark pill 'Connect' -->
    <div class="flex items-center gap-2.5 shrink-0 w-full sm:w-auto">
      <Button
        href={issueUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="ghost"
        size="sm"
        icon="external"
      >
        <span>Report an issue</span>
      </Button>

      <Button
        href={`${base}/about/`}
        variant="primary"
        size="sm"
        icon="arrow"
      >
        <span>Connect</span>
      </Button>
    </div>
  </div>
</Card>
