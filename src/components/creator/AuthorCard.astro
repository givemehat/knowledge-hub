---
import { CREATOR } from '../../data/creator';

interface Props {
  topicTitle?: string;
  topicSlug?: string;
  lastVerified?: string;
}

const { topicTitle = 'this topic', topicSlug = '', lastVerified = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const editUrl = topicSlug 
  ? `https://github.com/givemehat/knowledge-hub/edit/main/content/topics/${topicSlug}.mdx`
  : 'https://github.com/givemehat/knowledge-hub';
---

<div class="my-10 p-6 sm:p-8 rounded-3xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-card relative overflow-hidden">
  <!-- Subtle top accent -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-500 via-peacock-500 to-saffron-500"></div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="flex items-start gap-4">
      <!-- Initials Avatar -->
      <a href={`${base}/about/`} class="shrink-0 group">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-600 via-indigo-600 to-peacock-600 flex items-center justify-center text-white text-lg font-black shadow-md group-hover:scale-105 transition-transform">
          {CREATOR.name.split(' ').map(n => n[0]).join('')}
        </div>
      </a>

      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <a href={`${base}/about/`} class="font-bold text-base text-slate-900 dark:text-white hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            {CREATOR.name}
          </a>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200/60 dark:border-white/5">
            Author & Curator
          </span>
          {CREATOR.availableForWork && (
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-peacock-600 dark:text-peacock-400">
              <span class="w-1.5 h-1.5 rounded-full bg-peacock-500"></span>
              Available for roles
            </span>
          )}
        </div>

        <p class="text-xs text-slate-600 dark:text-slate-400 max-w-lg leading-relaxed">
          {CREATOR.role} • {CREATOR.tagline}
        </p>

        <p class="text-[11px] text-slate-400 pt-1">
          Kuch galat mila ya naya roadmap propose karna hai? Open-source community feedback hamesha welcome hai!
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap sm:flex-col gap-2 shrink-0 w-full sm:w-auto">
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 dark:bg-slate-800 text-white text-xs font-bold hover:bg-slate-800 dark:hover:bg-slate-700 transition-all shadow-xs"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
        <span>Suggest Edit on GitHub</span>
      </a>

      <a
        href={`${base}/contact/`}
        class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 text-xs font-bold hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 transition-all shadow-xs"
      >
        <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        <span>Connect with Builder</span>
      </a>
    </div>
  </div>
</div>
