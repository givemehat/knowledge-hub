---
import { CREATOR } from '../../data/creator';

interface Props {
  variant?: 'minimal' | 'full';
  class?: string;
}

const { variant = 'minimal', class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  href={`${base}/about/`}
  class={`inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/80 dark:bg-darkcard/80 hover:bg-white dark:hover:bg-darkcard border border-slate-200/80 dark:border-white/10 hover:border-brand-500/50 shadow-sm transition-all duration-200 group ${className}`}
  title={`Learn more about ${CREATOR.name}`}
>
  <div class="w-5 h-5 rounded-full bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white text-[10px] font-bold shadow-xs">
    {CREATOR.name.split(' ').map(n => n[0]).join('')}
  </div>

  <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors flex items-center gap-1">
    <span>Built by</span>
    <strong class="font-bold text-slate-900 dark:text-white">{CREATOR.name}</strong>
  </span>

  {variant === 'full' && (
    <span class="w-1.5 h-1.5 rounded-full bg-peacock-500 animate-pulse" title="Available for roles"></span>
  )}
</a>
