---
import { CREATOR } from '../../data/creator';
---

<div class="space-y-6">
  {CREATOR.skills.map(group => (
    <div class="space-y-2.5">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">
        {group.category}
      </h4>
      <div class="flex flex-wrap gap-2">
        {group.skills.map(s => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-xs hover:border-brand-500/40 transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
            <span>{s.name}</span>
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
