---
import { CREATOR } from '../../data/creator';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] ${className}`}>
  <div class="mb-6 space-y-1">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
      <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      <span>Send a Message to {CREATOR.name}</span>
    </h3>
    <p class="text-xs text-slate-500 dark:text-slate-400">
      Collaboration ideas, technical feedback, engineering roles, or open-source discussions — feel free to send a message.
    </p>
  </div>

  <form id="contact-builder-form" class="space-y-4 text-xs" action={CREATOR.contactFormEndpoint} method="POST">
    <!-- Spam Protection Honeypot Field (Hidden from humans) -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="sender-name" class="font-bold text-slate-700 dark:text-slate-300">Your Name *</label>
        <input
          type="text"
          id="sender-name"
          name="name"
          required
          placeholder="e.g. Aditi Sharma"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40 transition-colors"
        />
      </div>

      <div class="space-y-1.5">
        <label for="sender-email" class="font-bold text-slate-700 dark:text-slate-300">Your Email *</label>
        <input
          type="email"
          id="sender-email"
          name="email"
          required
          placeholder="aditi@example.com"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40 transition-colors"
        />
      </div>
    </div>

    <div class="space-y-1.5">
      <label for="sender-subject" class="font-bold text-slate-700 dark:text-slate-300">Subject</label>
      <input
        type="text"
        id="sender-subject"
        name="subject"
        placeholder={`e.g. Collaboration on ${CREATOR.name}'s Projects / Engineering Role`}
        class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40 transition-colors"
      />
    </div>

    <div class="space-y-1.5">
      <label for="sender-message" class="font-bold text-slate-700 dark:text-slate-300">Message *</label>
      <textarea
        id="sender-message"
        name="message"
        required
        rows="4"
        placeholder="Write your message here..."
        class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.04] border border-slate-200/80 dark:border-white/10 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40 transition-colors leading-relaxed"
      ></textarea>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <button
        type="submit"
        id="form-submit-btn"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold hover:bg-brand-600 dark:hover:bg-brand-400 dark:hover:text-white transition-all shadow-sm cursor-pointer hover:scale-[1.01]"
      >
        <span>Send Message</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </button>

      <span class="text-[11px] text-slate-400 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        <span>No spam. Data is delivered directly to builder inbox.</span>
      </span>
    </div>

    <!-- Live Status Banner -->
    <div id="form-status-msg" class="hidden p-3 rounded-xl text-xs font-semibold"></div>
  </form>
</div>

<script is:inline define:vars={{ fallbackEmail: CREATOR.links.email }}>
  const form = document.getElementById('contact-builder-form');
  const submitBtn = document.getElementById('form-submit-btn');
  const statusMsg = document.getElementById('form-status-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusMsg) return;

    submitBtn.setAttribute('disabled', 'true');
    submitBtn.innerHTML = '<span>Sending message...</span>';

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        statusMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20';
        statusMsg.innerText = 'Thank you! Your message has been sent successfully. I will get back to you promptly.';
        statusMsg.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error('Endpoint submission returned status ' + response.status);
      }
    } catch (err) {
      // Graceful fallback to direct mailto client
      const subject = encodeURIComponent(formData.get('subject') || 'Contact from Peach');
      const body = encodeURIComponent(formData.get('message') || '');
      const mailtoUrl = `mailto:${fallbackEmail}?subject=${subject}&body=${body}`;

      statusMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20';
      statusMsg.innerHTML = `Direct static submission: <a href="${mailtoUrl}" class="underline font-bold">Click here to send via your email client (${fallbackEmail})</a>.`;
      statusMsg.classList.remove('hidden');
    } finally {
      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = '<span>Send Message</span><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>';
    }
  });
</script>
