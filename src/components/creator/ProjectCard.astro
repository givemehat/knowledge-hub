---
import type { ProjectItem } from '../../data/creator';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<div class="group p-6 rounded-3xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 hover:border-brand-500/50 shadow-sm hover:shadow-card transition-all duration-200 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="w-8 h-8 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-600 dark:text-brand-400 group-hover:scale-110 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
      </div>
      <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
        project.status === 'active' ? 'bg-peacock-500/10 text-peacock-600 dark:text-peacock-400 border border-peacock-500/20' :
        project.status === 'completed' ? 'bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20' :
        'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
      }`}>
        {project.status}
      </span>
    </div>

    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      {project.title}
    </h3>

    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
      {project.description}
    </p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-1.5 mt-4">
      {project.tags.map(tag => (
        <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 font-medium">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-white/5 flex items-center justify-between text-xs font-semibold">
    {project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        <span>GitHub Code</span>
      </a>
    )}

    {project.demo && (
      <a
        href={project.demo}
        class="inline-flex items-center gap-1 text-brand-600 dark:text-brand-400 hover:underline"
      >
        <span>Live Preview</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    )}
  </div>
</div>
