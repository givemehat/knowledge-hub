---
import { CREATOR } from '../../data/creator';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="p-6 rounded-3xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-card flex flex-col items-center text-center space-y-4">
  <div class="space-y-1">
    <div class="text-[10px] font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">
      Quick Mobile Connect
    </div>
    <h4 class="font-bold text-sm text-slate-900 dark:text-white">
      Digital Contact Card
    </h4>
  </div>

  <!-- Geometric SVG QR Code Container -->
  <div class="p-3 rounded-2xl bg-white border border-slate-200 shadow-xs relative">
    <svg class="w-36 h-36" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- QR Position Detection Patterns (Top-Left, Top-Right, Bottom-Left) -->
      <rect x="5" y="5" width="26" height="26" rx="4" fill="#0F172A" />
      <rect x="9" y="9" width="18" height="18" rx="2" fill="white" />
      <rect x="13" y="13" width="10" height="10" rx="1" fill="#5B3DF5" />

      <rect x="69" y="5" width="26" height="26" rx="4" fill="#0F172A" />
      <rect x="73" y="9" width="18" height="18" rx="2" fill="white" />
      <rect x="77" y="13" width="10" height="10" rx="1" fill="#5B3DF5" />

      <rect x="5" y="69" width="26" height="26" rx="4" fill="#0F172A" />
      <rect x="9" y="73" width="18" height="18" rx="2" fill="white" />
      <rect x="13" y="77" width="10" height="10" rx="1" fill="#5B3DF5" />

      <!-- Stylized Data Matrix Dots -->
      <rect x="36" y="8" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="46" y="8" width="6" height="6" rx="1" fill="#0E8A8A" />
      <rect x="56" y="8" width="6" height="6" rx="1" fill="#0F172A" />
      
      <rect x="36" y="18" width="6" height="6" rx="1" fill="#5B3DF5" />
      <rect x="46" y="18" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="56" y="18" width="6" height="6" rx="1" fill="#0F172A" />

      <rect x="36" y="28" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="46" y="28" width="6" height="6" rx="1" fill="#FF851A" />
      <rect x="56" y="28" width="6" height="6" rx="1" fill="#0E8A8A" />

      <rect x="8" y="36" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="18" y="36" width="6" height="6" rx="1" fill="#5B3DF5" />
      <rect x="28" y="36" width="6" height="6" rx="1" fill="#0F172A" />

      <rect x="36" y="44" width="8" height="8" rx="2" fill="#5B3DF5" />
      <rect x="48" y="44" width="8" height="8" rx="2" fill="#0E8A8A" />
      <rect x="60" y="44" width="8" height="8" rx="2" fill="#0F172A" />

      <rect x="8" y="48" width="6" height="6" rx="1" fill="#0E8A8A" />
      <rect x="18" y="48" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="28" y="48" width="6" height="6" rx="1" fill="#5B3DF5" />

      <rect x="36" y="60" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="46" y="60" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="56" y="60" width="6" height="6" rx="1" fill="#FF851A" />

      <rect x="36" y="72" width="6" height="6" rx="1" fill="#0E8A8A" />
      <rect x="46" y="72" width="6" height="6" rx="1" fill="#5B3DF5" />
      <rect x="56" y="72" width="6" height="6" rx="1" fill="#0F172A" />

      <rect x="72" y="36" width="6" height="6" rx="1" fill="#0F172A" />
      <rect x="82" y="36" width="6" height="6" rx="1" fill="#0E8A8A" />
      
      <rect x="72" y="48" width="6" height="6" rx="1" fill="#5B3DF5" />
      <rect x="82" y="48" width="6" height="6" rx="1" fill="#0F172A" />

      <rect x="68" y="68" width="8" height="8" rx="2" fill="#0F172A" />
      <rect x="80" y="68" width="8" height="8" rx="2" fill="#5B3DF5" />
      <rect x="68" y="80" width="8" height="8" rx="2" fill="#0E8A8A" />
      <rect x="80" y="80" width="8" height="8" rx="2" fill="#0F172A" />
    </svg>
  </div>

  <p class="text-[11px] text-slate-500 max-w-[200px] leading-relaxed">
    Scan with your phone to access contact links directly on mobile.
  </p>

  <!-- Download vCard Action -->
  <a
    href={`${base}/vcard.vcf`}
    download="Rajnish_Singh.vcf"
    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors"
  >
    <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
    <span>Download vCard (.vcf)</span>
  </a>
</div>
