---
import IconTile from './IconTile.astro';
import type { Topic } from '../../data/topics';

interface Props {
  category: {
    id: string;
    name: string;
    nameEn?: string;
    benefit: string;
    benefitEn?: string;
  };
  topics: Topic[];
  locale?: 'hi' | 'en';
}

const { category, topics, locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const isHindi = locale === 'hi';
const isEmpty = topics.length === 0;

// Pluralization
const countLabel = isEmpty
  ? (isHindi ? 'जल्द' : 'Soon')
  : isHindi
    ? (topics.length === 1 ? '1 गाइड' : `${topics.length} गाइड`)
    : (topics.length === 1 ? '1 guide' : `${topics.length} guides`);

const categoryName = isHindi ? category.name : (category.nameEn || category.name);
const categoryBenefit = isHindi ? category.benefit : (category.benefitEn || category.benefit);
const topTopicsLabel = isHindi ? 'प्रमुख विषय:' : 'Top topics:';
const ctaLabel = isHindi ? 'विषय देखें' : 'Explore domain';
---

{isEmpty ? (
  <!-- Empty-State Card Variant (Dashed Border, Muted Tint, Honest Progress) -->
  <div
    class="domain-card empty-card group relative p-6 rounded-2xl bg-slate-50/60 dark:bg-darkcard/40 border-2 border-dashed border-slate-300/80 dark:border-slate-700/80 flex flex-col justify-between h-full transition-all"
    data-category={category.id}
    data-empty="true"
  >
    <div>
      <div class="flex items-center justify-between mb-4">
        <IconTile category={category.id} className="opacity-60" />
        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-300/50 dark:border-white/10">
          {countLabel}
        </span>
      </div>

      <h3 class="font-bold text-lg text-slate-800 dark:text-slate-200">
        {categoryName}
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
        {categoryBenefit}
      </p>

      <div class="mt-5 p-3.5 rounded-xl bg-slate-100/80 dark:bg-slate-800/50 border border-slate-200/60 dark:border-white/5">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>{isHindi ? 'जल्द आ रहा है' : 'Coming Soon'}</span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">
          {isHindi ? 'इस विषय पर शोध और लेखन जारी है।' : 'Research and development in progress for this domain.'}
        </p>
      </div>
    </div>

    <div class="mt-6 pt-3 border-t border-slate-200/60 dark:border-slate-800/80 flex items-center justify-between text-xs">
      <a
        href="https://github.com/givemehat/knowledge-hub/issues/new?title=Topic+Suggestion"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1"
      >
        <span>{isHindi ? 'विषय सुझाएँ' : 'Suggest topic'}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
  </div>
) : (
  <!-- Standard Equal-Height Card Variant -->
  <div
    class="domain-card group relative p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/90 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 hover:shadow-apple-md hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between h-full overflow-hidden"
    data-category={category.id}
    data-empty="false"
  >
    <div>
      <!-- Row 1: 56px Icon Tile + Plural Count Pill -->
      <div class="flex items-center justify-between mb-4">
        <IconTile category={category.id} />
        <span class="count-pill text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 shadow-2xs font-mono">
          {countLabel}
        </span>
      </div>

      <!-- Row 2: Title & Benefit Description -->
      <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
        {categoryName}
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
        {categoryBenefit}
      </p>

      <!-- Row 3: Top Topics (Max 3 Rows, 44px Touch Target, No Mid-Word Truncation) -->
      <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
          {topTopicsLabel}
        </span>
        <ul class="space-y-1">
          {topics.slice(0, 3).map(topic => {
            const displayTitle = isHindi ? (topic.shortTitle || topic.title) : (topic.shortTitleEn || topic.shortTitle || topic.title);
            return (
              <li>
                <a
                  href={`${base}/topics/${topic.slug}/`}
                  class="topic-row min-h-[42px] px-2.5 py-1.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/70 border border-transparent hover:border-slate-200/60 dark:hover:border-white/5 transition-all flex items-center justify-between group/link"
                >
                  <div class="flex items-center gap-2 min-w-0 pr-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    <span class="text-xs font-medium text-slate-700 dark:text-slate-300 group-hover/link:text-brand-600 dark:group-hover/link:text-white truncate">
                      {displayTitle}
                    </span>
                  </div>

                  <div class="flex items-center gap-1.5 shrink-0 text-slate-400 group-hover/link:text-slate-600 dark:group-hover/link:text-slate-200 text-[10px]">
                    <span class="font-mono">{topic.readingMinutes} {isHindi ? 'मि' : 'm'}</span>
                    <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    <!-- Row 4: Single Clear Primary Footer CTA -->
    <div class="mt-5 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
      <a
        href={`${base}/topics/?category=${category.id}`}
        class="card-cta font-bold text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 flex items-center gap-1.5 group-hover:translate-x-0.5 transition-transform"
      >
        <span>{ctaLabel}</span>
        <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
)}
