---
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import InsetPanel from '../ui/InsetPanel.astro';
import CardFooter from '../ui/CardFooter.astro';
import Button from '../ui/Button.astro';
import { BRAND } from '../../config/brand';
import IconTile from './IconTile.astro';
import type { Topic } from '../../data/topics';
import { t, localized, formatReadingTime, formatGuidesCount, type Locale } from '../../i18n';

interface Props {
  category: {
    id: string;
    name: string;
    nameEn?: string;
    benefit: string;
    benefitEn?: string;
  };
  topics: Topic[];
  locale?: Locale;
}

const { category, topics, locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const isHindi = locale === 'hi';
const isEmpty = topics.length === 0;

// Pluralization & Localized strings via i18n helpers
const countLabel = isEmpty
  ? t(locale, 'domains.comingSoonCount')
  : formatGuidesCount(topics.length, locale);

const categoryName = isHindi ? category.name : (category.nameEn || category.name);
const categoryBenefit = isHindi ? category.benefit : (category.benefitEn || category.benefit);
const topTopicsLabel = t(locale, 'domains.topTopics');
const ctaLabel = t(locale, 'domains.cardCta');
const suggestLabel = t(locale, 'domains.suggestTopicBtn');
const comingSoonBadge = t(locale, 'domains.comingSoonBadge');
const comingSoonText = t(locale, 'domains.comingSoonNotice');
const fallbackNotice = t(locale, 'domains.fallbackBadge');
---

{isEmpty ? (
  <!-- Empty-State Card Variant (Dashed Border, Shared Card DNA) -->
  <Card
    variant="dashed"
    class="domain-card empty-card"
    data-category={category.id}
    data-empty="true"
  >
    <div>
      <!-- Row 1: 56px Icon Tile + Plural Count Pill (Single count) -->
      <div class="flex items-center justify-between mb-4">
        <IconTile category={category.id} />
        <Chip variant="neutral" size="sm" class="count-pill">
          {countLabel}
        </Chip>
      </div>

      <!-- Row 2: Title & Benefit -->
      <h3 class="font-bold text-lg text-slate-800 dark:text-slate-200">
        {categoryName}
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
        {categoryBenefit}
      </p>

      <!-- Row 3: InsetPanel Honest Progress -->
      <InsetPanel variant="warning" label={comingSoonBadge} class="mt-4">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          {comingSoonText}
        </p>
      </InsetPanel>
    </div>

    <!-- Row 4: Pinned Footer (No duplicate count) -->
    <CardFooter>
      <span slot="meta" class="text-xs text-slate-400 font-medium">{BRAND.name} Labs</span>
      <div slot="action">
        <Button
          href="https://github.com/givemehat/knowledge-hub/issues/new?title=Topic+Suggestion"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="sm"
          icon="external"
        >
          <span>{suggestLabel}</span>
        </Button>
      </div>
    </CardFooter>
  </Card>
) : (
  <!-- Standard Equal-Height Card Variant -->
  <Card
    variant="default"
    class="domain-card"
    data-category={category.id}
    data-empty="false"
  >
    <div>
      <!-- Row 1: 56px Icon Tile + Plural Count Pill (Single source of count) -->
      <div class="flex items-center justify-between mb-4">
        <IconTile category={category.id} />
        <Chip variant="category" size="sm" class="count-pill">
          {countLabel}
        </Chip>
      </div>

      <!-- Row 2: Title & Benefit Description -->
      <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
        {categoryName}
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
        {categoryBenefit}
      </p>

      <!-- Row 3: InsetPanel "Top topics" (Max 3 Rows, 44px Touch Target, No Mid-Word Truncation) -->
      <InsetPanel variant="top-topics" label={topTopicsLabel} class="mt-4">
        <ul class="space-y-1 mt-1">
          {topics.slice(0, 3).map(topic => {
            const titleObj = {
              en: topic.shortTitleEn || (typeof topic.shortTitle === 'object' ? topic.shortTitle.en : undefined),
              hi: (typeof topic.shortTitle === 'object' ? topic.shortTitle.hi : topic.shortTitle) || topic.title
            };
            const { text: displayTitle, isFallback } = localized(titleObj, locale);
            const readingTimeStr = formatReadingTime(topic.readingMinutes, locale);

            return (
              <li>
                <a
                  href={`${base}/topics/${topic.slug}/`}
                  class="topic-row min-h-[40px] px-2.5 py-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-800/80 border border-transparent hover:border-slate-200/60 dark:hover:border-white/5 transition-all flex items-center justify-between group/link"
                >
                  <div class="flex items-center gap-2 min-w-0 pr-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shrink-0"></span>
                    <span class="text-xs font-medium text-slate-700 dark:text-slate-300 group-hover/link:text-brand-600 dark:group-hover/link:text-white truncate">
                      {displayTitle}
                    </span>
                    {isFallback && (
                      <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-medium shrink-0">
                        {fallbackNotice}
                      </span>
                    )}
                  </div>

                  <div class="flex items-center gap-1 shrink-0 text-slate-400 group-hover/link:text-slate-600 dark:group-hover/link:text-slate-200 text-[10px] font-mono tabular-nums">
                    <span>{readingTimeStr}</span>
                    <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </InsetPanel>
    </div>

    <!-- Row 4: Single Clear Primary Footer CTA (Duplicate count removed per Prompt 11) -->
    <CardFooter>
      <div slot="action" class="w-full flex justify-end">
        <Button
          href={`${base}/${locale}/topics/?category=${category.id}`}
          variant="primary"
          size="sm"
          icon="arrow"
          class="card-cta"
        >
          <span>{ctaLabel}</span>
        </Button>
      </div>
    </CardFooter>
  </Card>
)}
