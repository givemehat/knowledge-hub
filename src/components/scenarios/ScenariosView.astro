---
import Layout from '../../layouts/Layout.astro';
import { SCENARIOS } from '../../data/scenarios';
import { BRAND } from '../../config/brand';
import { formatReadingTime, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

const ui = {
  en: {
    title: `Hypothetical Scenario Analysis — ${BRAND.name}`,
    desc: "Rigorous, research-grounded scenario planning and futures studies across geopolitics, AI, and macroeconomic systems.",
    badgeTag: "HYPOTHETICAL SCENARIOS ONLY",
    protocolBadge: "• Fact vs Hypothesis Protocol",
    disclaimer: "All articles in this section are hypothetical future scenarios (Futures-Studies / Red-Teaming). They are NOT breaking news, predictions, or current events. Their sole purpose is to stress-test critical systems against empirical historical data and academic literature.",
    protocolLink: "Read our Fact vs Hypothesis protocol ↗",
    eyebrow: "Futures Studies & Strategic Wargaming",
    heading: "Hypothetical Scenario Analysis",
    subtext: "What unfolds if a vital maritime chokepoint closes, AI deepfakes drop 36 hours before a national election, or core banking clouds suffer catastrophic outage? Explore causal logic trees, historical evidence, and best/base/worst-case resilience outcomes.",
    hypoCorner: "HYPOTHETICAL",
    readModel: "Read Scenario Model",
    methodTag: "Empirical Causal Chain"
  },
  hi: {
    title: `काल्पनिक परिदृश्य विश्लेषण — ${BRAND.name} (${BRAND.nameHi})`,
    desc: "भू-राजनीति, एआई और अर्थव्यवस्था पर गहन शोध-आधारित काल्पनिक परिदृश्य और रेड-टीमिंग विश्लेषण।",
    badgeTag: "केवल काल्पनिक परिदृश्य",
    protocolBadge: "• तथ्य बनाम परिकल्पना प्रोटोकॉल",
    disclaimer: "इस अनुभाग के सभी लेख काल्पनिक परिदृश्य विश्लेषण (Futures-Studies / Red-Teaming) हैं। ये कोई वास्तविक समाचार, भविष्यवाणियां या ब्रेकिंग इवेंट्स नहीं हैं। इनका उद्देश्य वास्तविक ऐतिहासिक आंकड़ों और शोध पत्रों के आधार पर महत्वपूर्ण प्रणालियों की संवेदनशीलता को समझना है।",
    protocolLink: "हमारा तथ्य बनाम परिकल्पना प्रोटोकॉल पढ़ें ↗",
    eyebrow: "फ़्यूचर्स स्टडीज़ और रणनीतिक वॉरगेमिंग",
    heading: "काल्पनिक परिदृश्य विश्लेषण",
    subtext: "अगर कोई बड़ा चोकपॉइंट बंद हो जाए, एआई डीपफेक्स चुनाव से 36 घंटे पहले गिरें, या कोर बैंकिंग क्लाउड आउटेज हो? जानिए इनके कॉज़ल चेन्स, ऐतिहासिक साक्ष्य, और बेस्ट/बेस/वर्स्ट केस आउटकम्स।",
    hypoCorner: "काल्पनिक",
    readModel: "परिदृश्य मॉडल पढ़ें",
    methodTag: "कॉज़ल चेन मॉडल"
  }
};

const text = isHindi ? ui.hi : ui.en;
---

<Layout title={text.title} description={text.desc} lang={locale}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Epistemological Disclaimer Banner -->
    <div class="mb-10 p-5 rounded-2xl bg-saffron-500/10 border-2 border-saffron-500/30 flex items-start gap-4">
      <div class="p-2.5 rounded-xl bg-saffron-500/20 text-saffron-600 dark:text-saffron-400 font-bold shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-black uppercase tracking-wider px-2 py-0.5 rounded bg-saffron-500 text-slate-950">
            {text.badgeTag}
          </span>
          <span class={`text-xs text-saffron-700 dark:text-saffron-300 font-semibold ${isHindi ? 'font-hindi' : ''}`}>{text.protocolBadge}</span>
        </div>
        <p class={`text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
          {text.disclaimer}
          <a href={`${base}/${locale}/research/fact-vs-hypothesis/`} class="text-saffron-600 dark:text-saffron-400 font-bold underline ml-1 hover:text-saffron-500">
            {text.protocolLink}
          </a>
        </p>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-darkcard border border-slate-300/60 dark:border-white/10 text-xs font-bold text-slate-700 dark:text-slate-300 mb-4">
        <svg class="w-3.5 h-3.5 text-saffron-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
        <span>{text.eyebrow}</span>
      </div>
      <h1 class={`text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4 ${isHindi ? 'font-hindi' : ''}`}>
        {text.heading}
      </h1>
      <p class={`text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed ${isHindi ? 'font-hindi' : ''}`}>
        {text.subtext}
      </p>
    </div>

    <!-- Scenarios Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {SCENARIOS.map(sc => (
        <a 
          href={`${base}/scenarios/${sc.slug}/`}
          class="group flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-darkcard border-2 border-slate-200 dark:border-darkborder hover:border-amber-500/80 transition-all shadow-sm hover:shadow-xl relative overflow-hidden"
        >
          <!-- Corner Badge -->
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 font-black text-[9px] uppercase tracking-wider px-3 py-1 rounded-bl-xl">
            {text.hypoCorner}
          </div>

          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {sc.domainLabel}
              </span>
              <span class="text-xs text-slate-400">• {formatReadingTime(sc.readingMinutes, locale)}</span>
            </div>

            <h2 class={`text-lg sm:text-xl font-black text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug mb-2 ${isHindi ? 'font-hindi' : ''}`}>
              {isHindi && sc.titleHindi ? sc.titleHindi : sc.title}
            </h2>

            <p class={`text-xs text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed mb-6 ${isHindi ? 'font-hindi' : ''}`}>
              {isHindi ? sc.abstract : (sc.abstractEn || sc.abstract)}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-darkborder flex items-center justify-between text-xs font-bold text-amber-600 dark:text-amber-400">
            <span>{text.readModel}</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
