---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/75 dark:bg-darkbg/75 border-b border-slate-200/80 dark:border-white/10 transition-colors duration-200 shadow-apple-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-violet-600 via-indigo-600 to-teal-500 flex items-center justify-center text-white font-bold shadow-md shadow-violet-500/20 group-hover:scale-105 transition-transform relative overflow-hidden">
        <!-- Indian Jaali Micro Pattern Overlay -->
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-lg text-slate-900 dark:text-white tracking-tight">Knowledge<span class="text-violet-600 dark:text-violet-400">Hub</span></span>
          <span class="font-hindi text-xs text-slate-400 font-medium hidden lg:inline">ज्ञान केंद्र</span>
        </div>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
      <a 
        href={`${base}/topics/`} 
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.includes('/topics') ? 'bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-300' : 'hover:text-violet-600 dark:hover:text-white'}`}
      >
        Topics
      </a>
      <a 
        href={`${base}/roadmaps/`} 
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.includes('/roadmaps') ? 'bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-300' : 'hover:text-violet-600 dark:hover:text-white'}`}
      >
        Roadmaps
      </a>
      <a 
        href={`${base}/scenarios/`} 
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.includes('/scenarios') ? 'bg-saffron-50 dark:bg-saffron-950/60 text-saffron-600 dark:text-saffron-300' : 'hover:text-saffron-600 dark:hover:text-white'}`}
      >
        Scenarios
      </a>
      <a 
        href={`${base}/research/`} 
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.includes('/research') ? 'bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-300' : 'hover:text-teal-600 dark:hover:text-white'}`}
      >
        Research
      </a>
      <a 
        href={`${base}/resources/`} 
        class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.includes('/resources') ? 'bg-violet-50 dark:bg-violet-950/60 text-violet-600 dark:text-violet-300' : 'hover:text-violet-600 dark:hover:text-white'}`}
      >
        Resources
      </a>
    </nav>

    <!-- Search Button & Control Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Command Palette Trigger -->
      <button 
        type="button" 
        id="open-search-btn"
        class="flex items-center gap-2.5 px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-slate-700/60 transition-all cursor-pointer shadow-apple-sm active:scale-98"
        aria-label="Search knowledge base"
      >
        <!-- Lucide Search Icon -->
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="8" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35"/>
        </svg>
        <span class="hidden sm:inline">Search...</span>
        <kbd class="hidden sm:inline-block font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-700 shadow-sm text-slate-500">⌘K</kbd>
      </button>

      <!-- Language Toggle Pill -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="px-2.5 py-1.5 text-xs font-bold rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700/60 transition-all cursor-pointer active:scale-95"
        title="Toggle Hinglish / English explanations"
      >
        <span id="lang-label">हिन्दी / Hinglish</span>
      </button>

      <!-- Theme Mode Toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/60 transition-all cursor-pointer active:scale-95"
        aria-label="Toggle dark mode"
      >
        <!-- Lucide Sun (Light) -->
        <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="4" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Lucide Moon (Dark) -->
        <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</header>
