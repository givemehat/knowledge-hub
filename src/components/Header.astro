---
import { BRAND } from '../config/brand';
import { t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'hi' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHindi = locale === 'hi';

const navLinks = [
  { label: t(locale, 'nav.topics'), href: `${base}/${locale}/topics/`, match: '/topics' },
  { label: t(locale, 'nav.roadmaps'), href: `${base}/${locale}/roadmaps/`, match: '/roadmaps' },
  { label: t(locale, 'nav.scenarios'), href: `${base}/${locale}/scenarios/`, match: '/scenarios' },
  { label: t(locale, 'nav.research'), href: `${base}/${locale}/research/`, match: '/research' },
  { label: t(locale, 'nav.resources'), href: `${base}/${locale}/resources/`, match: '/resources' },
  { label: t(locale, 'nav.about'), href: `${base}/${locale}/about/`, match: '/about' },
];

// Calculate equivalent route in other locale for seamless navigation toggle
function getTargetLocaleUrl(target: Locale): string {
  const pathWithoutBase = currentPath.startsWith(base) ? currentPath.slice(base.length) : currentPath;

  let cleanPath = pathWithoutBase;
  if (cleanPath.startsWith('/en/')) {
    cleanPath = cleanPath.slice(3);
  } else if (cleanPath.startsWith('/hi/')) {
    cleanPath = cleanPath.slice(3);
  } else if (cleanPath === '/en' || cleanPath === '/hi') {
    cleanPath = '/';
  }

  if (!cleanPath.startsWith('/')) {
    cleanPath = '/' + cleanPath;
  }

  return `${base}/${target}${cleanPath === '/' ? '/' : cleanPath}`;
}

const enUrl = getTargetLocaleUrl('en');
const hiUrl = getTargetLocaleUrl('hi');
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/85 dark:bg-[#121016]/85 border-b border-slate-200/80 dark:border-white/[0.08] transition-colors duration-200 shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Clean, Aligned Logo Lockup (Original Peach Mark, Baseline-Aligned) -->
    <a
      id="header-logo"
      href={`${base}/${locale}/`}
      class="flex items-center gap-2.5 group shrink-0"
      aria-label={isHindi ? `${BRAND.name} (${BRAND.nameHi}) होम` : `${BRAND.name} Home`}
    >
      <!-- Original Peach Geometric SVG Mark (Round Body + Cleft + Bookmark Leaf + Knowledge Node) -->
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-peach-500 via-coral-500 to-brand-500 p-0.5 shadow-md shadow-peach-500/20 group-hover:scale-105 transition-transform flex items-center justify-center shrink-0">
        <svg class="w-full h-full" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="peach-logo-grad" x1="8" y1="6" x2="28" y2="31" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#FFB396"/>
              <stop offset="45%" stop-color="#FF7A59"/>
              <stop offset="100%" stop-color="#DE4321"/>
            </linearGradient>
            <linearGradient id="peach-leaf-grad" x1="18" y1="3" x2="28" y2="9" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#10B981"/>
              <stop offset="60%" stop-color="#0E8A8A"/>
              <stop offset="100%" stop-color="#5B3DF5"/>
            </linearGradient>
          </defs>
          <!-- Bookmark Leaf -->
          <path d="M 17.5 8.5 C 19 3.5 25.5 3 28 5 C 28 8.5 23 10.5 17.5 8.5 Z" fill="url(#peach-leaf-grad)"/>
          <path d="M 18.5 8.2 C 21.5 6 25 5.5 27 5.2" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" opacity="0.8"/>
          <!-- Peach Body -->
          <path d="M 18 9.5 C 13.5 6 6 10 6 18 C 6 25.5 12 30.5 18 30.5 C 24 30.5 30 25.5 30 18 C 30 10 22.5 6 18 9.5 Z" fill="url(#peach-logo-grad)"/>
          <!-- Cleft Contour Line -->
          <path d="M 18 9.5 C 18 14 16.8 17 16.8 20" stroke="#FFFFFF" stroke-width="1.3" stroke-linecap="round" opacity="0.45"/>
          <!-- Central Knowledge Node -->
          <circle cx="18" cy="22" r="1.5" fill="#FFFFFF" opacity="0.95"/>
          <circle cx="18" cy="22" r="2.4" stroke="#5B3DF5" stroke-width="0.6" stroke-opacity="0.5"/>
        </svg>
      </div>

      <div class="flex items-baseline gap-1.5">
        <span id="header-brand-name" class="font-black text-xl text-slate-900 dark:text-white tracking-tight leading-none">{BRAND.name}</span>
        <span id="header-brand-hi" lang="hi" class="font-hindi text-xs font-semibold text-peach-600 dark:text-peach-400 tracking-normal opacity-90 leading-none">{BRAND.nameHi}</span>
      </div>
    </a>

    <!-- Desktop Nav Links with Active/Hover Indicators -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300">
      {navLinks.map(link => {
        const isActive = currentPath.startsWith(link.href) || (link.match && currentPath.includes(link.match));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg transition-all duration-150 ${
              isActive
                ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-xs'
                : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Compact Search + Navigational Language Control + Theme Mode -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      
      <!-- Header Search Control -->
      <button 
        type="button" 
        id="open-search-btn"
        class="flex items-center gap-2 p-2 sm:px-3 sm:py-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-100/90 hover:bg-slate-200/80 dark:bg-slate-800/70 dark:hover:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all cursor-pointer shadow-xs active:scale-95 group"
        aria-label={isHindi ? "विषय या गाइड खोजें" : "Search topics, roadmaps, or guides"}
        title={isHindi ? "खोजें" : "Quick Search"}
      >
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <span id="header-search-label" class="hidden font-medium text-slate-600 dark:text-slate-300">{t(locale, 'hero.searchLabel')}</span>
        <kbd id="header-search-kbd" class="os-shortcut-hint hidden font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-700 text-slate-500 dark:text-slate-400 shadow-xs">⌘K</kbd>
      </button>

      <!-- Language Segmented Control: [ EN | HI ] with Route Navigation -->
      <div 
        id="lang-segmented-control" 
        class="inline-flex p-0.5 rounded-xl bg-slate-100/90 dark:bg-slate-800/80 border border-slate-200/80 dark:border-white/10 text-xs font-bold"
        role="group"
        aria-label={isHindi ? "भाषा चुनें" : "Select language"}
      >
        <button
          type="button"
          data-lang="en"
          data-url={enUrl}
          class={`lang-btn px-2.5 py-1 rounded-lg transition-all text-[11px] font-semibold cursor-pointer ${
            !isHindi
              ? 'active bg-white dark:bg-white/15 text-slate-900 dark:text-white shadow-xs font-bold'
              : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
          }`}
          aria-label="English mode"
          aria-pressed={!isHindi ? "true" : "false"}
        >
          EN
        </button>
        <button
          type="button"
          data-lang="hi"
          data-url={hiUrl}
          class={`lang-btn px-2.5 py-1 rounded-lg transition-all text-[11px] font-hindi cursor-pointer ${
            isHindi
              ? 'active bg-white dark:bg-white/15 text-slate-900 dark:text-white shadow-xs font-bold'
              : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-semibold'
          }`}
          aria-label="Hindi mode"
          aria-pressed={isHindi ? "true" : "false"}
        >
          हिं
        </button>
      </div>

      <!-- Theme Mode Toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-xl bg-slate-100/90 hover:bg-slate-200 dark:bg-slate-800/70 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/20 transition-all cursor-pointer active:scale-95"
        aria-label={isHindi ? "डार्क मोड बदलें" : "Toggle dark mode"}
      >
        <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Detect OS for accurate shortcut hint (⌘K for Mac, Ctrl K for Windows/Linux)
  (function initShortcutHint() {
    const ua = (typeof navigator !== 'undefined' ? navigator.userAgent : '') || '';
    const platform = (typeof navigator !== 'undefined' ? navigator.platform : '') || '';
    const isWindowsOrLinux = /Windows|Win32|Win64|Linux|X11|Android/i.test(ua) || /Win/i.test(platform);
    const isMac = !isWindowsOrLinux && (/Mac|iPod|iPhone|iPad/i.test(platform) || /Mac/i.test(ua));
    const label = isMac ? '⌘K' : 'Ctrl K';
    document.querySelectorAll('.os-shortcut-hint').forEach(el => {
      el.textContent = label;
    });
  })();

  // Store user language preference and navigate when clicking toggle
  (function initLanguagePreference() {
    const control = document.getElementById('lang-segmented-control');
    if (!control) return;
    control.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.dataset.lang;
        const targetUrl = btn.dataset.url;
        if (lang) {
          localStorage.setItem('peach_preferred_lang', lang);
        }
        if (targetUrl) {
          window.location.href = targetUrl;
        }
      });
    });
  })();

  // Header Search Scroll Observer: Expands header search after hero search leaves view
  function initHeaderSearchObserver() {
    const heroSearch = document.getElementById('hero-primary-search');
    const headerLabel = document.getElementById('header-search-label');
    const headerKbd = document.getElementById('header-search-kbd');
    if (!heroSearch || !headerLabel || !headerKbd) return;

    function evaluateSearchPosition() {
      const rect = heroSearch.getBoundingClientRect();
      const isPast = rect.bottom < 64; // hero search is scrolled above 64px header
      if (isPast) {
        headerLabel.classList.remove('hidden');
        headerLabel.classList.add('sm:inline');
        headerKbd.classList.remove('hidden');
        headerKbd.classList.add('sm:inline-block');
      } else {
        headerLabel.classList.add('hidden');
        headerLabel.classList.remove('sm:inline');
        headerKbd.classList.add('hidden');
        headerKbd.classList.remove('sm:inline-block');
      }
    }

    window.addEventListener('scroll', evaluateSearchPosition, { passive: true });
    window.addEventListener('resize', evaluateSearchPosition, { passive: true });
    evaluateSearchPosition();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderSearchObserver);
  } else {
    initHeaderSearchObserver();
  }
</script>
