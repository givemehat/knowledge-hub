---
import CreatorChip from './creator/CreatorChip.astro';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { label: 'Topics', href: `${base}/topics/`, match: '/topics' },
  { label: 'Roadmaps', href: `${base}/roadmaps/`, match: '/roadmaps' },
  { label: 'Scenarios', href: `${base}/scenarios/`, match: '/scenarios' },
  { label: 'Research', href: `${base}/research/`, match: '/research' },
  { label: 'Resources', href: `${base}/resources/`, match: '/resources' },
  { label: 'About', href: `${base}/about/`, match: '/about' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/80 dark:bg-[#121016]/80 border-b border-slate-200/80 dark:border-white/10 transition-colors duration-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-3">
    <!-- Brand Logo: Bodh (बोध) - Baseline-Aligned Lockup -->
    <a href={`${base}/`} class="flex items-center gap-2 sm:gap-2.5 group shrink-0" aria-label="Bodh Home">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-brand-600 via-indigo-600 to-peacock-500 flex items-center justify-center text-white font-bold shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform relative overflow-hidden">
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <span class="absolute top-1 right-1 w-1.5 h-1.5 rounded-full bg-saffron-500 ring-2 ring-brand-600"></span>
      </div>
      <div class="flex items-baseline gap-1 sm:gap-1.5">
        <span class="font-black text-lg sm:text-xl text-slate-900 dark:text-white tracking-tight">Bodh</span>
        <span class="font-hindi text-[11px] sm:text-xs font-bold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/70 border border-brand-500/20 px-1 sm:px-1.5 py-0.5 rounded leading-none">बोध</span>
        <span class="text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200/70 dark:border-white/10 hidden lg:inline-block leading-none">v2.0</span>
      </div>
    </a>

    <!-- Desktop Nav Links with Active/Hover Indicators -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300">
      {navLinks.map(link => {
        const isActive = currentPath.startsWith(link.href) || (link.match && currentPath.includes(link.match));
        return (
          <a
            href={link.href}
            class={`px-2.5 lg:px-3 py-1.5 rounded-lg transition-all duration-150 ${
              isActive
                ? 'bg-brand-50 dark:bg-brand-950/70 text-brand-600 dark:text-brand-300 font-bold shadow-xs'
                : 'hover:text-brand-600 dark:hover:text-white hover:bg-slate-100/60 dark:hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Compact Search + Segmented Language Control + Theme Mode -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      <!-- Creator Chip (Desktop Only) -->
      <div class="hidden xl:block">
        <CreatorChip variant="minimal" />
      </div>

      <!-- Compact Search Button (Icon only on tiny screens, text on sm+) -->
      <button 
        type="button" 
        id="open-search-btn"
        class="flex items-center gap-2 p-2 sm:px-3 sm:py-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shadow-xs active:scale-95"
        aria-label="Search knowledge base"
      >
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="hidden sm:inline font-medium">Search</span>
        <kbd class="os-shortcut-hint hidden sm:inline-block font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-700 text-slate-500 dark:text-slate-400 shadow-xs">⌘K</kbd>
      </button>

      <!-- Language Segmented Control: [ EN | हिं ] -->
      <div 
        id="lang-segmented-control" 
        class="inline-flex p-0.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 text-xs font-bold"
        role="group"
        aria-label="Language selection"
      >
        <button
          type="button"
          data-lang="en"
          class="lang-btn px-2 sm:px-2.5 py-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer text-[10px] sm:text-[11px]"
        >
          EN
        </button>
        <button
          type="button"
          data-lang="hi"
          class="lang-btn active px-2 sm:px-2.5 py-1 rounded-lg bg-white dark:bg-brand-600 text-brand-600 dark:text-white shadow-xs transition-all cursor-pointer text-[10px] sm:text-[11px] font-hindi"
        >
          हिं
        </button>
      </div>

      <!-- Theme Mode Toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer active:scale-95"
        aria-label="Toggle dark mode"
      >
        <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function initShortcutHint() {
    const isMac = typeof navigator !== 'undefined' && /Mac|iPod|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    const label = isMac ? '⌘K' : 'Ctrl K';
    document.querySelectorAll('.os-shortcut-hint').forEach(el => {
      el.textContent = label;
    });
  })();

  (function initLanguageToggle() {
    const control = document.getElementById('lang-segmented-control');
    if (!control) return;

    const savedLang = localStorage.getItem('bodh_preferred_lang') || 'hi';
    updateActiveButton(savedLang);

    control.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedLang = btn.dataset.lang;
        localStorage.setItem('bodh_preferred_lang', selectedLang);
        updateActiveButton(selectedLang);
        window.dispatchEvent(new CustomEvent('bodh:lang-change', { detail: { lang: selectedLang } }));
      });
    });

    function updateActiveButton(lang) {
      control.querySelectorAll('.lang-btn').forEach(b => {
        if (b.dataset.lang === lang) {
          b.className = 'lang-btn active px-2 sm:px-2.5 py-1 rounded-lg bg-white dark:bg-brand-600 text-brand-600 dark:text-white shadow-xs transition-all cursor-pointer text-[10px] sm:text-[11px] font-bold ' + (lang === 'hi' ? 'font-hindi' : '');
        } else {
          b.className = 'lang-btn px-2 sm:px-2.5 py-1 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer text-[10px] sm:text-[11px] font-bold';
        }
      });
    }
  })();
</script>
