---
import type { Roadmap } from '../data/roadmaps';

interface Props {
  roadmap: Roadmap;
}

const { roadmap } = Astro.props;
---

<div class="roadmap-container max-w-5xl mx-auto" data-roadmap-id={roadmap.slug}>
  <!-- Roadmap Progress Hero Card -->
  <div class="bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 rounded-3xl p-6 sm:p-8 mb-8 shadow-card relative overflow-hidden">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-brand-300 border border-brand-500/20">
            <svg class="w-3 h-3 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            {roadmap.difficulty}
          </span>
          <span class="text-xs text-slate-400 font-medium">• ~{roadmap.estimatedWeeks} Weeks Estimated</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">{roadmap.title}</h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-xl leading-relaxed">{roadmap.subtitle}</p>
      </div>

      <!-- Live Progress Gauge -->
      <div class="flex items-center gap-4 bg-slate-50 dark:bg-slate-900/60 p-4 rounded-2xl border border-slate-200 dark:border-white/10 shrink-0 shadow-sm">
        <div class="relative w-16 h-16 flex items-center justify-center">
          <svg class="w-16 h-16 transform -rotate-90">
            <circle cx="32" cy="32" r="26" stroke="currentColor" stroke-width="5" class="text-slate-200 dark:text-slate-800" fill="transparent" />
            <circle id="progress-circle" cx="32" cy="32" r="26" stroke="currentColor" stroke-width="5" class="text-brand-500 transition-all duration-500 ease-out" stroke-dasharray="163.36" stroke-dashoffset="163.36" stroke-linecap="round" fill="transparent" />
          </svg>
          <span id="progress-text" class="absolute font-extrabold text-xs text-slate-900 dark:text-white">0%</span>
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900 dark:text-white">Your Progress</div>
          <div id="completed-count" class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">0 of {roadmap.nodes.length} completed</div>
        </div>
      </div>
    </div>

    <!-- Action Toolbar (View Switcher, Filters, Export, Print) -->
    <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-slate-100 dark:border-white/10 text-xs">
      <!-- Left: View Mode Toggle (Path vs Board) -->
      <div class="flex items-center gap-3">
        <div class="inline-flex p-1 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10">
          <button id="view-path-btn" class="view-toggle-btn active flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-darkcard text-slate-900 dark:text-white shadow-sm transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
            <span>Path View</span>
          </button>
          <button id="view-board-btn" class="view-toggle-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
            <span>Board View</span>
          </button>
        </div>

        <!-- Level Filters -->
        <div class="hidden sm:flex items-center gap-1.5" id="level-filters">
          <button class="filter-btn active px-2.5 py-1.5 rounded-lg bg-brand-500 text-white font-medium shadow-sm" data-filter="all">All</button>
          <button class="filter-btn px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-700" data-filter="beginner">Beginner</button>
          <button class="filter-btn px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-700" data-filter="intermediate">Intermediate</button>
          <button class="filter-btn px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-700" data-filter="advanced">Advanced</button>
        </div>
      </div>

      <!-- Right: Export & Print -->
      <div class="flex items-center gap-2">
        <button id="export-checklist-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 transition-colors shadow-sm cursor-pointer">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <span>Export Markdown</span>
        </button>
        <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-darkcard hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 transition-colors shadow-sm cursor-pointer">
          <svg class="w-3.5 h-3.5 text-peacock-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print / PDF</span>
        </button>
      </div>
    </div>
  </div>

  <!-- VIEW 1: PATH VIEW (Default Timeline) -->
  <div id="path-view-container" class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 space-y-8 my-8">
    {roadmap.nodes.map((node, index) => (
      <div 
        class="roadmap-node group relative bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 rounded-2xl p-5 sm:p-6 transition-all hover:border-brand-500/50 hover:shadow-card cursor-pointer"
        data-id={node.id}
        data-level={node.level}
      >
        <!-- Timeline Step Marker Dot -->
        <div class="absolute -left-[35px] sm:-left-[43px] top-6 w-6 h-6 rounded-full bg-white dark:bg-darkbg border-2 border-slate-300 dark:border-slate-700 flex items-center justify-center node-dot transition-colors shadow-sm">
          <span class="text-[10px] font-bold text-slate-500">{index + 1}</span>
        </div>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-grow">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
                node.level === 'beginner' ? 'bg-peacock-500/10 text-peacock-600 dark:text-peacock-400 border border-peacock-500/20' :
                node.level === 'intermediate' ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' :
                'bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20'
              }`}>
                {node.level}
              </span>
              <span class="inline-flex items-center gap-1 text-xs text-slate-400 font-medium">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                ~{node.estimatedHours} Hours
              </span>
              <span class="text-xs text-slate-400 font-medium">• {node.category}</span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {node.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
              {node.description}
            </p>

            <!-- Key topics tags -->
            <div class="flex flex-wrap gap-1.5 mt-3">
              {node.keyTopics.map(topic => (
                <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">
                  {topic}
                </span>
              ))}
            </div>
          </div>

          <!-- Mark As Done Toggle Checkbox -->
          <div class="shrink-0 pt-1">
            <label class="flex items-center gap-2 cursor-pointer select-none" onclick="event.stopPropagation()">
              <input 
                type="checkbox" 
                class="node-checkbox w-5 h-5 rounded border-slate-300 dark:border-slate-700 text-brand-600 focus:ring-brand-500 cursor-pointer transition-colors"
                data-node-id={node.id}
              />
            </label>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- VIEW 2: BOARD VIEW (Kanban: Now / Next / Done) -->
  <div id="board-view-container" class="hidden my-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Column 1: Now (Current Focus) -->
      <div class="bg-slate-50/70 dark:bg-slate-900/40 rounded-2xl p-4 border border-slate-200 dark:border-white/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 dark:border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-saffron-500 animate-pulse"></span>
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900 dark:text-white">Current Focus (Now)</h3>
          </div>
          <span id="board-now-count" class="text-xs font-mono text-slate-400">0</span>
        </div>
        <div id="board-now-list" class="space-y-3 flex-1 min-h-[120px]">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Column 2: Next (Upcoming Queue) -->
      <div class="bg-slate-50/70 dark:bg-slate-900/40 rounded-2xl p-4 border border-slate-200 dark:border-white/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 dark:border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900 dark:text-white">Upcoming (Next)</h3>
          </div>
          <span id="board-next-count" class="text-xs font-mono text-slate-400">0</span>
        </div>
        <div id="board-next-list" class="space-y-3 flex-1 min-h-[120px]">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Column 3: Done (Mastered Milestones) -->
      <div class="bg-slate-50/70 dark:bg-slate-900/40 rounded-2xl p-4 border border-slate-200 dark:border-white/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 dark:border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-peacock-500"></span>
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900 dark:text-white">Mastered (Done)</h3>
          </div>
          <span id="board-done-count" class="text-xs font-mono text-peacock-500 font-bold">0</span>
        </div>
        <div id="board-done-list" class="space-y-3 flex-1 min-h-[120px]">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Modal Drawer -->
  <div id="node-modal" class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-white dark:bg-darkcard w-full max-w-xl rounded-3xl border border-slate-200 dark:border-white/10 shadow-elevation overflow-hidden p-6 sm:p-8 max-h-[85vh] overflow-y-auto">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div>
          <span id="modal-level" class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-500/20"></span>
          <h2 id="modal-title" class="text-xl font-bold text-slate-900 dark:text-white mt-2"></h2>
        </div>
        <button id="close-modal-btn" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <p id="modal-desc" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6"></p>

      <div class="mb-6">
        <h4 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-2.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Key Concepts to Master
        </h4>
        <ul id="modal-topics" class="space-y-2 text-xs text-slate-700 dark:text-slate-300"></ul>
      </div>

      <div class="mb-6 p-4 rounded-2xl bg-peacock-500/10 border border-peacock-500/20">
        <h4 class="text-xs font-bold text-peacock-800 dark:text-peacock-300 mb-1 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-peacock-600 dark:text-peacock-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" /></svg>
          Checkpoint Milestone Task
        </h4>
        <p id="modal-checkpoint" class="text-xs text-peacock-700 dark:text-peacock-300 leading-relaxed"></p>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-2.5 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Recommended Free Resources
        </h4>
        <div id="modal-resources" class="space-y-2"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ nodes: roadmap.nodes, roadmapId: roadmap.slug }}>
  const storageKey = `roadmap_progress_${roadmapId}`;
  let completed = JSON.parse(localStorage.getItem(storageKey) || '[]');

  const checkboxes = document.querySelectorAll('.node-checkbox');
  const progressText = document.getElementById('progress-text');
  const progressCircle = document.getElementById('progress-circle');
  const completedCount = document.getElementById('completed-count');
  const circumference = 2 * Math.PI * 26; // r=26

  function renderBoardView() {
    const nowList = document.getElementById('board-now-list');
    const nextList = document.getElementById('board-next-list');
    const doneList = document.getElementById('board-done-list');
    const nowCount = document.getElementById('board-now-count');
    const nextCount = document.getElementById('board-next-count');
    const doneCount = document.getElementById('board-done-count');

    if (!nowList || !nextList || !doneList) return;

    nowList.innerHTML = '';
    nextList.innerHTML = '';
    doneList.innerHTML = '';

    const doneNodes = nodes.filter(n => completed.includes(n.id));
    const uncompletedNodes = nodes.filter(n => !completed.includes(n.id));

    // First uncompleted node goes to "Now", rest to "Next"
    const nowNodes = uncompletedNodes.slice(0, 1);
    const nextNodes = uncompletedNodes.slice(1);

    if (nowCount) nowCount.innerText = nowNodes.length.toString();
    if (nextCount) nextCount.innerText = nextNodes.length.toString();
    if (doneCount) doneCount.innerText = doneNodes.length.toString();

    function createMiniCard(n, status) {
      const card = document.createElement('div');
      card.className = 'p-3.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm hover:shadow transition-all text-xs';
      card.innerHTML = `
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
            status === 'done' ? 'bg-peacock-500/10 text-peacock-600 dark:text-peacock-400' :
            status === 'now' ? 'bg-saffron-500/10 text-saffron-600 dark:text-saffron-400' :
            'bg-slate-100 dark:bg-slate-800 text-slate-500'
          }">${n.level}</span>
          <span class="text-[10px] text-slate-400 font-mono">~${n.estimatedHours}h</span>
        </div>
        <h4 class="font-bold text-slate-900 dark:text-white line-clamp-1">${n.title}</h4>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">${n.checkpointTask}</p>
      `;
      return card;
    }

    if (nowNodes.length === 0 && uncompletedNodes.length === 0) {
      nowList.innerHTML = '<div class="text-xs text-peacock-600 dark:text-peacock-400 p-4 text-center font-medium">All tasks completed! Amazing work.</div>';
    } else {
      nowNodes.forEach(n => nowList.appendChild(createMiniCard(n, 'now')));
    }

    if (nextNodes.length === 0) {
      nextList.innerHTML = '<div class="text-xs text-slate-400 p-4 text-center">No more upcoming tasks.</div>';
    } else {
      nextNodes.forEach(n => nextList.appendChild(createMiniCard(n, 'next')));
    }

    if (doneNodes.length === 0) {
      doneList.innerHTML = '<div class="text-xs text-slate-400 p-4 text-center">No completed tasks yet. Check off items in the Path View!</div>';
    } else {
      doneNodes.forEach(n => doneList.appendChild(createMiniCard(n, 'done')));
    }
  }

  function updateProgress(justCompletedNodeId) {
    checkboxes.forEach(cb => {
      const id = cb.getAttribute('data-node-id');
      const isDone = completed.includes(id);
      cb.checked = isDone;

      const nodeCard = cb.closest('.roadmap-node');
      const dot = nodeCard?.querySelector('.node-dot');
      if (isDone) {
        nodeCard?.classList.add('border-peacock-500/60', 'bg-peacock-50/20', 'dark:bg-peacock-950/10');
        if (dot) {
          dot.classList.add('bg-peacock-500', 'border-peacock-500');
          dot.innerHTML = `<svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>`;
        }
      } else {
        nodeCard?.classList.remove('border-peacock-500/60', 'bg-peacock-50/20', 'dark:bg-peacock-950/10');
        if (dot) {
          dot.classList.remove('bg-peacock-500', 'border-peacock-500');
          const index = Array.from(document.querySelectorAll('.roadmap-node')).indexOf(nodeCard);
          dot.innerText = (index + 1).toString();
        }
      }
    });

    const percent = Math.round((completed.length / nodes.length) * 100);
    if (progressText) progressText.innerText = `${percent}%`;
    if (completedCount) completedCount.innerText = `${completed.length} of ${nodes.length} completed`;

    if (progressCircle) {
      const offset = circumference - (percent / 100) * circumference;
      progressCircle.style.strokeDashoffset = offset.toString();
    }

    localStorage.setItem(storageKey, JSON.stringify(completed));
    renderBoardView();

    if (percent === 100 && window.showToast) {
      window.showToast("Congratulations! You've mastered this entire roadmap!", "success");
    } else if (justCompletedNodeId && window.showToast) {
      window.showToast(`Milestone marked complete (${percent}% done)`, "info");
    }
  }

  checkboxes.forEach(cb => {
    cb.addEventListener('change', (e) => {
      const id = e.target.getAttribute('data-node-id');
      if (e.target.checked) {
        if (!completed.includes(id)) completed.push(id);
        updateProgress(id);
      } else {
        completed = completed.filter(x => x !== id);
        updateProgress();
      }
    });
  });

  // Modal interactions
  const modal = document.getElementById('node-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalLevel = document.getElementById('modal-level');
  const modalTopics = document.getElementById('modal-topics');
  const modalCheckpoint = document.getElementById('modal-checkpoint');
  const modalResources = document.getElementById('modal-resources');

  document.querySelectorAll('.roadmap-node').forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-id');
      const node = nodes.find(n => n.id === id);
      if (!node) return;

      modalTitle.innerText = node.title;
      modalDesc.innerText = node.description;
      modalLevel.innerText = `${node.level} • ~${node.estimatedHours} Hours`;
      modalCheckpoint.innerText = node.checkpointTask;

      modalTopics.innerHTML = node.keyTopics.map(t => `<li class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-peacock-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>${t}</span></li>`).join('');
      modalResources.innerHTML = node.recommendedResources.map(r => `
        <a href="${r.url}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs transition-colors border border-slate-100 dark:border-white/5">
          <span class="font-medium text-slate-800 dark:text-slate-200">${r.title}</span>
          <span class="inline-flex items-center gap-1 text-[11px] text-brand-600 dark:text-brand-400 font-bold">
            <span>Free</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </span>
        </a>
      `).join('');

      modal.classList.remove('hidden');
    });
  });

  closeModalBtn?.addEventListener('click', () => modal.classList.add('hidden'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });

  // Level filters
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active', 'bg-brand-500', 'text-white'));
      btn.classList.add('active', 'bg-brand-500', 'text-white');

      const filter = btn.getAttribute('data-filter');
      document.querySelectorAll('.roadmap-node').forEach(card => {
        const level = card.getAttribute('data-level');
        if (filter === 'all' || level === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // View Mode Toggle (Path vs Board)
  const pathBtn = document.getElementById('view-path-btn');
  const boardBtn = document.getElementById('view-board-btn');
  const pathContainer = document.getElementById('path-view-container');
  const boardContainer = document.getElementById('board-view-container');

  pathBtn?.addEventListener('click', () => {
    pathBtn.classList.add('active', 'bg-white', 'dark:bg-darkcard', 'text-slate-900', 'dark:text-white', 'shadow-sm');
    boardBtn.classList.remove('active', 'bg-white', 'dark:bg-darkcard', 'text-slate-900', 'dark:text-white', 'shadow-sm');
    pathContainer?.classList.remove('hidden');
    boardContainer?.classList.add('hidden');
  });

  boardBtn?.addEventListener('click', () => {
    boardBtn.classList.add('active', 'bg-white', 'dark:bg-darkcard', 'text-slate-900', 'dark:text-white', 'shadow-sm');
    pathBtn.classList.remove('active', 'bg-white', 'dark:bg-darkcard', 'text-slate-900', 'dark:text-white', 'shadow-sm');
    pathContainer?.classList.add('hidden');
    boardContainer?.classList.remove('hidden');
    renderBoardView();
  });

  // Export checklist as Markdown text
  const exportBtn = document.getElementById('export-checklist-btn');
  exportBtn?.addEventListener('click', () => {
    let md = `# ${roadmapId.toUpperCase()} Roadmap Progress Checklist\n\n`;
    nodes.forEach(n => {
      const isDone = completed.includes(n.id);
      md += `- [${isDone ? 'x' : ' '}] ${n.title} (~${n.estimatedHours}h)\n  Task: ${n.checkpointTask}\n\n`;
    });

    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${roadmapId}-checklist.md`;
    a.click();
    URL.revokeObjectURL(url);
    if (window.showToast) window.showToast("Roadmap checklist exported successfully!", "success");
  });

  updateProgress();
</script>
