---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-darkcard/95 backdrop-blur-md border-t border-slate-200 dark:border-darkborder px-2 py-2 flex items-center justify-around text-[10px] font-medium text-slate-600 dark:text-slate-400">
  <!-- Home -->
  <a href={`${base}/`} class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${currentPath === `${base}/` || currentPath === `${base}` ? 'text-emerald-500 font-bold' : ''}`}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    <span>Home</span>
  </a>

  <!-- Topics -->
  <a href={`${base}/topics/`} class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${currentPath.includes('/topics') ? 'text-emerald-500 font-bold' : ''}`}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
    </svg>
    <span>Topics</span>
  </a>

  <!-- Roadmaps -->
  <a href={`${base}/roadmaps/`} class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${currentPath.includes('/roadmaps') ? 'text-emerald-500 font-bold' : ''}`}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
    </svg>
    <span>Roadmaps</span>
  </a>

  <!-- Resources -->
  <a href={`${base}/resources/`} class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${currentPath.includes('/resources') ? 'text-emerald-500 font-bold' : ''}`}>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
    </svg>
    <span>Resources</span>
  </a>

  <!-- Search trigger -->
  <button type="button" onclick="document.getElementById('open-search-btn')?.click()" class="flex flex-col items-center gap-1 p-2 rounded-lg text-slate-600 dark:text-slate-400">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span>Search</span>
  </button>
</nav>
