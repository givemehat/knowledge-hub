---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-[#121016]/95 backdrop-blur-md border-t border-slate-200/80 dark:border-white/10 px-3 py-2 flex items-center justify-around text-[10px] font-semibold text-slate-500 dark:text-slate-400">
  <!-- Home -->
  <a
    href={`${base}/`}
    class={`flex flex-col items-center gap-1 p-1.5 rounded-lg transition-colors ${
      currentPath === `${base}/` || currentPath === `${base}` ? 'text-brand-600 dark:text-brand-400 font-bold' : 'hover:text-slate-900 dark:hover:text-white'
    }`}
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span>Home</span>
  </a>

  <!-- Topics -->
  <a
    href={`${base}/topics/`}
    class={`flex flex-col items-center gap-1 p-1.5 rounded-lg transition-colors ${
      currentPath.includes('/topics') ? 'text-brand-600 dark:text-brand-400 font-bold' : 'hover:text-slate-900 dark:hover:text-white'
    }`}
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
      <path d="M6 6h10"/>
      <path d="M6 10h10"/>
    </svg>
    <span>Topics</span>
  </a>

  <!-- Roadmaps -->
  <a
    href={`${base}/roadmaps/`}
    class={`flex flex-col items-center gap-1 p-1.5 rounded-lg transition-colors ${
      currentPath.includes('/roadmaps') ? 'text-brand-600 dark:text-brand-400 font-bold' : 'hover:text-slate-900 dark:hover:text-white'
    }`}
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
      <line x1="9" x2="9" y1="3" y2="18"/>
      <line x1="15" x2="15" y1="6" y2="21"/>
    </svg>
    <span>Roadmaps</span>
  </a>

  <!-- Resources -->
  <a
    href={`${base}/resources/`}
    class={`flex flex-col items-center gap-1 p-1.5 rounded-lg transition-colors ${
      currentPath.includes('/resources') ? 'text-brand-600 dark:text-brand-400 font-bold' : 'hover:text-slate-900 dark:hover:text-white'
    }`}
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>
    </svg>
    <span>Resources</span>
  </a>

  <!-- Search trigger -->
  <button
    type="button"
    onclick="document.getElementById('open-search-btn')?.click()"
    class="flex flex-col items-center gap-1 p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
    aria-label="Search"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>
    <span>Search</span>
  </button>
</nav>
