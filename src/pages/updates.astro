---
import Layout from '../layouts/Layout.astro';
import IndianPattern from '../components/ui/IndianPattern.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import InsetPanel from '../components/ui/InsetPanel.astro';
import CardFooter from '../components/ui/CardFooter.astro';
import Button from '../components/ui/Button.astro';
import { UPDATES } from '../data/updates';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Platform Changelog & Updates — Bodh (बोध)"
  description="बोध के सभी नए विषय, रोडमैप सुधार और डिज़ाइन प्रणाली अपडेट्स का कालानुक्रमिक विवरण।"
  lang="hi"
>
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-12">
    <IndianPattern variant="rangoli" opacity={0.03} />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 text-xs font-semibold mb-4">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>निरंतर विकास एवं सत्यापन</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        प्लेटफ़ॉर्म चेंजलॉग
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        बोध पर प्रकाशित हर गाइड, रोडमैप और तकनीकी तथ्य को निरंतर जाँचा और अद्यतित रखा जाता है।
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Timeline of Cards following Card DNA -->
    <div class="relative pl-6 sm:pl-8 border-l-2 border-brand-500/30 dark:border-brand-500/20 space-y-8">
      {UPDATES.map((update, index) => (
        <div class="relative">
          <!-- Timeline Indicator Dot -->
          <div class="absolute -left-[35px] sm:-left-[43px] top-6 w-6 h-6 rounded-full bg-white dark:bg-darkbg border-2 border-brand-500 flex items-center justify-center shadow-sm z-10">
            <span class="w-2 h-2 rounded-full bg-brand-500"></span>
          </div>

          <Card class="update-card">
            <div>
              <!-- Chip Row: Version on Left, Date on Right -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <Chip variant="neutral" size="sm">
                    {update.version}
                  </Chip>
                  <Chip variant="free" size="sm">
                    {update.typeLabel || update.type}
                  </Chip>
                </div>
                <span class="text-xs font-mono text-slate-400">
                  {update.date}
                </span>
              </div>

              <!-- Title & Summary -->
              <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
                {update.title}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed">
                {update.summary}
              </p>

              <!-- InsetPanel "Changelog Details" -->
              <InsetPanel variant="recommend" label="Key Deliverables & Changes">
                <ul class="space-y-2 mt-1">
                  {update.changes.map(ch => (
                    <li class="flex items-start gap-2.5 text-xs text-slate-700 dark:text-slate-300">
                      <svg class="w-3.5 h-3.5 text-brand-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span class="leading-relaxed">{ch}</span>
                    </li>
                  ))}
                </ul>
              </InsetPanel>
            </div>

            <!-- Card Footer -->
            <CardFooter>
              <span slot="meta" class="text-xs text-slate-400 font-mono">
                Verified Commit
              </span>
              <div slot="action">
                <Button
                  href="https://github.com/givemehat/knowledge-hub/commits/main"
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="primary"
                  size="sm"
                  icon="external"
                >
                  <span>GitHub Commits</span>
                </Button>
              </div>
            </CardFooter>
          </Card>
        </div>
      ))}
    </div>
  </div>
</Layout>
