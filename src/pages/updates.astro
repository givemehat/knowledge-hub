---
import Layout from '../layouts/Layout.astro';
import { UPDATES } from '../data/updates';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Changelog & Updates" description="Track all new topic additions, roadmap improvements, and platform updates.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-500">Continuous Improvement</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
        Knowledge Hub Changelog
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
        Hum is platform ko constantly update aur fact-check karte rehte hain.
      </p>
    </div>

    <!-- Timeline of Updates -->
    <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 dark:border-slate-800 space-y-10">
      {UPDATES.map(update => (
        <div class="relative">
          <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white dark:border-darkbg"></div>
          
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">
              {update.version}
            </span>
            <span class="text-xs text-slate-400">{update.date}</span>
          </div>

          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            {update.title}
          </h3>

          <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 bg-white dark:bg-darkcard p-5 rounded-2xl border border-slate-200 dark:border-darkborder shadow-sm">
            {update.changes.map(ch => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">•</span>
                <span>{ch}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Layout>
