---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="404 — Page Not Found">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="w-16 h-16 rounded-2xl bg-emerald-100 dark:bg-emerald-950 flex items-center justify-center text-3xl mx-auto mb-6">
      🔍
    </div>
    <h1 class="text-3xl font-black text-slate-900 dark:text-white mb-2">Topic or Page Not Found</h1>
    <p class="text-sm text-slate-500 mb-8">
      Lagta hai ye topic abhi tak hamare library me add nahi hua hai, ya URL me koi mistake hai.
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href={`${base}/`} class="px-5 py-2.5 rounded-xl bg-emerald-500 text-white font-bold text-xs hover:bg-emerald-600 transition-colors">
        Return Home
      </a>
      <a href={`${base}/topics/`} class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs hover:bg-slate-200 transition-colors">
        Explore Topics
      </a>
    </div>
  </div>
</Layout>
