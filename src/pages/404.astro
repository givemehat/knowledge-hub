---
import Layout from '../layouts/Layout.astro';
import { BRAND } from '../config/brand';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`404 — Page Not Found — ${BRAND.name}`}>
  <div class="relative max-w-2xl mx-auto px-4 py-28 text-center overflow-hidden">
    <!-- Ambient Backdrop Light -->
    <div class="pointer-events-none absolute top-10 left-1/3 w-80 h-48 bg-brand-500/[0.08] dark:bg-brand-500/[0.1] rounded-full blur-3xl -z-10"></div>

    <div class="w-16 h-16 rounded-3xl bg-brand-500/10 dark:bg-brand-950/60 border border-brand-500/20 flex items-center justify-center mx-auto mb-6 shadow-sm">
      <svg class="w-8 h-8 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-white/[0.05] border border-slate-200/80 dark:border-white/10 text-slate-500 dark:text-slate-400 text-xs font-mono mb-4">
      ERROR 404 • ROUTE UNRESOLVED
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-3">Topic or Page Not Found</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto mb-8 leading-relaxed">
      The requested page or topic has not been added to our static repository yet, or there may be a typographical error in the URL.
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href={`${base}/`} class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs hover:bg-brand-600 dark:hover:bg-brand-400 dark:hover:text-white transition-colors shadow-sm">
        Return Home
      </a>
      <a href={`${base}/topics/`} class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-white/[0.06] border border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-300 font-bold text-xs hover:bg-slate-200 dark:hover:bg-white/[0.1] transition-colors">
        Explore Topics
      </a>
    </div>
  </div>
</Layout>
