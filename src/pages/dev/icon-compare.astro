---
import Layout from '../../layouts/Layout.astro';
import IndianPattern from '../../components/ui/IndianPattern.astro';
import IconTile from '../../components/domains/IconTile.astro';
import { BRAND } from '../../config/brand';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 12 core UI actions compared across families
const icons = [
  { name: 'Search', desc: 'Global ⌘K search and filter inputs' },
  { name: 'Book / Guide', desc: 'Topic and documentation guides' },
  { name: 'Terminal', desc: 'Code runner and CLI environments' },
  { name: 'Code Block', desc: 'Syntax highlighting & snippets' },
  { name: 'Checkmark', desc: 'Task completion & fact-check badge' },
  { name: 'Alert / Warning', desc: 'Hypothetical scenario notices' },
  { name: 'Git Branch', desc: 'Version control & contribution flow' },
  { name: 'Star / Bookmark', desc: 'GitHub star CTA and favourites' },
  { name: 'External Link', desc: 'Primary citations and references' },
  { name: 'Share / Node', desc: 'Roadmap node & social distribution' },
  { name: 'User / Creator', desc: 'Author byline and profile badge' },
  { name: 'Settings / Sliders', desc: 'Filter controls and preference toggles' },
];
---

<Layout title={`Icon Families Comparison Lab — ${BRAND.name} Dev`} description="Side-by-side benchmark of 12 core UI icons across Lucide, Tabler, Phosphor, and Iconoir styles.">
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-12">
    <IndianPattern variant="rangoli" opacity={0.03} />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20 text-xs font-semibold mb-4">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          Research & Benchmark Lab
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Icon Families Benchmark
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
          Side-by-side evaluation of 12 identical UI actions across 4 top open-source icon sets. 
          <strong>Lucide Icons (ISC License)</strong> was selected as our exclusive primary family for optical balance and zero bundle overhead.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Comparison Table / Grid -->
    <div class="bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 rounded-3xl overflow-hidden shadow-card">
      <div class="p-6 border-b border-slate-100 dark:border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">12 Core UI Actions Matrix</h2>
          <p class="text-xs text-slate-500">Evaluated on a 24×24 grid with 1.75px–2px stroke weight.</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-peacock-500/10 text-peacock-600 dark:text-peacock-400 border border-peacock-500/20 text-xs font-bold">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Lucide: Selected Winner
          </span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-100 dark:border-white/10 text-slate-500 uppercase tracking-wider text-[10px]">
              <th class="p-4 pl-6">Action & Intent</th>
              <th class="p-4 font-bold text-brand-600 dark:text-brand-400">Lucide (Selected)</th>
              <th class="p-4 text-slate-600 dark:text-slate-400">Phosphor (Runner-Up)</th>
              <th class="p-4 text-slate-600 dark:text-slate-400">Tabler (Runner-Up)</th>
              <th class="p-4 text-slate-600 dark:text-slate-400">Iconoir (Candidate)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-white/5">
            <!-- 1. Search -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">01. Search (⌘K)</div>
                <div class="text-[11px] text-slate-400">Global modal & topic query</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/80 text-brand-600 dark:text-brand-400 flex items-center justify-center border border-brand-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><circle cx="112" cy="112" r="80"/><line x1="168.5" y1="168.5" x2="224" y2="224"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><line x1="21" y1="21" x2="15" y2="15"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35"/></svg>
                </div>
              </td>
            </tr>

            <!-- 2. Book / Guide -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">02. Topic Guide</div>
                <div class="text-[11px] text-slate-400">Knowledge articles & docs</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/80 text-brand-600 dark:text-brand-400 flex items-center justify-center border border-brand-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><path d="M48,208a24,24,0,0,1,24-24H208V32H72A24,24,0,0,0,48,56Z"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0v13M12 6v13"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 6.5V20M12 6.5C10 5 4 5 4 5v14s6 0 8 1.5M12 6.5C14 5 20 5 20 5v14s-6 0-8 1.5"/></svg>
                </div>
              </td>
            </tr>

            <!-- 3. Terminal -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">03. Terminal</div>
                <div class="text-[11px] text-slate-400">CLI & Tech fundamentals</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/80 text-brand-600 dark:text-brand-400 flex items-center justify-center border border-brand-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><polyline points="40 80 96 128 40 176"/><line x1="112" y1="176" x2="216" y2="176"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 7l5 5l-5 5M12 19h7"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M7 8l4 4-4 4M13 16h4"/></svg>
                </div>
              </td>
            </tr>

            <!-- 4. Checkmark -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">04. Checkmark (Verified)</div>
                <div class="text-[11px] text-slate-400">Milestone completed & fact-checked</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-peacock-50 dark:bg-peacock-950/80 text-peacock-600 dark:text-peacock-400 flex items-center justify-center border border-peacock-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><polyline points="88 136 112 160 168 104"/><circle cx="128" cy="128" r="96"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2l4 -4"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2 2 5-5"/></svg>
                </div>
              </td>
            </tr>

            <!-- 5. Alert / Warning -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">05. Alert / Scenario</div>
                <div class="text-[11px] text-slate-400">Hypothetical scenario notices</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-saffron-50 dark:bg-saffron-950/80 text-saffron-600 dark:text-saffron-400 flex items-center justify-center border border-saffron-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><path d="M114.2,40l-88,152A16,16,0,0,0,40,216H216a16,16,0,0,0,13.8-24l-88-152A15.9,15.9,0,0,0,114.2,40Z"/><line x1="128" y1="104" x2="128" y2="144"/><circle cx="128" cy="180" r="12"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4v.01M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 9v4m0 3.01l.01-.011M12 2L1 21h22L12 2z"/></svg>
                </div>
              </td>
            </tr>

            <!-- 6. User / Creator -->
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="p-4 pl-6">
                <div class="font-bold text-slate-900 dark:text-white">06. Creator / Author</div>
                <div class="text-[11px] text-slate-400">Byline, author card & profile</div>
              </td>
              <td class="p-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/80 text-brand-600 dark:text-brand-400 flex items-center justify-center border border-brand-500/20">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 256 256" stroke="currentColor" stroke-width="16"><circle cx="128" cy="96" r="64"/><path d="M32,216c19-48,57.3-64,96-64s77,16,96,64"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/></svg>
                </div>
              </td>
              <td class="p-4 text-slate-400">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a4 4 0 014-4h8a4 4 0 014 4v2"/></svg>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Rationale Card -->
    <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-white/10 space-y-4">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Why Lucide Icons is Enforced as Exclusive Single-Source</h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Mixing different icon libraries (e.g. Tabler for headers + Heroicons for cards + Feather for footers) produces subtle visual friction: mismatched optical centers, conflicting corner radii, and uneven line thicknesses.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="p-4 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10">
          <div class="font-bold text-xs text-brand-600 dark:text-brand-400 mb-1">1. Optical Harmony</div>
          <p class="text-xs text-slate-500">Uniform 24px bounding box and 2px stroke creates instant visual rhythm.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10">
          <div class="font-bold text-xs text-peacock-600 dark:text-peacock-400 mb-1">2. Zero Weight Penalty</div>
          <p class="text-xs text-slate-500">Rendered statically via Astro compile-time SVG injection with 0 KB JS runtime.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10">
          <div class="font-bold text-xs text-saffron-600 dark:text-saffron-400 mb-1">3. Permissive ISC License</div>
          <p class="text-xs text-slate-500">Unrestricted commercial & open-source reuse with zero royalty obligations.</p>
        </div>
      </div>
    </div>
    <!-- Semantic Domain Tiles Showcase (Duotone 56px Surfaces) -->
    <section class="space-y-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">6 Semantic Domain Tiles (Duotone 56px Surfaces)</h2>
          <p class="text-xs text-slate-500">Zero inappropriate metaphors: Neural brain for AI, atomic orbit for Quantum, briefcase for Career, rocket ship for Projects, layered stack for Tech Fundamentals, constitutional landmark for Governance.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 1. AI & Machine Learning -->
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-xs flex items-start gap-4">
          <IconTile category="ai-ml" />
          <div>
            <div class="font-bold text-sm text-slate-900 dark:text-white">AI & Machine Learning</div>
            <div class="text-[11px] text-indigo-600 dark:text-indigo-400 font-semibold mb-1">Synaptic Neural Brain (NOT mic)</div>
            <p class="text-xs text-slate-500 leading-relaxed">Represents neural network activations, synapses, and cognitive architectures.</p>
          </div>
        </div>

        <!-- 2. Quantum Computing -->
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-xs flex items-start gap-4">
          <IconTile category="quantum" />
          <div>
            <div class="font-bold text-sm text-slate-900 dark:text-white">Quantum Computing</div>
            <div class="text-[11px] text-sky-600 dark:text-sky-400 font-semibold mb-1">Atomic Orbit & Nucleus</div>
            <p class="text-xs text-slate-500 leading-relaxed">Visualizes electron probability clouds, superposition, and quantum spin states.</p>
          </div>
        </div>

        <!-- 3. Career & Placement -->
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-xs flex items-start gap-4">
          <IconTile category="career" />
          <div>
            <div class="font-bold text-sm text-slate-900 dark:text-white">Career & Placement</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mb-1">Briefcase & Upward Growth Path</div>
            <p class="text-xs text-slate-500 leading-relaxed">Represents professional trajectory, DSA mastery, and placement success.</p>
          </div>
        </div>

        <!-- 4. Projects Hub -->
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-xs flex items-start gap-4">
          <IconTile category="projects" />
          <div>
            <div class="font-bold text-sm text-slate-900 dark:text-white">Projects Hub</div>
            <div class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold mb-1">Rocket Ship Launch (NOT star)</div>
            <p class="text-xs text-slate-500 leading-relaxed">Embodies shipping software, production deployment, and building in public.</p>
          </div>
        </div>

        <!-- 5. Tech Fundamentals -->
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-xs flex items-start gap-4">
          <IconTile category="tech-fundamentals" />
          <div>
            <div class="font-bold text-sm text-slate-900 dark:text-white">Tech Fundamentals</div>
            <div class="text-[11px] text-violet-600 dark:text-violet-400 font-semibold mb-1">Layered Isometric Architecture</div>
            <p class="text-xs text-slate-500 leading-relaxed">Represents abstraction layers: Hardware, OS kernel, Networks, and Application runtimes.</p>
          </div>
        </div>

        <!-- 6. Politics & Governance -->
