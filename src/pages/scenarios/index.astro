---
import Layout from '../../layouts/Layout.astro';
import { SCENARIOS } from '../../data/scenarios';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Hypothetical Scenario Analysis — Knowledge Hub" description="Rigorous, research-grounded scenario planning and futures studies across geopolitics, AI, and macroeconomic systems.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Epistemological Disclaimer Banner -->
    <div class="mb-10 p-5 rounded-2xl bg-amber-500/10 border-2 border-amber-500/30 flex items-start gap-4">
      <div class="p-2.5 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 font-bold shrink-0 text-xl">
        ⚠️
      </div>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-black uppercase tracking-wider px-2 py-0.5 rounded bg-amber-500 text-slate-950">
            HYPOTHETICAL SCENARIOS ONLY
          </span>
          <span class="text-xs text-amber-700 dark:text-amber-300 font-semibold">• Fact vs Hypothesis Protocol</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          इस अनुभाग के सभी लेख <strong>काल्पनिक परिदृश्य विश्लेषण (Futures-Studies / Red-Teaming)</strong> हैं। ये कोई वास्तविक समाचार, भविष्यवाणियां या ब्रेकिंग इवेंट्स नहीं हैं। इनका उद्देश्य वास्तविक ऐतिहासिक आंकड़ों और शोध पत्रों के आधार पर महत्वपूर्ण प्रणालियों की संवेदनशीलता (stress-testing) को समझना है। 
          <a href={`${base}/research/fact-vs-hypothesis/`} class="text-amber-600 dark:text-amber-400 font-bold underline ml-1 hover:text-amber-500">
            हमारा "Fact vs Hypothesis" प्रोटोकॉल पढ़ें ↗
          </a>
        </p>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-darkcard border border-slate-300/60 dark:border-darkborder text-xs font-bold text-slate-700 dark:text-slate-300 mb-4">
        <span>🧭</span> Futures Studies & Strategic Wargaming
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        Hypothetical Scenario Analysis
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        अगर कोई बड़ा चोकपॉइंट बंद हो जाए, एआई डीपफेक्स चुनाव से 36 घंटे पहले गिरें, या कोर बैंकिंग क्लाउड आउटेज हो? जानिए इनके कॉज़ल चेन्स, ऐतिहासिक साक्ष्य, और बेस्ट/बेस/वर्स्ट केस आउटकम्स।
      </p>
    </div>

    <!-- Scenarios Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {SCENARIOS.map(sc => (
        <a 
          href={`${base}/scenarios/${sc.slug}/`}
          class="group flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-darkcard border-2 border-slate-200 dark:border-darkborder hover:border-amber-500/80 transition-all shadow-sm hover:shadow-xl relative overflow-hidden"
        >
          <!-- Corner Badge -->
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 font-black text-[9px] uppercase tracking-wider px-3 py-1 rounded-bl-xl">
            HYPOTHETICAL
          </div>

          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {sc.domainLabel}
              </span>
              <span class="text-xs text-slate-400">• {sc.readingMinutes} min read</span>
            </div>

            <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug mb-2">
              {sc.title}
            </h2>

            <p class="text-xs font-hindi font-medium text-slate-500 dark:text-slate-400 mb-4 line-clamp-1">
              {sc.titleHindi}
            </p>

            <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed mb-6">
              {sc.abstract}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold text-amber-600 dark:text-amber-400">
            <span>Explore Scenario & Causal Tree</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Methodology Link Box -->
    <div class="mt-16 p-8 rounded-2xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-center max-w-3xl mx-auto">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
        हम इन परिदृश्यों को कैसे मॉडल करते हैं?
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6">
        हर परिदृश्य RAND कॉर्पोरेशन, IEA, EIA, और DARPA के ओपन-सोर्स सिमुलेशन और ऐतिहासिक मिसालों पर आधारित है। कोई काल्पनिक आंकड़े या अज्ञात व्यक्ति के नाम नहीं जोड़े गए हैं।
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={`${base}/research/fact-vs-hypothesis/`} class="px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs hover:bg-amber-400 transition-colors">
          Fact vs Hypothesis नीति
        </a>
        <a href={`${base}/research/data-cards/`} class="px-4 py-2 rounded-xl bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-xs hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors">
          डेटा कार्ड्स देखें
        </a>
      </div>
    </div>
  </div>
</Layout>
