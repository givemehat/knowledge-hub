---
import Layout from '../layouts/Layout.astro';
import IndianPattern from '../components/ui/IndianPattern.astro';
import ContactForm from '../components/creator/ContactForm.astro';
import QRCard from '../components/creator/QRCard.astro';
import AvailabilityBadge from '../components/creator/AvailabilityBadge.astro';
import { CREATOR } from '../data/creator';
import { BRAND } from '../config/brand';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`Contact ${CREATOR.name} — ${BRAND.name}`} description={`Get in touch with ${CREATOR.name} for software engineering roles, technical collaboration, or feedback on ${BRAND.name}.`}>
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-14 sm:py-16">
    <!-- Ambient Glow Backdrop -->
    <div class="pointer-events-none absolute -top-12 left-1/4 w-96 h-64 bg-brand-500/[0.08] dark:bg-brand-500/[0.1] rounded-full blur-3xl -z-10"></div>
    <IndianPattern variant="rangoli" opacity={0.03} />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <AvailabilityBadge class="mb-4" />
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          Let's Connect & Collaborate
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
          Open-source ideas, technical collaboration, engineering opportunities, or a casual technical conversation — feel free to send a message.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left 2 Cols: Interactive Contact Form -->
      <div class="lg:col-span-2">
        <ContactForm />
      </div>

      <!-- Right 1 Col: Quick Links, QR Code & vCard -->
      <div class="space-y-6">
        <!-- Direct Channels Card -->
        <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#15131b] border border-slate-200/80 dark:border-white/10 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
            Direct Reach Channels
          </h3>

          <div class="space-y-2.5">
            <!-- Email -->
            <a
              href={`mailto:${CREATOR.links.email}`}
              class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5 hover:border-brand-500/40 text-xs transition-colors group"
            >
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-600 dark:text-brand-400 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <div class="font-bold text-slate-900 dark:text-white">Email Address</div>
                  <div class="text-[11px] text-slate-500 font-mono truncate max-w-[170px]">{CREATOR.links.email}</div>
                </div>
              </div>
              <span class="text-brand-600 dark:text-brand-400 font-bold group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <!-- GitHub -->
            <a
              href={CREATOR.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5 hover:border-brand-500/40 text-xs transition-colors group"
            >
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-slate-900 dark:text-white shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </div>
                <div>
                  <div class="font-bold text-slate-900 dark:text-white">GitHub Profile</div>
                  <div class="text-[11px] text-slate-500 font-mono">@{CREATOR.handle}</div>
                </div>
              </div>
              <span class="text-slate-400 group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <!-- LinkedIn -->
            {CREATOR.links.linkedin && (
              <a
                href={CREATOR.links.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 dark:bg-white/[0.04] border border-slate-100 dark:border-white/5 hover:border-brand-500/40 text-xs transition-colors group"
              >
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold shrink-0">
                    in
                  </div>
                  <div>
                    <div class="font-bold text-slate-900 dark:text-white">LinkedIn</div>
                    <div class="text-[11px] text-slate-500">{CREATOR.name}</div>
                  </div>
                </div>
                <span class="text-slate-400 group-hover:translate-x-1 transition-transform">↗</span>
              </a>
            )}
          </div>
        </div>

        <!-- QR Code & vCard -->
        <QRCard />
      </div>
    </div>
  </div>
</Layout>
