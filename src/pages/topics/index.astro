---
import Layout from '../../layouts/Layout.astro';
import { TOPICS, CATEGORIES } from '../../data/topics';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="All Knowledge Topics & Guides" description="Browse all verified topics across AI, Quantum Computing, Placement, and Tech Fundamentals.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-500">Curated Repository</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
        Knowledge Library & Topic Guides
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        Har topic me TL;DR box, core concepts, mini-projects, aur primary citations included hain.
      </p>
    </div>

    <!-- Filters Bar (Hick's Law - minimal intuitive filters) -->
    <div class="bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder rounded-2xl p-4 mb-8 shadow-sm space-y-3">
      <!-- Category Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filter-chips">
        <button class="cat-filter active shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 text-white cursor-pointer" data-category="all">
          All Categories ({TOPICS.length})
        </button>
        {CATEGORIES.map(cat => (
          <button class="cat-filter shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" data-category={cat.id}>
            {cat.icon} {cat.name}
          </button>
        ))}
      </div>

      <!-- Level Chips & Search -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-1.5 text-xs font-medium" id="level-filter-chips">
          <span class="text-slate-400 mr-1 text-[11px]">Level:</span>
          <button class="level-filter active px-2.5 py-1 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" data-level="all">All</button>
          <button class="level-filter px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400" data-level="beginner">Beginner</button>
          <button class="level-filter px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400" data-level="intermediate">Intermediate</button>
          <button class="level-filter px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400" data-level="advanced">Advanced</button>
        </div>

        <div class="relative w-full sm:w-64">
          <input 
            type="text" 
            id="topic-search-input"
            placeholder="Filter topics by keyword..."
            class="w-full text-xs px-3 py-1.5 pl-8 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-emerald-500"
          />
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Topics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="topics-grid">
      {TOPICS.map(topic => (
        <a 
          href={`${base}/topics/${topic.slug}/`}
          class="topic-card group bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder rounded-2xl p-6 hover:border-emerald-500/60 hover:shadow-lg transition-all flex flex-col justify-between"
          data-category={topic.category}
          data-level={topic.level}
          data-title={topic.title.toLowerCase()}
          data-tags={topic.tags.join(' ').toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                {topic.categoryLabel}
              </span>
              <span class="text-xs text-slate-400 font-medium">⏱ {topic.readingMinutes} min read</span>
            </div>

            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
              {topic.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-3 leading-relaxed">
              {topic.summary}
            </p>
          </div>

          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">
              {topic.level}
            </span>
            <span class="text-xs font-semibold text-emerald-500 group-hover:translate-x-1 transition-transform">
              Read Guide →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<script is:inline>
  const urlParams = new URLSearchParams(window.location.search);
  const initialCat = urlParams.get('category') || 'all';

  let selectedCategory = initialCat;
  let selectedLevel = 'all';
  let searchQuery = '';

  const catBtns = document.querySelectorAll('.cat-filter');
  const levelBtns = document.querySelectorAll('.level-filter');
  const searchInput = document.getElementById('topic-search-input');
  const cards = document.querySelectorAll('.topic-card');

  function filterCards() {
    cards.forEach(card => {
      const cat = card.getAttribute('data-category');
      const level = card.getAttribute('data-level');
      const title = card.getAttribute('data-title');
      const tags = card.getAttribute('data-tags');

      const matchesCat = selectedCategory === 'all' || cat === selectedCategory;
      const matchesLevel = selectedLevel === 'all' || level === selectedLevel;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || tags.includes(searchQuery);

      if (matchesCat && matchesLevel && matchesSearch) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  catBtns.forEach(btn => {
    if (btn.getAttribute('data-category') === selectedCategory) {
      catBtns.forEach(b => b.classList.remove('active', 'bg-emerald-500', 'text-white'));
      btn.classList.add('active', 'bg-emerald-500', 'text-white');
    }

    btn.addEventListener('click', () => {
      catBtns.forEach(b => b.classList.remove('active', 'bg-emerald-500', 'text-white'));
      btn.classList.add('active', 'bg-emerald-500', 'text-white');
      selectedCategory = btn.getAttribute('data-category');
      filterCards();
    });
  });

  levelBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      levelBtns.forEach(b => b.classList.remove('active', 'bg-emerald-100', 'text-emerald-700', 'dark:bg-emerald-950', 'dark:text-emerald-300'));
      btn.classList.add('active', 'bg-emerald-100', 'text-emerald-700', 'dark:bg-emerald-950', 'dark:text-emerald-300');
      selectedLevel = btn.getAttribute('data-level');
      filterCards();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value.toLowerCase().trim();
    filterCards();
  });

  filterCards();
</script>
