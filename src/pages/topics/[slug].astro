---
import Layout from '../../layouts/Layout.astro';
import { TOPICS, type Topic } from '../../data/topics';

export function getStaticPaths() {
  return TOPICS.map(topic => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const relatedTopics = TOPICS.filter(t => topic.relatedSlugs?.includes(t.slug));
---

<Layout title={topic.title} description={topic.summary} category={topic.categoryLabel}>
  <!-- Sticky Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 right-0 h-1 bg-emerald-500 z-30 transition-all duration-75 w-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-emerald-500">Home</a>
      <span>/</span>
      <a href={`${base}/topics/`} class="hover:text-emerald-500">Topics</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs">{topic.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Main Content Column (3 cols) -->
      <article class="lg:col-span-3 space-y-10">
        <!-- Title & Subtitle Header -->
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
              {topic.categoryLabel}
            </span>
            <span class="text-xs text-slate-400">• {topic.readingMinutes} min read</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
            {topic.title}
          </h1>

          {topic.titleHindi && (
            <p class="text-base text-slate-500 font-hindi mt-1.5 font-medium">
              {topic.titleHindi}
            </p>
          )}

          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-4 leading-relaxed">
            {topic.summary}
          </p>
        </div>

        <!-- 1. TL;DR Box -->
        <section id="tldr" class="rounded-2xl p-6 bg-gradient-to-br from-emerald-50/80 to-teal-50/50 dark:from-emerald-950/30 dark:to-teal-950/20 border-2 border-emerald-500/30 shadow-sm">
          <div class="flex items-center gap-2 font-black text-sm text-emerald-900 dark:text-emerald-300 uppercase tracking-wider mb-3">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
            TL;DR (Quick Summary)
          </div>
          <ul class="space-y-2">
            {topic.tldr.map(item => (
              <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 dark:text-slate-200">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 2. Meta Strip (Last Verified, Confidence, Level) -->
        <div id="meta-strip" class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-xs">
          <div class="flex items-center gap-4 flex-wrap">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Difficulty</span>
              <span class="font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">{topic.level}</span>
            </div>
            <div class="h-6 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Last Fact-Checked</span>
              <span class="font-semibold text-slate-800 dark:text-slate-200">{topic.lastVerified}</span>
            </div>
            <div class="h-6 w-px bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Confidence Badge</span>
              <span class={`inline-flex items-center gap-1 font-bold ${
                topic.confidence === 'high' ? 'text-emerald-600 dark:text-emerald-400' :
                topic.confidence === 'medium' ? 'text-amber-600 dark:text-amber-400' :
                'text-cyan-600 dark:text-cyan-400'
              }`}>
                ● {topic.confidence.toUpperCase()} CONFIDENCE
              </span>
            </div>
          </div>

          <a 
            href={`https://github.com/givemehat/knowledge-hub/edit/main/src/data/topics.ts`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1"
          >
            Suggest edit / report issue ↗
          </a>
        </div>

        <!-- 3. Why It Matters -->
        <section id="why-it-matters" class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Why It Matters</h2>
          <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed bg-white dark:bg-darkcard p-5 rounded-xl border border-slate-200 dark:border-darkborder">
            {topic.whyItMatters}
          </p>
        </section>

        <!-- 4. Theory & Core Concepts -->
        <section id="core-concepts" class="space-y-6">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Theory & Core Concepts</h2>
          <div class="space-y-6">
            {topic.coreConcepts.map(concept => (
              <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">{concept.heading}</h3>
                <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line">{concept.content}</p>

                {concept.analogy && (
                  <div class="p-3.5 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-300/40 text-amber-900 dark:text-amber-200 text-xs leading-relaxed flex items-start gap-2">
                    <span class="text-base shrink-0">💡</span>
                    <span><strong>Intuitive Analogy:</strong> {concept.analogy}</span>
                  </div>
                )}

                {concept.codeSnippet && (
                  <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 mt-3">
                    <div class="bg-slate-100 dark:bg-slate-900 px-4 py-1.5 flex items-center justify-between text-[11px] text-slate-500 font-mono">
                      <span>{concept.codeSnippet.language}</span>
                      <button 
                        class="copy-code-btn hover:text-emerald-500 transition-colors cursor-pointer"
                        data-code={concept.codeSnippet.code}
                      >
                        Copy Code
                      </button>
                    </div>
                    <pre class="p-4 bg-slate-950 text-emerald-400 font-mono text-xs overflow-x-auto leading-relaxed"><code>{concept.codeSnippet.code}</code></pre>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- 5. Execution Roadmap -->
        {topic.roadmapSteps && topic.roadmapSteps.length > 0 && (
          <section id="roadmap" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Step-by-Step Learning Path</h2>
            <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder">
              <ol class="space-y-3">
                {topic.roadmapSteps.map((step, idx) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                    <span class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                      {idx + 1}
                    </span>
                    <span class="leading-relaxed">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}

        <!-- 6. Hands-On Projects & Exercises -->
        {topic.handsOn && topic.handsOn.length > 0 && (
          <section id="hands-on" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Hands-On Practice (Mini-Projects)</h2>
            <div class="grid grid-cols-1 gap-4">
              {topic.handsOn.map(ex => (
                <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-500">Exercise Challenge</span>
                  <h3 class="font-bold text-base text-slate-900 dark:text-white">{ex.title}</h3>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{ex.task}</p>
                  <div class="pt-2 text-xs font-semibold text-slate-500">
                    📦 Deliverable: <span class="text-emerald-600 dark:text-emerald-400 font-medium">{ex.deliverable}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 7. Curated Resources (Videos, Docs, Books) -->
        <section id="curated-resources" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Curated High-Quality Resources</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {topic.resources.map(res => (
              <a 
                href={res.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="group p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder hover:border-emerald-500/60 hover:shadow-md transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                      {res.type}
                    </span>
                    {res.free && <span class="text-[10px] font-bold text-emerald-500">100% Free</span>}
                  </div>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
                    {res.title}
                  </h4>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                    💡 <strong>Why examine:</strong> {res.whyWatch}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
                  <span>By {res.author}</span>
                  <span class="font-bold text-emerald-500">Open Resource ↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- 8. Common Mistakes & Myths -->
        {topic.mistakesAndMyths && topic.mistakesAndMyths.length > 0 && (
          <section id="myths" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Common Mistakes & Myths</h2>
            <div class="space-y-3">
              {topic.mistakesAndMyths.map(item => (
                <div class="p-5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-2">
                  <div class="flex items-start gap-2 text-xs sm:text-sm text-red-600 dark:text-red-400 font-semibold">
                    <span>❌ Myth:</span>
                    <span>{item.myth}</span>
                  </div>
                  <div class="flex items-start gap-2 text-xs sm:text-sm text-emerald-700 dark:text-emerald-400">
                    <span>✅ Reality:</span>
                    <span class="leading-relaxed">{item.reality}</span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- 9. FAQ Accordion -->
        {topic.faqs && topic.faqs.length > 0 && (
          <section id="faqs" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Frequently Asked Questions</h2>
            <div class="space-y-3">
              {topic.faqs.map(faq => (
                <details class="group p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder transition-all">
                  <summary class="flex items-center justify-between font-bold text-xs sm:text-sm text-slate-900 dark:text-white cursor-pointer select-none">
                    <span>{faq.question}</span>
                    <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                  </summary>
                  <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- 10. Related Topics -->
        {relatedTopics && relatedTopics.length > 0 && (
          <section id="related" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">Related Topics to Learn Next</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedTopics.map(rel => (
                <a href={`${base}/topics/${rel.slug}/`} class="p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder hover:border-emerald-500/60 transition-colors flex items-center justify-between">
                  <div>
                    <h4 class="font-bold text-sm text-slate-900 dark:text-white">{rel.title}</h4>
                    <span class="text-[10px] text-slate-400">{rel.categoryLabel} • {rel.readingMinutes}m read</span>
                  </div>
                  <span class="text-emerald-500 font-bold">→</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- 11. Sources & Primary References (Strict Fact-Checking) -->
        <section id="sources" class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider text-xs">Primary Sources & Verifications</h2>
          <ol class="space-y-2 text-xs text-slate-500">
            {topic.sources.map((src, i) => (
              <li class="flex items-start gap-2">
                <span>[{i + 1}]</span>
                <span>
                  <a href={src.url} target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                    {src.title}
                  </a>
                  — <em>{src.publisher}</em> (Accessed {src.accessed}).
                </span>
              </li>
            ))}
          </ol>
        </section>
      </article>

      <!-- Sidebar Sticky Table of Contents (Desktop - Scrollspy) -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-24 p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder text-xs space-y-4">
          <h4 class="font-black text-slate-900 dark:text-white uppercase tracking-wider text-[11px]">Table of Contents</h4>
          <nav class="space-y-2" id="toc-nav">
            <a href="#tldr" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">1. TL;DR Summary</a>
            <a href="#meta-strip" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">2. Verification Strip</a>
            <a href="#why-it-matters" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">3. Why It Matters</a>
            <a href="#core-concepts" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">4. Core Concepts</a>
            {topic.roadmapSteps?.length > 0 && <a href="#roadmap" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">5. Learning Roadmap</a>}
            {topic.handsOn?.length > 0 && <a href="#hands-on" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">6. Hands-On Exercises</a>}
            <a href="#curated-resources" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">7. Curated Resources</a>
            <a href="#myths" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">8. Common Myths</a>
            <a href="#faqs" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">9. FAQs</a>
            <a href="#sources" class="block text-slate-600 dark:text-slate-400 hover:text-emerald-500 transition-colors">10. Primary Sources</a>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script is:inline>
  // Reading Progress Bar
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const bar = document.getElementById('reading-progress');
    if (bar) bar.style.width = scrolled + '%';
  });

  // Copy Code Button
  document.querySelectorAll('.copy-code-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = btn.getAttribute('data-code');
      if (code) {
        navigator.clipboard.writeText(code).then(() => {
          const original = btn.innerText;
          btn.innerText = 'Copied!';
          setTimeout(() => btn.innerText = original, 2000);
        });
      }
    });
  });
</script>
