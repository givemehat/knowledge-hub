---
import Layout from '../../layouts/Layout.astro';
import { TOPICS, type Topic } from '../../data/topics';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import InsetPanel from '../../components/ui/InsetPanel.astro';
import CardFooter from '../../components/ui/CardFooter.astro';
import Button from '../../components/ui/Button.astro';
import MetaRow from '../../components/ui/MetaRow.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import MythReality from '../../components/ui/MythReality.astro';
import ResourceCard from '../../components/ui/ResourceCard.astro';
import Accordion from '../../components/ui/Accordion.astro';
import AuthorCard from '../../components/creator/AuthorCard.astro';
import SoftCTA from '../../components/creator/SoftCTA.astro';
import TypographyPromptBuilder from '../../components/interactive/TypographyPromptBuilder.astro';
import ComponentPromptGallery from '../../components/interactive/ComponentPromptGallery.astro';
import DeviceFrameShowcase from '../../components/interactive/DeviceFrameShowcase.astro';
import ShadcnRegistryStudio from '../../components/interactive/ShadcnRegistryStudio.astro';
import CommunityRegistryStudio from '../../components/interactive/CommunityRegistryStudio.astro';
import FontPairingMatrix from '../../components/interactive/FontPairingMatrix.astro';
import TextAnimationStudio from '../../components/interactive/TextAnimationStudio.astro';
import ScenarioPromptPresets from '../../components/interactive/ScenarioPromptPresets.astro';
import AnimationPromptBuilder from '../../components/interactive/AnimationPromptBuilder.astro';
import CardButtonMotionStudio from '../../components/interactive/CardButtonMotionStudio.astro';
import AlertNotificationStudio from '../../components/interactive/AlertNotificationStudio.astro';
import MotionPrimitivesStudio from '../../components/interactive/MotionPrimitivesStudio.astro';
import LayoutPromptBuilder from '../../components/interactive/LayoutPromptBuilder.astro';
import ResponsivePatternSimulator from '../../components/interactive/ResponsivePatternSimulator.astro';
import DynamicBentoMatrix from '../../components/interactive/DynamicBentoMatrix.astro';
import StylingPromptBuilder from '../../components/interactive/StylingPromptBuilder.astro';
import WcagContrastLab from '../../components/interactive/WcagContrastLab.astro';
import ElevationShadowLab from '../../components/interactive/ElevationShadowLab.astro';
import { CREATOR } from '../../data/creator';

export function getStaticPaths() {
  return TOPICS.map(topic => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const relatedTopics = TOPICS.filter(t => topic.relatedSlugs?.includes(t.slug));

// Topic GitHub Edit Link (Direct file or issue)
const editUrl = `https://github.com/givemehat/knowledge-hub/edit/main/content/topics/${topic.slug}.mdx`;
---

<Layout title={topic.title} description={topic.summary} category={topic.categoryLabel}>
  <!-- Sticky Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 right-0 h-1 bg-brand-600 dark:bg-brand-500 z-30 transition-all duration-75 w-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
      <span>/</span>
      <a href={`${base}/topics/`} class="hover:text-brand-600 dark:hover:text-brand-400">Topics</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs">{topic.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Rail / Sticky Table of Contents (Desktop) -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-24 p-5 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder shadow-apple-sm space-y-4">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>On This Page</span>
          </div>

          <nav class="space-y-1 text-xs">
            <a href="#tldr" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
              1. TL;DR Summary
            </a>
            <a href="#why-it-matters" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
              2. Why It Matters
            </a>
            <a href="#core-concepts" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
              3. Core Concepts & Code
            </a>
            {topic.slug === 'ai-ui-prompting-engineering' && (
              <a href="#shadcn-registry-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ shadcn/ui Registry
              </a>
              <a href="#community-registry-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ 21st.dev Registry & MCP
              </a>
              <a href="#interactive-typography-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Typography Studio
              </a>
              <a href="#component-prompt-templates" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Component Prompts
              </a>
              <a href="#device-mockups-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Device Framing
              </a>
            )}
            {topic.slug === 'typography-prompting-font-pairing' && (
              <a href="#font-pairing-matrix" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Pairing Matrix
              </a>
              <a href="#text-animation-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ 6 Text Animations
              </a>
              <a href="#scenario-presets" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ 4 Scenario Presets
              </a>
            )}
            {topic.slug === 'ui-animation-micro-interactions' && (
              <a href="#animation-prompt-builder" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Motion Builder
              </a>
              <a href="#card-button-motion-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Cards & Buttons Lab
              </a>
              <a href="#alert-notification-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Alert & Toast System
              </a>
              <a href="#motion-primitives-studio" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Motion Primitives Lab
              </a>
            )}
            {topic.slug === 'responsive-layouts-bento-grid' && (
              <a href="#layout-prompt-builder" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Layout Builder
              </a>
              <a href="#responsive-pattern-simulator" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ 4 Pattern Simulators
              </a>
              <a href="#dynamic-bento-matrix" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Bento Grid Matrix
              </a>
            )}
            {topic.slug === 'ui-styling-color-systems' && (
              <a href="#styling-prompt-builder" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Styling Builder
              </a>
              <a href="#wcag-contrast-lab" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ WCAG Contrast Lab
              </a>
              <a href="#elevation-shadow-lab" class="block py-1.5 px-2.5 rounded-lg text-peach-700 dark:text-peach-400 font-bold bg-peach-50/60 dark:bg-peach-950/30 hover:bg-peach-100 dark:hover:bg-peach-900/50 transition-colors">
                ★ Elevation Studio
              </a>
            )}
            {topic.roadmapSteps && topic.roadmapSteps.length > 0 && (
              <a href="#roadmap" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                4. Step-by-Step Path
              </a>
            )}
            {topic.handsOn && topic.handsOn.length > 0 && (
              <a href="#hands-on" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                5. Hands-on Practice
              </a>
            )}
            {topic.resources && topic.resources.length > 0 && (
              <a href="#curated-resources" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                6. Curated Resources
              </a>
            )}
            {topic.mistakesAndMyths && topic.mistakesAndMyths.length > 0 && (
              <a href="#myths" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                7. Myths vs Reality
              </a>
            )}
            {topic.faqs && topic.faqs.length > 0 && (
              <a href="#faq" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                8. FAQs
              </a>
            )}
            <a href="#sources" class="block py-1.5 px-2.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
              9. Sources & Citations
            </a>
          </nav>

          <!-- Per-Topic Edit CTA -->
          <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
            <a 
              href={editUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Edit Topic on GitHub ↗</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Content Column (3 cols) -->
      <article class="lg:col-span-3 min-w-0 max-w-full space-y-10">
        <!-- Title & Subtitle Header -->
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <Chip variant="neutral" size="sm">
              {topic.categoryLabel}
            </Chip>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
            {topic.title}
          </h1>

          {topic.titleHindi && (
            <p class="text-base text-slate-500 font-hindi font-medium">
              {topic.titleHindi}
            </p>
          )}

          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
            {topic.summary}
          </p>

          <!-- Author Byline -->
          <div class="flex items-center gap-2 pt-2 text-xs text-slate-500">
            <div class="w-5 h-5 rounded-full bg-brand-600 text-white font-bold text-[9px] flex items-center justify-center">
              {CREATOR.name.split(' ').map(n => n[0]).join('')}
            </div>
            <span>Curated by <a href={`${base}/about/`} class="font-bold text-slate-800 dark:text-slate-200 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">{CREATOR.name}</a></span>
            <span>•</span>
            <span>Last Verified: {topic.lastVerified}</span>
          </div>
        </div>

        <!-- 2. Meta Strip (Separated MetaRow Chips - Zero Glued Text) -->
        <div id="meta-strip" class="p-4 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder shadow-apple-sm flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <MetaRow label="Difficulty" value={topic.level} />
            <MetaRow label="Reading Time" value={`${topic.readingMinutes} Mins`} />
            <MetaRow label="Last Fact-Checked" value={topic.lastVerified} />
            <MetaRow label="Confidence" value={topic.confidence} />
          </div>

          <a 
            href={editUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline inline-flex items-center gap-1"
          >
            Suggest edit ↗
          </a>
        </div>

        <!-- 1. TL;DR InsetPanel Box -->
        <section id="tldr">
          <InsetPanel variant="tldr" label="TL;DR (Quick Summary)" class="p-5 sm:p-6 rounded-2xl border-2">
            <ul class="space-y-2.5 mt-2">
              {topic.tldr.map(item => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 dark:text-slate-200">
                  <svg class="w-4 h-4 text-brand-600 dark:text-brand-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4"/>
                  </svg>
                  <span class="leading-relaxed" set:html={item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></span>
                </li>
              ))}
            </ul>
          </InsetPanel>
        </section>

        <!-- 3. Why It Matters -->
        <section id="why-it-matters" class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="text-brand-600 dark:text-brand-400 font-mono text-base">01.</span>
            <span>Why It Matters</span>
          </h2>
          <div class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed bg-white dark:bg-darkcard p-6 rounded-2xl border border-slate-200/80 dark:border-darkborder shadow-apple-sm">
            {topic.whyItMatters}
          </div>
        </section>

        <!-- 4. Theory & Core Concepts -->
        <section id="core-concepts" class="space-y-6">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="text-brand-600 dark:text-brand-400 font-mono text-base">02.</span>
            <span>Theory & Core Concepts</span>
          </h2>

          <div class="space-y-6">
            {topic.coreConcepts.map(concept => (
              <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder shadow-apple-sm space-y-4">
                <h3 class="font-bold text-base sm:text-lg text-slate-900 dark:text-white">
                  {concept.heading}
                </h3>
                
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                  {concept.content}
                </p>

                {concept.analogy && (
                  <InsetPanel variant="recommend" label="Real-World Analogy">
                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                      {concept.analogy}
                    </p>
                  </InsetPanel>
                )}

                {concept.codeSnippet && (
                  <CodeBlock 
                    language={concept.codeSnippet.language} 
                    code={concept.codeSnippet.code} 
                  />
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Interactive Studios (For AI UI Prompting Engineering Guide) -->
        {topic.slug === 'ai-ui-prompting-engineering' && (
          <div class="space-y-12 pt-4">
            <!-- 0. shadcn/ui Core Primitives Registry Studio -->
            <section id="shadcn-registry-studio" class="space-y-4">
              <ShadcnRegistryStudio />
            </section>

            <!-- 0b. 21st.dev Community Registry & AI MCP Studio -->
            <section id="community-registry-studio" class="space-y-4">
              <CommunityRegistryStudio />
            </section>

            <!-- 1. Typography Prompt Studio -->
            <section id="interactive-typography-studio" class="space-y-4">
              <TypographyPromptBuilder />
            </section>

            <!-- 2. Master Component Prompt Templates -->
            <section id="component-prompt-templates" class="space-y-4">
              <ComponentPromptGallery />
            </section>

            <!-- 3. Device Framing & Mockup Studio -->
            <section id="device-mockups-studio" class="space-y-4">
              <DeviceFrameShowcase />
            </section>
          </div>
        )}

        <!-- Interactive Studios (For Typography Prompting & Font Pairing Systems) -->
        {topic.slug === 'typography-prompting-font-pairing' && (
          <div class="space-y-12 pt-4">
            <!-- 1. Interactive Font Pairing Matrix & Showcase -->
            <section id="font-pairing-matrix" class="space-y-4">
              <FontPairingMatrix />
            </section>

            <!-- 2. 6 Text Animation Playgrounds with reduced-motion toggle -->
            <section id="text-animation-studio" class="space-y-4">
              <TextAnimationStudio />
            </section>

            <!-- 3. Ready-to-Use Scenario Prompt Presets -->
            <section id="scenario-presets" class="space-y-4">
              <ScenarioPromptPresets />
            </section>
          </div>
        )}

        <!-- Interactive Studios (For UI Animation & Micro-Interactions Guide) -->
        {topic.slug === 'ui-animation-micro-interactions' && (
          <div class="space-y-12 pt-4">
            <!-- 1. Interactive Animation Prompt Builder -->
            <section id="animation-prompt-builder" class="space-y-4">
              <AnimationPromptBuilder />
            </section>

            <!-- 2. Card & Button Motion Dynamics Lab -->
            <section id="card-button-motion-studio" class="space-y-4">
              <CardButtonMotionStudio />
            </section>

            <!-- 3. Alert & Toast Notification System -->
            <section id="alert-notification-studio" class="space-y-4">
              <AlertNotificationStudio />
            </section>

            <!-- 4. Motion Primitives Studio (Floating Dock, Morphing Popover, Progressive Blur) -->
            <section id="motion-primitives-studio" class="space-y-4">
              <MotionPrimitivesStudio />
            </section>
          </div>
        )}

        <!-- Interactive Studios (For Responsive Layouts & Bento Grid Architecture) -->
        {topic.slug === 'responsive-layouts-bento-grid' && (
          <div class="space-y-12 pt-4">
            <!-- 1. Interactive Layout Prompt Builder -->
            <section id="layout-prompt-builder" class="space-y-4">
              <LayoutPromptBuilder />
            </section>

            <!-- 2. Responsive Pattern Simulators -->
            <section id="responsive-pattern-simulator" class="space-y-4">
              <ResponsivePatternSimulator />
            </section>

            <!-- 3. Dynamic Bento Grid Matrix -->
            <section id="dynamic-bento-matrix" class="space-y-4">
              <DynamicBentoMatrix />
            </section>
          </div>
        )}

        <!-- Interactive Studios (For UI Styling, Themes & Color Systems) -->
        {topic.slug === 'ui-styling-color-systems' && (
          <div class="space-y-12 pt-4">
            <!-- 1. Interactive Styling Prompt Builder -->
            <section id="styling-prompt-builder" class="space-y-4">
              <StylingPromptBuilder />
            </section>

            <!-- 2. WCAG Contrast & Color Blindness Lab -->
            <section id="wcag-contrast-lab" class="space-y-4">
              <WcagContrastLab />
            </section>

            <!-- 3. Elevation Hierarchy & Shadow Studio -->
            <section id="elevation-shadow-lab" class="space-y-4">
              <ElevationShadowLab />
            </section>
          </div>
        )}

        <!-- 5. Step-by-Step Learning Path -->
        {topic.roadmapSteps && topic.roadmapSteps.length > 0 && (
          <section id="roadmap" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">03.</span>
              <span>Step-by-Step Learning Path</span>
            </h2>
            <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200/80 dark:border-darkborder shadow-apple-sm">
              <ol class="space-y-3">
                {topic.roadmapSteps.map((step, idx) => (
                  <li class="flex items-start gap-3.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                    <span class="w-6 h-6 rounded-full bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 font-mono">
                      {idx + 1}
                    </span>
                    <span class="leading-relaxed">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}

        <!-- 6. Hands-On Practice (Mini-Projects as Shared Cards) -->
        {topic.handsOn && topic.handsOn.length > 0 && (
          <section id="hands-on" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">04.</span>
              <span>Hands-On Practice (Mini-Projects)</span>
            </h2>
            <div class="grid grid-cols-1 gap-4">
              {topic.handsOn.map(ex => (
                <Card class="exercise-card">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <Chip variant="neutral">Exercise Challenge</Chip>
                      <Chip variant="level" level={topic.level}>{topic.level}</Chip>
                    </div>
                    <h3 class="font-bold text-base text-slate-900 dark:text-white mb-2">{ex.title}</h3>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">{ex.task}</p>
                    <InsetPanel variant="deliverable" label="Target Deliverable">
                      <p class="text-xs text-slate-700 dark:text-slate-200 font-medium">{ex.deliverable}</p>
                    </InsetPanel>
                  </div>
                  <CardFooter>
                    <span slot="meta" class="text-xs text-slate-400 font-mono">~30 Mins Practice</span>
                    <div slot="action">
                      <Button variant="primary" size="sm" icon="check">
                        <span>Practice Task</span>
                      </Button>
                    </div>
                  </CardFooter>
                </Card>
              ))}
            </div>
          </section>
        )}

        <!-- 7. Curated Resources (Using Upgraded ResourceCard) -->
        {topic.resources && topic.resources.length > 0 && (
          <section id="curated-resources" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">05.</span>
              <span>Curated Verified Resources</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 auto-rows-fr">
              {topic.resources.map(res => (
                <ResourceCard 
                  type={res.type}
                  title={res.title}
                  url={res.url}
                  author={res.author}
                  language={res.language}
                  duration={res.duration}
                  free={res.free}
                  whyWatch={res.whyWatch}
                  locale="en"
                />
              ))}
            </div>
          </section>
        )}

        <!-- 8. Common Mistakes & Myths -->
        {topic.mistakesAndMyths && topic.mistakesAndMyths.length > 0 && (
          <section id="myths" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">06.</span>
              <span>Common Mistakes & Myths</span>
            </h2>
            <div class="space-y-3">
              {topic.mistakesAndMyths.map(item => (
                <MythReality myth={item.myth} reality={item.reality} />
              ))}
            </div>
          </section>
        )}

        <!-- 9. FAQ Accordion (Clean & Conditional) -->
        {topic.faqs && topic.faqs.length > 0 && (
          <section id="faq" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">07.</span>
              <span>Frequently Asked Questions</span>
            </h2>
            <Accordion items={topic.faqs} />
          </section>
        )}

        <!-- 10. Related Topics (Unified Card Anatomy) -->
        {relatedTopics && relatedTopics.length > 0 && (
          <section id="related" class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-mono text-base">08.</span>
              <span>Related Knowledge Tracks</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 auto-rows-fr">
              {relatedTopics.map(rel => (
                <Card class="related-topic-card">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <Chip variant="neutral">{rel.categoryLabel}</Chip>
                      <span class="text-xs font-mono text-slate-400">{rel.readingMinutes}m</span>
                    </div>
                    <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2">
                      {rel.title}
                    </h4>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                      {rel.summary}
                    </p>
                  </div>
                  <CardFooter>
                    <span slot="meta" class="text-[11px] text-slate-400 font-mono">Verified {rel.lastVerified}</span>
                    <div slot="action">
                      <Button href={`${base}/topics/${rel.slug}/`} variant="primary" size="sm" icon="arrow">
                        <span>Read</span>
                      </Button>
                    </div>
                  </CardFooter>
                </Card>
              ))}
            </div>
          </section>
        )}

        <!-- 11. Primary Sources & Citations (Inside Sourced InsetPanel) -->
        <section id="sources" class="space-y-4 pt-6 border-t border-slate-200 dark:border-darkborder">
          <InsetPanel variant="source" label="Primary Sources & Fact-Check Citations" class="p-5 rounded-2xl">
            <ol class="space-y-3 mt-2 text-xs">
              {topic.sources.map((src, idx) => (
                <li class="flex items-start gap-2.5">
                  <span class="font-mono text-slate-400 font-bold">[{idx + 1}]</span>
                  <div class="flex-1">
                    <a href={src.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 dark:text-brand-400 hover:underline">
                      {src.title} ↗
                    </a>
                    <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-400">
                      <Chip variant="neutral" size="sm">{src.publisher}</Chip>
                      <span>Accessed: {src.accessed}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </InsetPanel>
        </section>

        <!-- 12. Author & Curator Signature Card -->
        <AuthorCard topicTitle={topic.title} topicSlug={topic.slug} lastVerified={topic.lastVerified} />
      </article>
    </div>
  </div>

  <!-- Soft Non-Intrusive Feedback CTA (Triggers after 75% scroll) -->
  <SoftCTA />

  <!-- Reading Progress Script -->
  <script is:inline>
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = scrolled + '%';
    });
  </script>
</Layout>
