---
import Layout from '../layouts/Layout.astro';
import { TOPICS, CATEGORIES } from '../data/topics';
import { ROADMAPS } from '../data/roadmaps';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const trendingTopics = TOPICS.slice(0, 4);
---

<Layout title="Knowledge Hub — Modern Static Knowledge for Builders & Students">
  <!-- Hero Section with Bento Structure -->
  <section class="relative pt-12 pb-16 sm:pt-20 sm:pb-24 overflow-hidden border-b border-slate-200/60 dark:border-darkborder/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300/40 text-emerald-700 dark:text-emerald-300 text-xs font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Aaj Ke Zamane Ka Wikipedia • 100% Static & Free
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.1] mb-6">
          Find accurate answers in <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">30 seconds</span>.
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
          College students, fresher developers aur curious readers ke liye verified roadmaps, hot tech topics, aur primary sources. Koi login nahi, koi ads nahi.
        </p>

        <!-- Search Bar Hero Trigger -->
        <div class="max-w-xl mx-auto mb-8">
          <button
            type="button"
            onclick="document.getElementById('open-search-btn')?.click()"
            class="w-full flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white dark:bg-darkcard border-2 border-slate-200 dark:border-darkborder shadow-xl shadow-slate-200/50 dark:shadow-none hover:border-emerald-500 transition-all text-sm text-slate-400 cursor-pointer text-left"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>Search topics, roadmaps, or cheat sheets...</span>
            </div>
            <kbd class="font-mono text-xs px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 border text-slate-500">⌘K</kbd>
          </button>

          <!-- Quick keyword chips -->
          <div class="flex flex-wrap items-center justify-center gap-2 mt-3 text-xs text-slate-500">
            <span>Popular:</span>
            <a href={`${base}/topics/rag/`} class="hover:text-emerald-500 underline decoration-slate-300">RAG</a>
            <span>•</span>
            <a href={`${base}/roadmaps/dsa-placement/`} class="hover:text-emerald-500 underline decoration-slate-300">DSA Roadmap</a>
            <span>•</span>
            <a href={`${base}/topics/qubits-superposition/`} class="hover:text-emerald-500 underline decoration-slate-300">Qubits</a>
            <span>•</span>
            <a href={`${base}/topics/docker-containers/`} class="hover:text-emerald-500 underline decoration-slate-300">Docker</a>
            <span>•</span>
            <a href={`${base}/topics/digital-india-upi-dbt/`} class="hover:text-emerald-500 underline decoration-slate-300">UPI Stack</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Bento Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Core Knowledge Domains</h2>
        <p class="text-xs text-slate-500 mt-1">Hick's Law: 6 focused categories structured for rapid progressive discovery.</p>
      </div>
      <a href={`${base}/topics/`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">View All Topics ↗</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {CATEGORIES.map(cat => {
        const count = TOPICS.filter(t => t.category === cat.id).length;
        return (
          <a
            href={`${base}/topics/?category=${cat.id}`}
            class="group p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder hover:border-emerald-500/60 hover:shadow-lg hover:-translate-y-0.5 transition-all flex flex-col justify-between"
          >
            <div>
              <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800/80 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                {cat.icon}
              </div>
              <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                {cat.description}
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-400">
              <span>{count} Topics Available</span>
              <span class="group-hover:translate-x-1 transition-transform font-bold text-emerald-500">Explore →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Trending Topics Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-slate-200/60 dark:border-darkborder/60">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Trending & High-Impact Topics</h2>
        <p class="text-xs text-slate-500 mt-1">3-minute summaries with verified primary sources and runnable code.</p>
      </div>
      <a href={`${base}/topics/`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">Explore Library ↗</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {trendingTopics.map(topic => (
        <a
          href={`${base}/topics/${topic.slug}/`}
          class="group p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder hover:border-emerald-500/60 transition-all hover:shadow-md flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">
                {topic.categoryLabel}
              </span>
              <span class="text-xs text-slate-400">{topic.readingMinutes} min read</span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
              {topic.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
              {topic.summary}
            </p>

            <!-- Quick TLDR Snippet (Miller's law chunking) -->
            <div class="mt-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800">
              <div class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mb-1">⚡ TL;DR Key Takeaway:</div>
              <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2">{topic.tldr[0]}</p>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-1.5">
            {topic.tags.map(tag => (
              <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500">
                #{tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive Roadmaps Banner Callout -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="rounded-3xl p-8 sm:p-12 bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-700 text-white shadow-xl relative overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="inline-block text-xs uppercase tracking-wider font-extrabold px-2.5 py-1 rounded bg-white/20 backdrop-blur-sm mb-4">
          Signature Feature • 100% Free
        </span>
        <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight mb-4">
          Visual Interactive Roadmaps with Local Progress Tracking
        </h2>
        <p class="text-sm sm:text-base text-emerald-50 leading-relaxed mb-6">
          Phase-by-phase timeline, milestones, checklist checkboxes, aur free curated links. Aapki progress browser ke localStorage me safe rehti hai—koi account ya tracking nahi.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={`${base}/roadmaps/dsa-placement/`} class="px-5 py-2.5 rounded-xl bg-white text-emerald-800 font-bold text-xs hover:bg-emerald-50 transition-colors shadow-sm">
            DSA & Placement Roadmap →
          </a>
          <a href={`${base}/roadmaps/ai-ml-engineer/`} class="px-5 py-2.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white font-bold text-xs transition-colors">
            AI/ML Engineer Roadmap →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
