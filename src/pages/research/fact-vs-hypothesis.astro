---
import Layout from '../../layouts/Layout.astro';
import { BRAND } from '../../config/brand';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`Fact vs Hypothesis Protocol — ${BRAND.name}`} description={`Why and how ${BRAND.name} strictly separates empirical facts from hypothetical red-teaming scenario models.`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-indigo-500">Home</a>
      <span>/</span>
      <a href={`${base}/research/`} class="hover:text-indigo-500">Research</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">Fact vs Hypothesis</span>
    </nav>

    <!-- Header -->
    <div class="space-y-4 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-saffron-50 dark:bg-saffron-950/60 border border-saffron-300/40 text-saffron-700 dark:text-saffron-300 text-xs font-bold">
        <svg class="w-3.5 h-3.5 text-saffron-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
        <span>Epistemological Boundary</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        The Golden Rule: Fact vs Hypothesis Protocol
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-hindi">
        {BRAND.nameHi} ({BRAND.name}) पर तथ्य और काल्पनिक परिदृश्य कभी एक साथ नहीं मिलाए जाते। जानिए हम क्यों रेड-टीमिंग सिमुलेशन करते हैं और पाठकों की सुरक्षा के लिए कौन से सख्त नियम लागू करते हैं।
      </p>
    </div>

    <!-- Visual Badge Comparison Table -->
    <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4 mb-12">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">
        Visual Badge System (स्पष्ट दृश्य भेद)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-emerald-500/10 border-2 border-emerald-500/40 space-y-2">
          <span class="px-2.5 py-0.5 rounded bg-emerald-600 text-white font-black uppercase text-[10px]">
            VERIFIED FACT / TOPIC
          </span>
          <p class="font-bold text-slate-900 dark:text-white">प्रमाणित ज्ञान और दस्तावेज़</p>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            हर दावा आधिकारिक सरकारी गजट, अकादमिक शोध पत्र, या सत्यापित कोड डॉक्स से फुटनोट किया गया है। यह 100% वर्तमान सत्य है।
          </p>
        </div>

        <div class="p-4 rounded-xl bg-amber-500/10 border-2 border-amber-500/40 space-y-2">
          <span class="px-2.5 py-0.5 rounded bg-amber-500 text-slate-950 font-black uppercase text-[10px]">
            HYPOTHETICAL SCENARIO
          </span>
          <p class="font-bold text-slate-900 dark:text-white">सिम्युलेटेड परिदृश्य व रेड-टीमिंग</p>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            "जो अभी नहीं हुआ है लेकिन तार्किक रूप से हो सकता है"। यह केवल रणनीतिक योजना, जोखिम मूल्यांकन और सिस्टम स्ट्रेस-टेस्टिंग के लिए है।
          </p>
        </div>
      </div>
    </div>

    <!-- The 6 Non-Negotiable Standards -->
    <div class="space-y-6 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
      <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight">
        6 Non-Negotiable Editorial Standards
      </h2>

      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">1. कभी भी ब्रेकिंग न्यूज़ शैली नहीं:</strong>
          <p>किसी भी परिदृश्य को "Breaking News", प्रेस रिलीज़ या वास्तविक समाचार की तरह प्रस्तुत करने की सख्त मनाही है।</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">2. वास्तविक जीवित व्यक्तियों के नाम से फर्जी बयान नहीं:</strong>
          <p>हम कभी भी किसी जीवित नेता, जनरल या अधिकारी के नाम से काल्पनिक उद्धरण या निर्णय नहीं लिखते। हमेशा जेनेरिक भूमिकाओं ("a regional maritime power", "regulatory authorities") का उपयोग किया जाता है।</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">3. हर अनुमान का वास्तविक साक्ष्य (Real-World Anchoring):</strong>
          <p>अगर हम यह मानते हैं कि तेल का बहाव रुक जाएगा, तो हम पहले यह साबित करते हैं कि EIA के अनुसार वहां से कितना तेल गुज़रता है और पाइपलाइन की वास्तविक क्षमता क्या है।</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">4. कृत्रिम संभावना प्रतिशत (Fake Percentages) पर रोक:</strong>
          <p>भविष्य के जटिल परिदृश्यों में "73.4% संभावना" जैसे मनगढ़ंत आंकड़े देने के बजाय हम गुणात्मक श्रेणियों ("Higher likelihood", "Low probability, high impact") का प्रयोग करते हैं।</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">5. मजबूत काउंटर-आर्ग्युमेंट्स अनिवार्य:</strong>
          <p>प्रत्येक परिदृश्य के अंत में यह स्पष्ट लिखा जाता है कि यह परिदृश्य क्यों गलत साबित हो सकता है और इसके विरुद्ध सबसे मजबूत तर्क क्या हैं।</p>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <strong class="text-slate-900 dark:text-white font-bold block">6. सैन्य सामग्री में सामरिक नीति तक सीमित:</strong>
          <p>किसी भी परिदृश्य में हथियार बनाने, किसी विशिष्ट स्थान पर सामरिक हमले की योजना या हिंसा भड़काने वाली जानकारी शामिल नहीं की जाती। केवल वैश्विक व्यापार, लॉजिस्टिक्स और नीतिगत प्रतिरोध का विश्लेषण किया जाता है।</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
