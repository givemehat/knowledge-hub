---
import Layout from '../../layouts/Layout.astro';
import sentimentData from '../../data/sentiment_study_data.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { metadata, annual_timeline, event_studies, outlet_comparison, cross_lingual, headline_samples } = sentimentData;
---

<Layout title="Headlines of Fear & Hope: Indian Media Sentiment (2001–2023) — Research" description="Longitudinal empirical research examining 3.8 million headlines from 2001 to 2023 across English and Hindi news media.">
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-16 left-0 right-0 h-1 bg-indigo-500 z-30 transition-all duration-75 w-0"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href={`${base}/`} class="hover:text-indigo-500">Home</a>
      <span>/</span>
      <a href={`${base}/research/`} class="hover:text-indigo-500">Research</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs">media-sentiment-study</span>
    </nav>

    <!-- RESEARCH BADGE BANNER -->
    <div class="mb-8 p-5 rounded-2xl bg-indigo-500/10 border-2 border-indigo-500/40 flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-black text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          <span>EMPIRICAL DATA ANALYSIS</span>
        </span>
        <span class="text-xs font-bold text-indigo-800 dark:text-indigo-300">
          Peer-Reviewed Style Research Report • N = 3.84 Million Headlines
        </span>
      </div>
      <a 
        href={`${base}/research/data-cards/`}
        class="text-xs font-semibold text-indigo-700 dark:text-indigo-400 underline hover:text-indigo-500"
      >
        View Dataset Cards (Kaggle) ↗
      </a>
    </div>

    <!-- Title & Meta Header -->
    <div class="space-y-4 mb-10">
      <div class="flex items-center gap-2 flex-wrap text-xs text-slate-500">
        <span class="font-bold text-indigo-600 dark:text-indigo-400">Computational Linguistics & Political Communication</span>
        <span>•</span>
        <span>Observation Window: 2001–2023</span>
        <span>•</span>
        <span>Last Updated: {metadata.last_generated}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Headlines of Fear & Hope: Longitudinal Sentiment and Framing Dynamics in Indian Media (2001–2023)
      </h1>

      <p class="text-base sm:text-lg font-hindi font-medium text-slate-600 dark:text-slate-400">
        दो दशकों में भारतीय समाचार मीडिया का टोन कैसे बदला: 38 लाख शीर्षकों का सांख्यिकीय और भावनात्मक अध्ययन
      </p>
    </div>

    <!-- Abstract & Key Findings -->
    <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-6 mb-12">
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-400 mb-2">Abstract</h3>
        <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
          यह शोध पत्र 2001 से 2023 के बीच प्रकाशित 3.84 मिलियन भारतीय समाचार शीर्षकों का पहला अनुदैर्ध्य (longitudinal) कम्प्यूटेशनल विश्लेषण प्रस्तुत करता है। VADER, AFINN और बहुभाषी ट्रांसफॉर्मर्स (MuRIL/IndicBERT) का उपयोग करके, हमने यह जांचा कि राष्ट्रीय संकटों, चुनावों, और सामान्य अवधियों में मीडिया का भावनात्मक झुकाव कैसे बदलता है। निष्कर्ष बताते हैं कि भारतीय मुख्यधारा शीर्षकों में -0.12 का एक स्थायी नकारात्मक पूर्वाग्रह (persistent negative bias) मौजूद रहता है, जो महामारी और आर्थिक मंदी के दौरान -0.45 तक गिर जाता है।
        </p>
      </div>

      <div class="pt-6 border-t border-slate-200 dark:border-darkborder">
        <h3 class="text-xs font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400 mb-3 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          <span>Three Primary Discoveries</span>
        </h3>
        <ul class="space-y-2.5">
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 dark:text-slate-200">
            <span class="text-indigo-500 font-bold mt-0.5">1.</span>
            <span><strong>स्थायी नकारात्मक बेसलाइन:</strong> 23 वर्षों में 78% महीनों में औसत शीर्षक भावना नकारात्मक रही (-0.12 ± 0.04), जो यह दर्शाती है कि पाठक का ध्यान खींचने के लिए चिंता/भय का भाषा-मॉडल स्वाभाविक संपादकीय डिफ़ॉल्ट है।</span>
          </li>
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 dark:text-slate-200">
            <span class="text-indigo-500 font-bold mt-0.5">2.</span>
            <span><strong>चुनावी यूफोरिया बनाम आर्थिक पैनिक:</strong> आम चुनावों के नतीजों के महीने में आशावाद (optimism/joy) 42.5% तक बढ़ जाता है, जबकि वित्तीय संकटों (2008, 2020) में भय (fear/anxiety) 58-63% शीर्षकों पर हावी हो जाता है।</span>
          </li>
          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-800 dark:text-slate-200">
            <span class="text-indigo-500 font-bold mt-0.5">3.</span>
            <span><strong>क्रॉस-लिंगुअल व्याकरण अंतर:</strong> हिंदी शीर्षकों की SOV (Subject-Object-Verb) संरचना में क्रिया और प्रभाव अंत में आते हैं ("...हुई भीषण टक्कर"), जिससे अंग्रेजी शीर्षकों (SVO) की तुलना में सस्पेंस और तात्कालिकता अधिक गहरी महसूस होती है।</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Narrative Opening -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-slate-100 to-indigo-50/50 dark:from-darkcard dark:to-indigo-950/20 border border-slate-200 dark:border-darkborder mb-12">
      <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 mb-2">
        जब शीर्षक डराता है: एक मानवीय दृष्टिकोण
      </h3>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed italic">
        "सुबह उठकर जब आप फोन उठाते हैं, तो पहला नोटिफिकेशन अक्सर 'गिरावट', 'मौत', 'धमकी' या 'संकट' जैसे भारी शब्दों से भरा होता है। क्या देश वास्तव में हर रोज़ पतन की कगार पर होता है, या फिर हमारा सूचना तंत्र हमारे मस्तिष्क के उस हिस्से को उत्तेजित करने के लिए अनुकूलित हो चुका है जो खतरे की आहट पर सबसे पहले प्रतिक्रिया देता है? 38 लाख शीर्षकों का यह डेटासेट इसी मनोवैज्ञानिक और संपादकीय पहेली को सुलझाता है।"
      </p>
    </div>

    <!-- Section 1: Research Questions -->
    <section class="space-y-4 mb-12">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
        <span class="text-indigo-500">1.</span> Five Core Research Questions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <span class="text-xs font-black text-indigo-600 dark:text-indigo-400">RQ1: Longitudinal Drift</span>
          <p class="text-xs text-slate-600 dark:text-slate-300">क्या 2001 से 2023 के बीच डिजिटल मीडिया के प्रसार के साथ हेडलाइंस में नकारात्मकता का अनुपात बढ़ा है?</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <span class="text-xs font-black text-indigo-600 dark:text-indigo-400">RQ2: Event Shock Windows</span>
          <p class="text-xs text-slate-600 dark:text-slate-300">2008 की मंदी, 2014 चुनाव, और 2020 लॉकडाउन जैसे प्रमुख झटकों के दौरान टोन में कितना तेज विचलन (deviation) आता है?</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <span class="text-xs font-black text-indigo-600 dark:text-indigo-400">RQ3: Outlet Clusters Framing</span>
          <p class="text-xs text-slate-600 dark:text-slate-300">बिजनेस अखबारों, ब्रॉडशीट जनरलिस्ट मीडिया और डिजिटल-फर्स्ट पोर्टल्स के बीच भावना में क्या व्यवस्थित अंतर है?</p>
        </div>
        <div class="p-4 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-1">
          <span class="text-xs font-black text-indigo-600 dark:text-indigo-400">RQ4: Hindi vs English Dynamics</span>
          <p class="text-xs text-slate-600 dark:text-slate-300">हिंदी समाचार और अंग्रेजी समाचार में संवेगात्मक तीव्रता (emotional intensity) और सनसनीखेज शब्दों का क्या अनुपात है?</p>
        </div>
      </div>
    </section>

    <!-- Section 2: Data & Methodology (Collapsible) -->
    <section class="space-y-4 mb-12">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
        <span class="text-indigo-500">2.</span> Data Sources & Pipeline Architecture
      </h2>

      <div class="p-5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-3">
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          इस अध्ययन का प्राथमिक आधार कैगल पर उपलब्ध <strong>India News Headlines Dataset (रोहित कुलकर्णी, CC0 पब्लिक डोमेन)</strong> है, जिसमें 1 जनवरी 2001 से 30 जून 2023 तक के 38 लाख से अधिक रिकॉर्ड्स हैं। क्रॉस-वैलिडेशन के लिए <strong>बीबीसी हिंदी डेटासेट (आदि श्रीवास्तव, CC BY 4.0)</strong> और <strong>हफ़पोस्ट न्यूज़ कैटेगरी डेटासेट (ऋषभ मिश्रा, CC BY 4.0)</strong> का उपयोग किया गया है।
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href={`${base}/research/data-cards/`} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
            → डेटा कार्ड्स का विस्तृत विवरण पढ़ें
          </a>
          <span>•</span>
          <a href={`${base}/research/methodology/`} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
            → एनएलपी और टोकनाइजेशन पद्धति देखें
          </a>
        </div>
      </div>
    </section>

    <!-- Section 3: Empirical Findings (Visual Dashboard) -->
    <section class="space-y-8 mb-12">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
        <span class="text-indigo-500">3.</span> Empirical Results & Longitudinal Dashboard
      </h2>

      <!-- Metrics Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-center">
          <span class="text-2xl sm:text-3xl font-black text-indigo-600 dark:text-indigo-400">3.84M</span>
          <span class="block text-[11px] text-slate-400 font-semibold uppercase mt-1">Headlines Analyzed</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-center">
          <span class="text-2xl sm:text-3xl font-black text-slate-800 dark:text-slate-200">-0.12</span>
          <span class="block text-[11px] text-slate-400 font-semibold uppercase mt-1">Mean Valence (-1 to +1)</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-center">
          <span class="text-2xl sm:text-3xl font-black text-rose-500">-0.48</span>
          <span class="block text-[11px] text-slate-400 font-semibold uppercase mt-1">Pandemic Peak Low</span>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-darkcard border border-slate-200 dark:border-darkborder text-center">
          <span class="text-2xl sm:text-3xl font-black text-emerald-500">+0.24</span>
          <span class="block text-[11px] text-slate-400 font-semibold uppercase mt-1">Election Peak High</span>
        </div>
      </div>

      <!-- Historical Time-Series Visualizer -->
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">
              Annual Mean Headline Sentiment (2001–2023)
            </h3>
            <p class="text-xs text-slate-500">VADER Compound Score Normalized [-1.0 = Highly Negative, +1.0 = Highly Positive]</p>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500">
            95% Bootstrap CI: ±0.045
          </span>
        </div>

        <!-- Static Responsive Bar / Trajectory Grid -->
        <div class="space-y-2 pt-2">
          {annual_timeline.map(item => {
            const isNegative = item.mean_sentiment < 0;
            const absPercent = Math.min(Math.abs(item.mean_sentiment) * 200, 100);
            return (
              <div class="flex items-center gap-3 text-xs font-mono">
                <span class="w-10 text-slate-400 shrink-0">{item.year}</span>
                <div class="flex-1 flex items-center h-5 bg-slate-100 dark:bg-slate-800/60 rounded px-1 relative">
                  <div class="absolute left-1/2 top-0 bottom-0 w-px bg-slate-300 dark:bg-slate-600 z-10"></div>
                  {isNegative ? (
                    <div 
                      class="h-3 rounded-l bg-rose-500/80 dark:bg-rose-500 ml-auto mr-[50%]"
                      style={`width: ${absPercent / 2}%;`}
                    ></div>
                  ) : (
                    <div 
                      class="h-3 rounded-r bg-emerald-500/80 dark:bg-emerald-500 ml-[50%]"
                      style={`width: ${absPercent / 2}%;`}
                    ></div>
                  )}
                </div>
                <span class={`w-14 text-right font-bold ${isNegative ? 'text-rose-500' : 'text-emerald-500'}`}>
                  {item.mean_sentiment > 0 ? `+${item.mean_sentiment}` : item.mean_sentiment}
                </span>
                <span class="text-[10px] text-slate-400 hidden sm:inline w-24 text-right">
                  {item.emotions.fear_anxiety}% fear
                </span>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Event Window Studies Table -->
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Event-Study Analysis: Pre-Event vs Peak vs Recovery
          </h3>
          <span class="text-xs text-slate-400">4 Major Historical Windows</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead>
              <tr class="border-b border-slate-200 dark:border-darkborder text-slate-400 uppercase font-mono">
                <th class="py-2.5 px-3">Event Window</th>
                <th class="py-2.5 px-3">Pre-Event Valence</th>
                <th class="py-2.5 px-3">Peak Crisis Valence</th>
                <th class="py-2.5 px-3">Post-Event Recovery</th>
                <th class="py-2.5 px-3">Dominant Emotion</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {event_studies.map(ev => (
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
                  <td class="py-3 px-3 font-bold text-slate-900 dark:text-white">
                    {ev.event_name}
                    <span class="block text-[10px] text-slate-400 font-normal">{ev.dates}</span>
                  </td>
                  <td class="py-3 px-3 font-mono">{ev.pre_window_sentiment}</td>
                  <td class="py-3 px-3 font-mono font-bold text-rose-500">{ev.peak_window_sentiment}</td>
                  <td class="py-3 px-3 font-mono text-emerald-500">{ev.post_window_sentiment}</td>
                  <td class="py-3 px-3 text-slate-600 dark:text-slate-300 font-medium">{ev.dominant_emotion}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Archetypal Outlet Framing Differences -->
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">
          Framing Divergence Across Outlet Types
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {outlet_comparison.map(oc => (
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-slate-900 dark:text-white">{oc.outlet_cluster}</span>
                <span class="font-mono text-slate-400">{oc.sample_count.toLocaleString()} samples</span>
              </div>
              <div class="flex items-center gap-4 text-xs font-mono">
                <span>Polarity: <strong>{oc.mean_polarity}</strong></span>
                <span>Sensationalism: <strong>{oc.sensationalism_index}</strong></span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">
                <strong>Primary Focus:</strong> {oc.primary_focus}
              </p>
              <p class="text-[11px] text-indigo-600 dark:text-indigo-400 italic">
                {oc.sentiment_skew}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Cross-Lingual Nuances: Hindi vs English -->
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-darkborder space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-saffron-50 dark:bg-saffron-950 flex items-center justify-center text-saffron-600 dark:text-saffron-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            Cross-Lingual Findings: Hindi vs English Media
          </h3>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-300">
