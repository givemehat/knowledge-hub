---
import ResourcesView from '../../components/resources/ResourcesView.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'hi' } },
    { params: { locale: 'en' } }
  ];
}

const { locale = 'hi' } = Astro.params as { locale: Locale };
---

<ResourcesView locale={locale as Locale} />
