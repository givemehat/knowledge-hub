---
import ResearchView from '../../../components/research/ResearchView.astro';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'hi' } },
    { params: { locale: 'en' } }
  ];
}

const { locale = 'hi' } = Astro.params as { locale: Locale };
---

<ResearchView locale={locale as Locale} />
