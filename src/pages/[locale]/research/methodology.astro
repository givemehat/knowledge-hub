---
import MethodologyView from '../../../components/research/MethodologyView.astro';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'hi' } },
    { params: { locale: 'en' } }
  ];
}

const { locale = 'hi' } = Astro.params as { locale: Locale };
---

<MethodologyView locale={locale as Locale} />
