---
import HomeView from '../../components/home/HomeView.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { locale: 'hi' } },
    { params: { locale: 'en' } }
  ];
}

const { locale = 'hi' } = Astro.params as { locale: Locale };
---

<HomeView locale={locale as Locale} />
