---
import Layout from '../layouts/Layout.astro';
import IndianPattern from '../components/ui/IndianPattern.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="About Knowledge Hub — Mission & Principles" description="Why we built Knowledge Hub and our editorial commitment to clean, high-density, accessible learning.">
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-12">
    <IndianPattern variant="rangoli" opacity={0.03} />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20 text-xs font-semibold mb-4">
        <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Mission & Manifesto
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        About Knowledge Hub
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
        Knowledge Hub is built as "the modern Wikipedia for builders and students": high-velocity, clean, zero trackers, and 100% focused on helping you find and master knowledge in minutes.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Core Pillars Bento -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-card transition-all">
        <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-600 dark:text-brand-400 mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">Zero Backend, Pure Speed</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">100% static HTML generation with Astro. No runtime databases, zero auth cookies, sub-second page loads globally via GitHub Pages CDN.</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-card transition-all">
        <div class="w-10 h-10 rounded-xl bg-peacock-50 dark:bg-peacock-950 flex items-center justify-center text-peacock-600 dark:text-peacock-400 mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">No Ads, No Tracking</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">No invasive analytics cookies, annoying popups, paywalls, or sponsored spam. Clean editorial independence and CC BY-SA 4.0 licensing.</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-card transition-all">
        <div class="w-10 h-10 rounded-xl bg-cyan-50 dark:bg-cyan-950 flex items-center justify-center text-cyan-600 dark:text-cyan-400 mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">Cognitive & Ergonomic UX</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Designed adhering to Hick's Law, Fitts's Law, Miller's 7±2 chunking, and thumb-reach mobile touch targets.</p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-card transition-all">
        <div class="w-10 h-10 rounded-xl bg-saffron-50 dark:bg-saffron-950 flex items-center justify-center text-saffron-600 dark:text-saffron-400 mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">Modern Bharat & Hinglish</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Technical concepts explained in natural Indian technical parlance with standard English engineering vocabulary intact.</p>
      </div>
    </div>

    <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-white/10 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed space-y-4">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Our Editorial Promise</h3>
      <p>
        Internet par technical content do extremes me phasa hua hai: ya toh 3 ghante ki repetitive YouTube videos jisme 10 minute ka kaam hota hai, ya fir dense research papers jo aam student ko samajh nahi aate.
      </p>
      <p>
        Knowledge Hub bridges this gap: <strong>Har topic 30 second me scan ho sakta hai, 3 minute me core theory clear karta hai, aur real runnable code provide karta hai.</strong>
      </p>
    </div>
  </div>
</Layout>
