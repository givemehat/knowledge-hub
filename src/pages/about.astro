---
import Layout from '../layouts/Layout.astro';
import IndianPattern from '../components/ui/IndianPattern.astro';
import AvailabilityBadge from '../components/creator/AvailabilityBadge.astro';
import SkillChips from '../components/creator/SkillChips.astro';
import ProjectCard from '../components/creator/ProjectCard.astro';
import { CREATOR } from '../data/creator';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`About ${CREATOR.name} & Bodh Manifesto`} description={`Learn about ${CREATOR.name}, the motivation behind Bodh (Knowledge Hub), and our open-source manifesto for high-velocity learning.`}>
  <!-- Hero Section -->
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-16">
    <IndianPattern variant="rangoli" opacity={0.035} />

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-8">
        <!-- Creator Avatar Squircle -->
        <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-brand-600 via-indigo-600 to-peacock-600 flex items-center justify-center text-white text-3xl font-black shadow-card shrink-0">
          {CREATOR.name.split(' ').map(n => n[0]).join('')}
        </div>

        <div class="space-y-2">
          <AvailabilityBadge />
          <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
            Hi, I'm {CREATOR.name}
          </h1>
          <p class="text-base sm:text-lg font-medium text-brand-600 dark:text-brand-400">
            {CREATOR.role} • {CREATOR.location}
          </p>
        </div>
      </div>

      <p class="text-base sm:text-xl text-slate-700 dark:text-slate-300 max-w-3xl leading-relaxed">
        {CREATOR.tagline}
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-8">
        <a
          href={`${base}/contact/`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs hover:bg-brand-600 dark:hover:bg-brand-400 dark:hover:text-white transition-all shadow-sm hover:scale-[1.02]"
        >
          <span>Connect with Me</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>

        <a
          href={CREATOR.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 font-bold text-xs hover:border-brand-500 transition-all shadow-xs"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span>GitHub @{CREATOR.handle}</span>
        </a>

        <a
          href={`${base}/vcard.vcf`}
          download="Rajnish_Singh.vcf"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-xs hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          <span>Save Contact (vCard)</span>
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    <!-- SECTION 1: THE STORY -->
    <section class="space-y-6">
      <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Personal Journey</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          Kyun Banaya Yeh Project?
        </h2>
      </div>

      <div class="space-y-4 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed max-w-3xl">
        {CREATOR.bioParagraphs.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- SECTION 2: SKILLS & TECH STACK -->
    <section class="space-y-6">
      <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-peacock-600 dark:text-peacock-400">Technical Competencies</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          Skills & Tech Stack
        </h2>
      </div>

      <SkillChips />
    </section>

    <!-- SECTION 3: FEATURED PROJECTS -->
    <section class="space-y-6">
      <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-saffron-600 dark:text-saffron-400">Open-Source Portfolio</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          Featured Projects
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {CREATOR.featuredProjects.map(proj => (
          <ProjectCard project={proj} />
        ))}
      </div>
    </section>

    <!-- SECTION 4: CURRENT FOCUS & LEARNING -->
    <section class="space-y-6">
      <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Continuous Growth</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          What I'm Learning & Building Now
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-3xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm space-y-3">
          <div class="flex items-center gap-2 font-bold text-sm text-slate-900 dark:text-white">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            <span>Deepening Knowledge In:</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
            {CREATOR.currentFocus.learning.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-brand-500 font-bold">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-6 rounded-3xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm space-y-3">
          <div class="flex items-center gap-2 font-bold text-sm text-slate-900 dark:text-white">
            <svg class="w-4 h-4 text-peacock-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
            <span>Currently Building:</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
            {CREATOR.currentFocus.building.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-peacock-500 font-bold">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 5: MANIFESTO & PRINCIPLES -->
    <section class="space-y-6">
      <div class="border-b border-slate-200/80 dark:border-white/10 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-saffron-600 dark:text-saffron-400">Project Philosophy</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          Bodh (Knowledge Hub) Manifesto
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950 flex items-center justify-center text-brand-600 dark:text-brand-400 mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white mb-1">Zero Backend, Pure Speed</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">100% static HTML generation with Astro. No runtime databases, zero auth cookies, sub-second page loads globally via GitHub Pages CDN.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-darkcard border border-slate-200 dark:border-white/10 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-peacock-50 dark:bg-peacock-950 flex items-center justify-center text-peacock-600 dark:text-peacock-400 mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white mb-1">No Ads, No Tracking</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">No invasive analytics cookies, annoying popups, paywalls, or sponsored spam. Clean editorial independence and CC BY-SA 4.0 licensing.</p>
        </div>
      </div>
    </section>

    <!-- SECTION 6: OPEN-SOURCE CALL TO ACTION -->
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-brand-600 via-indigo-600 to-peacock-600 text-white shadow-elevation relative overflow-hidden">
      <div class="relative z-10 max-w-2xl space-y-3">
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight">
          Let's Build Open Knowledge Together
        </h3>
        <p class="text-xs sm:text-sm text-slate-100 leading-relaxed">
          Agar aapke paas koi suggestion hai, naya topic roadmap add karna chahte hain, ya portfolio collaborate karna chahte hain—GitHub par PR open karein ya direct reach out karein!
        </p>
        <div class="pt-2 flex flex-wrap gap-3">
          <a
            href={`${base}/contact/`}
            class="px-5 py-2.5 rounded-xl bg-white text-slate-900 font-bold text-xs hover:bg-slate-100 transition-colors shadow-sm"
          >
            Get In Touch →
          </a>
          <a
            href={CREATOR.links.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white font-bold text-xs transition-colors"
          >
            Star on GitHub ★
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
