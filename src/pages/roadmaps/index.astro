---
import Layout from '../../layouts/Layout.astro';
import IndianPattern from '../../components/ui/IndianPattern.astro';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import InsetPanel from '../../components/ui/InsetPanel.astro';
import CardFooter from '../../components/ui/CardFooter.astro';
import Button from '../../components/ui/Button.astro';
import { ROADMAPS } from '../../data/roadmaps';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Visual Interactive Roadmaps — Bodh (बोध)"
  description="करियर और तकनीकी अध्ययन के लिए चरणबद्ध रोडमैप, घंटे के अनुमान और मुफ़्त संसाधन।"
  lang="hi"
>
  <div class="relative overflow-hidden border-b border-slate-200/80 dark:border-white/10 py-12">
    <IndianPattern variant="rangoli" opacity={0.03} />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20 text-xs font-semibold mb-4">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>संरचित करियर रोडमैप्स</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          इंटरएक्टिव इंजीनियरिंग रोडमैप्स
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
          प्रत्येक रोडमैप में चरणबद्ध मील के पत्थर, समय अनुमान, स्थानीय प्रगति ट्रैकिंग (Path View और Board View), और सत्यापित मुफ़्त संसाधन शामिल हैं।
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 auto-rows-fr">
      {ROADMAPS.map(roadmap => (
        <Card class="roadmap-card">
          <div>
            <!-- Top Chip Row -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <Chip variant="neutral" size="sm">
                {roadmap.difficulty}
              </Chip>
              <Chip variant="phase" size="sm">
                ~{roadmap.estimatedWeeks} Weeks
              </Chip>
            </div>

            <!-- Title & Subtitle -->
            <h2 class="text-2xl font-black text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              <a href={`${base}/roadmaps/${roadmap.slug}/`} class="hover:underline">
                {roadmap.title}
              </a>
            </h2>

            {roadmap.titleHindi && (
              <p class="text-xs text-slate-400 font-hindi mt-1">
                {roadmap.titleHindi}
              </p>
            )}

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
              {roadmap.subtitle}
            </p>

            <!-- InsetPanel "Milestone Checkpoints" -->
            <InsetPanel variant="top-topics" label="Milestone Checkpoints" class="mt-6">
              <div class="space-y-2 mt-1">
                {roadmap.nodes.slice(0, 4).map((node, i) => (
                  <div class="flex items-center gap-2.5 text-xs text-slate-700 dark:text-slate-300">
                    <span class="w-5 h-5 rounded-lg bg-white dark:bg-slate-800 text-[10px] flex items-center justify-center font-bold text-slate-500 shrink-0 font-mono border border-slate-200/50 dark:border-white/5">
                      {i + 1}
                    </span>
                    <span class="truncate font-medium">{node.title}</span>
                  </div>
                ))}
                {roadmap.nodes.length > 4 && (
                  <div class="text-[11px] text-slate-400 pl-7 font-mono">
                    + {roadmap.nodes.length - 4} more milestones in roadmap
                  </div>
                )}
              </div>
            </InsetPanel>
          </div>

          <!-- Pinned Footer -->
          <CardFooter>
            <span slot="meta" class="text-xs text-slate-400 font-mono">
              {roadmap.nodes.length} Milestones
            </span>
            <div slot="action">
              <Button
                href={`${base}/roadmaps/${roadmap.slug}/`}
                variant="primary"
                size="sm"
                icon="arrow"
              >
                <span>Launch Roadmap</span>
              </Button>
            </div>
          </CardFooter>
        </Card>
      ))}
    </div>
  </div>
</Layout>
